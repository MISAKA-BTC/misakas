{
  "architectures": [
    "Olmo3ForCausalLM"
  ],
  "attention_bias": false,
  "attention_dropout": 0.0,
  "bos_token_id": null,
  "dtype": "bfloat16",
  "eos_token_id": 2,
  "hidden_act": "silu",
  "hidden_size": 32,
  "initializer_range": 0.02,
  "intermediate_size": 64,
  "layer_types": [
    "sliding_attention",
    "sliding_attention"
  ],
  "max_position_embeddings": 128,
  "model_type": "olmo3",
  "num_attention_heads": 4,
  "num_hidden_layers": 2,
  "num_key_value_heads": 2,
  "pad_token_id": 1,
  "rms_norm_eps": 1e-05,
  "rope_parameters": {
    "full_attention": {
      "rope_theta": 500000.0,
      "rope_type": "default"
    },
    "sliding_attention": {
      "rope_theta": 500000.0,
      "rope_type": "default"
    }
  },
  "sliding_window": 4096,
  "tie_word_embeddings": false,
  "transformers_version": "5.17.0",
  "use_cache": true,
  "vocab_size": 64
}
