{
  "architectures": [
    "LagunaForCausalLM"
  ],
  "attention_bias": false,
  "attention_dropout": 0.0,
  "bos_token_id": null,
  "dtype": "bfloat16",
  "eos_token_id": null,
  "gating": true,
  "head_dim": 8,
  "hidden_act": "silu",
  "hidden_size": 32,
  "initializer_range": 0.02,
  "intermediate_size": 64,
  "layer_types": [
    "full_attention",
    "full_attention"
  ],
  "max_position_embeddings": 128,
  "mlp_layer_types": [
    "dense",
    "sparse"
  ],
  "model_type": "laguna",
  "moe_apply_router_weight_on_input": false,
