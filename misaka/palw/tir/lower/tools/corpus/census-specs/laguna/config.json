    "full_attention": {
      "partial_rotary_factor": 0.5,
      "rope_theta": 500000.0,
      "rope_type": "default"
    },
    "sliding_attention": {
      "partial_rotary_factor": 1.0,
      "rope_theta": 10000.0,
      "rope_type": "default"
    }
  },
  "router_aux_loss_coef": 0.001,
  "shared_expert_intermediate_size": 512,
  "sliding_window": 512,
  "tie_word_embeddings": false,
  "transformers_version": "5.17.0",
  "use_cache": true,
  "vocab_size": 64
}
