{
  "format": "misaka.palw.model-adapter.v1",
  "id": "granitemoehybrid",
  "doc": "Granite 4.0 hybrid (GraniteMoeHybrid): per layer a Mamba-2 mixer (layer_types `linear_attention`, the checkpoint's `mamba.*`) or an attention mixer (`full_attention`, NoPE unless position_embedding_type is `rope`), then ALWAYS a Granite-MoE block (top-k of the logits then softmax; fused input_linear/output_linear experts) beside an always-on SHARED MLP (absent when shared_intermediate_size is 0) stored as ONE fused gate/up tensor shared_mlp.input_linear [2I, D], gate rows first: read by WEIGHTS_EXPR_V1 as two row ranges. Granite's four multipliers. Third-party adapter (lane H), the weights expressions by lane G (FR-01): data only.",
  "extends": [
    "granitemoe"
  ],
  "match": {
    "architectures": [
      "GraniteMoeHybridForCausalLM"
    ],
    "model_types": [
      "granitemoehybrid"
    ]
  },
  "config": {
    "defaults": {
      "vocab_size": 32000,
      "hidden_size": 4096,
      "intermediate_size": 11008,
      "num_hidden_layers": 32,
      "num_attention_heads": 32,
      "num_key_value_heads": 32,
      "max_position_embeddings": 2048,
      "rms_norm_eps": 1e-06,
      "tie_word_embeddings": false,
      "attention_bias": false,
      "embedding_multiplier": 1.0,
      "logits_scaling": 1.0,
      "residual_multiplier": 1.0,
      "attention_multiplier": 1.0,
      "num_local_experts": 8,
      "num_experts_per_tok": 2,
      "shared_intermediate_size": 1024,
      "mamba_n_heads": 128,
      "mamba_n_groups": 1,
      "mamba_d_state": 256,
      "mamba_d_head": 64,
      "mamba_d_conv": 4,
      "mamba_expand": 2,
      "mamba_conv_bias": true,
      "mamba_proj_bias": false
    },
    "inert": [
      "output_router_logits",
      "router_aux_loss_coef",
      "mamba_chunk_size",
      "time_step_limit"
    ]
  },
  "vars": [
    {
      "name": "pos_type",
      "value": {
        "$cfg?": "position_embedding_type"
      }
    },
    {
      "name": "types",
      "value": {
        "$layer_types": {
          "n": {
            "$var": "n"
          },
          "allowed": [
            "linear_attention",
            "full_attention"
          ],
          "each": "full_attention"
        }
      }
    },
    {
      "name": "is_mamba",
      "value": {
        "$eq": [
          {
            "$index": [
              {
                "$var": "types"
              },
              {
                "$var": "i"
              }
            ]
          },
          "linear_attention"
        ]
      },
      "layer": true
    },
    {
      "name": "mamba_inner",
      "value": {
        "$mul": [
          {
            "$cfg": "mamba_expand"
          },
          {
            "$var": "hidden"
          }
        ]
      }
    },
    {
      "name": "mamba_ok",
      "value": {
        "$bad": [
          {
            "$eq": [
              {
                "$mul": [
                  {
                    "$cfg": "mamba_n_heads"
                  },
                  {
                    "$cfg": "mamba_d_head"
                  }
                ]
              },
              {
                "$var": "mamba_inner"
              }
            ]
          },
          "mamba_n_heads·mamba_d_head ≠ mamba_expand·hidden"
        ]
      }
    },
    {
      "name": "l_position",
      "value": {
        "$if": [
          {
            "$eq": [
              {
                "$var": "pos_type"
              },
              "rope"
            ]
          },
          {
            "Rope": {
              "$var": "rope"
            }
          },
          "None"
        ]
      },
      "layer": true
    },
    {
      "name": "mamba2",
      "value": {
        "Mamba2": {
          "heads": {
            "$cfg": "mamba_n_heads"
          },
          "head_dim": {
            "$cfg": "mamba_d_head"
          },
          "groups": {
            "$cfg": "mamba_n_groups"
          },
          "state": {
            "$cfg": "mamba_d_state"
          },
          "conv_kernel": {
            "$cfg": "mamba_d_conv"
          },
          "conv_bias": {
            "$cfg": "mamba_conv_bias"
          },
          "proj_bias": {
            "$cfg": "mamba_proj_bias"
          },
          "norm_eps": {
            "$var": "eps"
          },
          "norm_groups": 1,
          "dt_min": 0.0,
          "dt_max": null,
          "d_mlp": 0
        }
      },
      "layer": true
    },
    {
      "name": "attn",
      "value": {
        "Attention": {
          "heads": {
            "$var": "heads"
          },
          "kv_heads": {
            "$var": "kv"
          },
          "head_dim": {
            "$var": "hd"
          },
          "v_head_dim": {
            "$var": "hd"
          },
          "q_bias": {
            "$var": "qkv_bias"
          },
          "k_bias": {
            "$var": "qkv_bias"
          },
          "v_bias": {
            "$var": "qkv_bias"
          },
          "o_bias": {
            "$var": "o_bias"
          },
          "qk_norm": null,
          "position": {
            "$var": "l_position"
          },
          "scale": {
            "$var": "attn_scale"
          },
          "window": null,
          "q_temperature": null
        }
      },
      "layer": true
    },
    {
      "name": "l_mixer",
      "value": {
        "$if": [
          {
            "$var": "is_mamba"
          },
          {
            "$var": "mamba2"
          },
          {
            "$var": "attn"
          }
        ]
      },
      "layer": true
    },
    {
      "name": "shared_inter",
      "value": {
        "$cfg": "shared_intermediate_size"
      }
    },
    {
      "name": "shared",
      "value": {
        "$if": [
          {
            "$gt": [
              {
                "$var": "shared_inter"
              },
              0
            ]
          },
          {
            "intermediate": {
              "$var": "shared_inter"
            },
            "sigmoid_gate": false
          },
          null
        ]
      }
    },
    {
      "name": "l_ffn",
      "value": {
        "Moe": {
          "experts": {
            "$var": "e"
          },
          "top_k": {
            "$var": "k"
          },
          "intermediate": {
            "$var": "inter"
          },
          "act": {
            "$var": "act"
          },
          "router": {
            "scoring": "TopKThenSoftmax",
            "normalize": false
          },
          "shared": {
            "$var": "shared"
          }
        }
      },
      "layer": true
    },
    {
      "name": "names",
      "value": {
        "$merge": [
          {
            "$var": "names_base"
          },
          {
            "moe.router": "{p}layers.{L}.block_sparse_moe.router.layer",
            "moe.gate_up.stacked": "{p}layers.{L}.block_sparse_moe.input_linear.weight",
            "moe.down.stacked": "{p}layers.{L}.block_sparse_moe.output_linear.weight",
            "moe.shared.down": "{p}layers.{L}.shared_mlp.output_linear",
            "mamba2.in": "{p}layers.{L}.mamba.in_proj",
            "mamba2.conv": "{p}layers.{L}.mamba.conv1d",
            "mamba2.dt_bias": "{p}layers.{L}.mamba.dt_bias",
            "mamba2.A_log": "{p}layers.{L}.mamba.A_log",
            "mamba2.D": "{p}layers.{L}.mamba.D",
            "mamba2.norm": "{p}layers.{L}.mamba.norm",
            "mamba2.out": "{p}layers.{L}.mamba.out_proj"
          }
        ]
      }
    },
    {
      "name": "model_type",
      "value": "granitemoehybrid"
    }
  ],
  "spec": {
    "hf": {
      "weights": {
        "$if": [
          {
            "$gt": [
              {
                "$var": "shared_inter"
              },
              0
            ]
          },
          {
            "moe.shared.gate.w": [
              "{p}layers.{L}.shared_mlp.input_linear.weight",
              {
                "rows": [
                  0,
                  {
                    "$var": "shared_inter"
                  }
                ]
              }
            ],
            "moe.shared.up.w": [
              "{p}layers.{L}.shared_mlp.input_linear.weight",
              {
                "rows": [
                  {
                    "$var": "shared_inter"
                  },
                  {
                    "$var": "shared_inter"
                  }
                ]
              }
            ]
          },
          {}
        ]
      }
    }
  }
}