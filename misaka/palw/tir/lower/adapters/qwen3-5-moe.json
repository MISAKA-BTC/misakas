{
  "format": "misaka.palw.model-adapter.v1",
  "id": "qwen3-5-moe",
  "doc": "Qwen3.5 text decoder (MoE): the dense variant's hybrid with a softmax top-k MoE (always renormalised) and a sigmoid-gated shared expert.",
  "extends": ["qwen3-5"],
  "match": {"architectures": ["Qwen3_5MoeForCausalLM"], "model_types": ["qwen3_5_moe_text"]},
  "config": {"defaults": {"hidden_size": 2048, "num_hidden_layers": 40, "num_key_value_heads": 2, "num_experts_per_tok": 8, "moe_intermediate_size": 512, "shared_expert_intermediate_size": 512}},
  "vars": [
    {"name": "has_moe", "value": true},
    {"name": "e", "value": {"$alias": [["num_experts", "num_local_experts"], 256]}},
    {"name": "k", "value": {"$cfg": "num_experts_per_tok"}},
    {"name": "topk_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "k"}, 0]}, {"$le": [{"$var": "k"}, {"$var": "e"}]}]}, "top-k"]}},
    {"name": "moe_inter", "value": {"$cfg": "moe_intermediate_size"}},
    {"name": "shared", "value": {"$cfg": "shared_expert_intermediate_size"}},
    {"name": "inter", "lazy": true, "value": null},
    {"name": "l_ffn", "value": {"Moe": {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "moe_inter"}, "act": {"$var": "act"}, "router": {"scoring": "Softmax", "normalize": true}, "shared": {"$if": [{"$gt": [{"$var": "shared"}, 0]}, {"intermediate": {"$var": "shared"}, "sigmoid_gate": true}, null]}}}, "layer": true},
    {"name": "families", "value": ["C3", "C4", "C7"]},
    {"name": "model_type", "value": "qwen3_5_moe_text"}
  ]
}
