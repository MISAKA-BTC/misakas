{
  "format": "misaka.palw.model-adapter.v1",
  "id": "gpt-neo",
  "doc": "GPT-Neo: learned positions, alternating global/local (windowed) attention, and NO 1/sqrt(d) score scaling.",
  "extends": ["decoder-core"],
  "match": {"architectures": ["GPTNeoForCausalLM"], "model_types": ["gpt_neo"]},
  "config": {"defaults": {"vocab_size": 50257, "hidden_size": 2048, "num_layers": 24, "num_heads": 16, "max_position_embeddings": 2048, "window_size": 256, "activation_function": "gelu_new", "layer_norm_epsilon": 1e-05, "tie_word_embeddings": true}},
  "vars": [
    {"name": "n", "value": {"$alias": [["num_layers", "num_hidden_layers"], 24]}},
    {"name": "heads", "value": {"$alias": [["num_heads", "num_attention_heads"], 16]}},
    {"name": "inter", "value": {"$let": ["i", {"$cfg?": "intermediate_size"}, {"$if": [{"$ne": [{"$var": "i"}, null]}, {"$var": "i"}, {"$mul": [4, {"$var": "hidden"}]}]}]}},
    {"name": "window", "value": {"$cfg": "window_size"}},
    {"name": "act", "value": {"$act": {"$cfg": "activation_function"}}},
    {"name": "eps", "value": {"$cfg": "layer_norm_epsilon"}},
    {"name": "att_types", "value": {"$cfg?": "attention_types"}},
    {"name": "gtypes", "value": {"$if": [{"$ne": [{"$var": "att_types"}, null]}, {"$flatten": {"$map": [{"$var": "att_types"}, "it", {"$flatten": {"$repeat": [{"$index": [{"$var": "it"}, 0]}, {"$index": [{"$var": "it"}, 1]}]}}]}}, {"$map": [{"$range": {"$var": "n"}}, "i", {"$if": [{"$eq": [{"$mod": [{"$var": "i"}, 2]}, 0]}, "global", "local"]}]}]}},
    {"name": "att_layers", "value": {"$cfg?": "attention_layers"}},
    {"name": "types_ok", "value": {"$check": [{"$and": [{"$eq": [{"$len": {"$var": "gtypes"}}, {"$var": "n"}]}, {"$not": {"$contains": [{"$map": [{"$var": "gtypes"}, "t", {"$and": [{"$ne": [{"$var": "t"}, "global"]}, {"$ne": [{"$var": "t"}, "local"]}]}]}, true]}}]}, {"$cat": ["attention layer pattern does not match ", {"$var": "n"}, " layers of global/local"]}]}},
    {"name": "att_layers_ok", "value": {"$bad": [{"$or": [{"$eq": [{"$var": "att_layers"}, null]}, {"$eq": [{"$var": "att_layers"}, {"$var": "gtypes"}]}]}, "attention_layers disagrees with attention_types"]}},
    {"name": "types", "value": {"$map": [{"$var": "gtypes"}, "t", {"$if": [{"$eq": [{"$var": "t"}, "local"]}, "sliding_attention", "full_attention"]}]}},
    {"name": "sw", "value": {"$var": "window"}},
    {"name": "hd", "value": {"$idiv": [{"$var": "hidden"}, {"$var": "heads"}]}},
    {"name": "kv", "value": {"$var": "heads"}},
    {"name": "norm", "value": {"kind": "Layer", "eps": {"$var": "eps"}, "gain": "W", "bias": true}},
    {"name": "qkv_bias", "value": false},
    {"name": "o_bias", "value": true},
    {"name": "abias", "value": false},
    {"name": "mbias", "value": true},
    {"name": "mlp_gated", "value": false},
    {"name": "attn_scale", "value": 1.0},
    {"name": "l_position", "value": "None", "layer": true},
    {"name": "embedding", "value": {"dim": {"$var": "hidden"}, "scale": 1.0, "positions": {"rows": {"$var": "max_pos"}, "offset": 0}}},
    {"name": "names", "value": {"embed": "{p}wte", "pos_embed": "{p}wpe", "final_norm": "{p}ln_f", "lm_head": {"$if": [{"$var": "tied"}, "{p}wte", "lm_head"]}, "norm.mix": "{p}h.{L}.ln_1", "norm.ffn": "{p}h.{L}.ln_2", "attn.q": "{p}h.{L}.attn.attention.q_proj", "attn.k": "{p}h.{L}.attn.attention.k_proj", "attn.v": "{p}h.{L}.attn.attention.v_proj", "attn.o": "{p}h.{L}.attn.attention.out_proj", "mlp.up": "{p}h.{L}.mlp.c_fc", "mlp.down": "{p}h.{L}.mlp.c_proj"}},
    {"name": "p", "value": "transformer."},
    {"name": "families", "value": ["C1", "C2"]},
    {"name": "model_type", "value": "gpt_neo"}
  ]
}
