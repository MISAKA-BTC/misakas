{
  "format": "misaka.palw.model-adapter.v1",
  "id": "modernbert",
  "doc": "ModernBERT (ModernBertModel, and the base of a ...ForMaskedLM checkpoint): a pre-norm bidirectional encoder: word embeddings and an embedding LayerNorm (no bias), no position table, rotary positions per layer type (a global theta and a local theta), global attention every n-th layer and a symmetric sliding window in between (local_attention total, |i - j| <= local_attention/2), a fused bias-free Wqkv, a GeGLU MLP whose fused Wi holds [act input | gate], pre-norm LayerNorms with the first layer's attention norm absent, and a final norm. Features: ENC_BIDIR_V1 (pre-norm placement, rows rope, band window, gated MLP, final norm).",
  "extends": ["mixin-bert-encoder"],
  "match": {"architectures": ["ModernBertModel", "ModernBertForMaskedLM"], "model_types": ["modernbert"]},
  "config": {"defaults": {"vocab_size": 50368, "hidden_size": 768, "intermediate_size": 1152, "num_hidden_layers": 22, "num_attention_heads": 12, "max_position_embeddings": 8192, "hidden_activation": "gelu", "norm_eps": 1e-05, "norm_bias": false, "attention_bias": false, "mlp_bias": false, "local_attention": 128, "global_attn_every_n_layers": 3, "pad_token_id": 50283}, "inert": ["cls_token_id", "sep_token_id", "classifier_activation", "classifier_bias", "classifier_dropout", "classifier_pooling", "decoder_bias", "deterministic_flash_attn", "embedding_dropout", "mlp_dropout", "initializer_cutoff_factor", "sparse_pred_ignore_index", "sparse_prediction", "global_rope_theta", "local_rope_theta", "reference_compile", "repad_logits_with_grad", "layer_types", "layer_norm_eps", "position_embedding_type", "gradient_checkpointing"]},
  "vars": [
    {"name": "vocab", "value": {"$cfg": "vocab_size"}},
    {"name": "hidden", "value": {"$cfg": "hidden_size"}},
    {"name": "inter", "value": {"$cfg": "intermediate_size"}},
    {"name": "n", "value": {"$cfg": "num_hidden_layers"}},
    {"name": "heads", "value": {"$cfg": "num_attention_heads"}},
    {"name": "max_pos0", "value": {"$cfg": "max_position_embeddings"}},
    {"name": "act", "value": {"$act": {"$cfg": "hidden_activation"}}},
    {"name": "eps", "value": {"$cfg": "norm_eps"}},
    {"name": "nbias", "value": {"$cfg": "norm_bias"}},
    {"name": "abias", "value": {"$cfg": "attention_bias"}},
    {"name": "mbias", "value": {"$cfg": "mlp_bias"}},
    {"name": "pad", "value": {"$cfg": "pad_token_id"}},
    {"name": "offset", "value": 0},
    {"name": "type_rows", "value": null},
    {"name": "local", "value": {"$cfg": "local_attention"}},
    {"name": "every", "value": {"$cfg": "global_attn_every_n_layers"}},
    {"name": "norm", "value": {"kind": "Layer", "eps": {"$var": "eps"}, "gain": "W", "bias": {"$var": "nbias"}}},
    {"name": "types", "value": {"$layer_types": {"n": {"$var": "n"}, "allowed": ["full_attention", "sliding_attention"], "each": {"$if": [{"$eq": [{"$mod": [{"$var": "i"}, {"$var": "every"}]}, 0]}, "full_attention", "sliding_attention"]}}}},
    {"name": "keyed", "value": {"$has": "rope_parameters"}},
    {"name": "rope", "value": {"$if": [{"$var": "keyed"}, {"$rope": {"dim": {"$var": "hd"}, "theta": 160000.0, "layer_type": "full_attention", "max_pos": {"$var": "max_pos0"}}}, {"$rope_plain": {"dim": {"$var": "hd"}, "theta": {"$cfg": ["global_rope_theta", 160000.0]}}}]}},
    {"name": "rope_local", "value": {"$if": [{"$var": "keyed"}, {"$rope": {"dim": {"$var": "hd"}, "theta": 10000.0, "layer_type": "sliding_attention", "max_pos": {"$var": "max_pos0"}}}, {"$rope_plain": {"dim": {"$var": "hd"}, "theta": {"$cfg": ["local_rope_theta", 10000.0]}}}]}},
    {"name": "band", "value": {"$add": [{"$idiv": [{"$var": "local"}, 2]}, 1]}},
    {"name": "sliding", "value": {"$eq": [{"$index": [{"$var": "types"}, {"$var": "i"}]}, "sliding_attention"]}, "layer": true},
    {"name": "l_mixer", "layer": true, "value": {"Attention": {"heads": {"$var": "heads"}, "kv_heads": {"$var": "heads"}, "head_dim": {"$var": "hd"}, "v_head_dim": {"$var": "hd"}, "q_bias": {"$var": "abias"}, "k_bias": {"$var": "abias"}, "v_bias": {"$var": "abias"}, "o_bias": {"$var": "abias"}, "position": {"Rope": {"$if": [{"$var": "sliding"}, {"$var": "rope_local"}, {"$var": "rope"}]}}, "window": {"$if": [{"$var": "sliding"}, {"$var": "band"}, null]}, "scale": {"$div": [1.0, {"$sqrt": {"$var": "hd"}}]}}}},
    {"name": "l_ffn", "layer": true, "value": {"Mlp": {"intermediate": {"$var": "inter"}, "act": {"$var": "act"}, "gated": true, "up_bias": {"$var": "mbias"}, "down_bias": {"$var": "mbias"}}}},
    {"name": "l_residual", "layer": true, "value": {"Sequential": {"pre_mixer": {"$if": [{"$eq": [{"$var": "i"}, 0]}, null, {"$var": "norm"}]}, "pre_ffn": {"$var": "norm"}, "multiplier": 1.0}}},
    {"name": "embedding", "value": {"dim": {"$var": "hidden"}, "scale": 1.0, "positions": null, "norm": {"$var": "norm"}, "type_rows": null, "rel_bias": null}},
    {"name": "final_norm", "value": {"$var": "norm"}},
    {"name": "qkv_layout", "value": "FusedConcat"},
    {"name": "mlp_layout", "value": "FusedGateFirst"},
    {"name": "names", "value": {"embed": "embeddings.tok_embeddings", "embed_norm": "embeddings.norm", "final_norm": "final_norm", "attn.qkv": "layers.{L}.attn.Wqkv", "attn.o": "layers.{L}.attn.Wo", "norm.mix": "layers.{L}.attn_norm", "mlp.gate_up": "layers.{L}.mlp.Wi", "mlp.down": "layers.{L}.mlp.Wo", "norm.ffn": "layers.{L}.mlp_norm"}},
    {"name": "prefix_aliases", "value": [["", "model."]]},
    {"name": "ignored_prefixes", "value": ["head.", "decoder.", "classifier.", "drop."]},
    {"name": "model_type", "value": "modernbert"}
  ]
}
