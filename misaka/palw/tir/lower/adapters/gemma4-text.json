    {"name": "rope_i", "value": {"$rope": {"dim": {"$var": "hd_i"}, "style": "Half", "theta": {"$if": [{"$var": "full"}, 1000000.0, 10000.0]}, "layer_type": {"$index": [{"$var": "types"}, {"$var": "i"}]}, "max_pos": {"$var": "max_pos"}}}, "layer": true},
    {"name": "l_mixer", "value": {"Attention": {"heads": {"$var": "heads"}, "kv_heads": {"$var": "kv_i"}, "head_dim": {"$var": "hd_i"}, "v_head_dim": {"$var": "hd_i"}, "q_bias": {"$var": "abias"}, "k_bias": {"$var": "abias"}, "v_bias": {"$var": "abias"}, "o_bias": {"$var": "abias"}, "qk_norm": {"norm": {"$var": "norm"}, "scope": "PerHeadShared"}, "v_norm": {"$if": [{"$var": "shares"}, null, {"norm": {"$var": "weightless"}, "scope": "PerHeadShared"}]}, "position": {"Rope": {"$var": "rope_i"}}, "scale": 1.0, "window": {"$if": [{"$var": "full"}, null, {"$var": "sw"}]}, "v_from_k": {"$and": [{"$var": "k_eq_v"}, {"$var": "full"}, {"$not": {"$var": "shares"}}]}, "param_prefix": {"$if": [{"$or": [{"$ne": [{"$var": "hd_i"}, {"$var": "hd"}]}, {"$ne": [{"$var": "kv_i"}, {"$var": "kv"}]}]}, {"$cat": ["attn", {"$var": "hd_i"}, "x", {"$var": "kv_i"}]}, null]}, "kv_share": {"$if": [{"$var": "shares"}, {"Consumer": {"slot": {"$index": [{"$var": "slot_by_layer"}, {"$var": "src_i"}]}}}, {"$if": [{"$ne": [{"$index": [{"$var": "slot_by_layer"}, {"$var": "i"}]}, null]}, {"Source": {"slot": {"$index": [{"$var": "slot_by_layer"}, {"$var": "i"}]}}}, null]}]}}}, "layer": true},
