    {"name": "share_s", "value": {"$gt": [{"$sum": {"$map": [{"$range": {"$var": "n"}}, "j", {"$if": [{"$and": [{"$ge": [{"$var": "j"}, {"$var": "first_shared"}]}, {"$eq": [{"$index": [{"$var": "types"}, {"$var": "j"}]}, "sliding_attention"]}]}, 1, 0]}]}}, 0]}},
