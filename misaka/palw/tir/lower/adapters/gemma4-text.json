    {"name": "src_s", "value": {"$if": [{"$eq": [{"$var": "first_shared"}, 0]}, -1, {"$max": {"$map": [{"$range": {"$var": "first_shared"}}, "j", {"$if": [{"$eq": [{"$index": [{"$var": "types"}, {"$var": "j"}]}, "sliding_attention"]}, {"$var": "j"}, -1]}]}}]}},
