    {"name": "moe", "value": {"$if": [{"$var": "moe_on"}, {"$let": ["e", {"$cfg?": "num_experts"}, {"$let": ["_a", {"$bad": [{"$ne": [{"$var": "e"}, null]}, "enable_moe_block without num_experts"]}, {"$let": ["k", {"$cfg?": "top_k_experts"}, {"$let": ["_b", {"$bad": [{"$ne": [{"$var": "k"}, null]}, "enable_moe_block without top_k_experts"]}, {"$let": ["_c", {"$bad": [{"$and": [{"$gt": [{"$var": "k"}, 0]}, {"$le": [{"$var": "k"}, {"$var": "e"}]}]}, {"$cat": ["top-", {"$var": "k"}, " of ", {"$var": "e"}, " experts"]}]}, {"$let": ["mi", {"$cfg?": "moe_intermediate_size"}, {"$let": ["_d", {"$bad": [{"$ne": [{"$var": "mi"}, null]}, "no moe_intermediate_size"]}, {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "mi"}, "act": {"$var": "act"}, "glu": "Standard", "expert_bias": false, "router": {"scoring": "Softmax", "linear_bias": false, "selection_bias": false, "groups": null, "normalize": true, "norm_eps": 0.0, "scale": 1.0, "jitter_eps": 0.0, "per_expert_scale": true}, "shared": null, "input_scaled": false}]}]}]}]}]}]}]}, null]}},
