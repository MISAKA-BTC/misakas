    {"name": "kvh_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "kv_i"}, 0]}, {"$eq": [{"$mod": [{"$var": "heads"}, {"$var": "kv_i"}]}, 0]}]}, {"$cat": ["layer ", {"$var": "i"}, ": ", {"$var": "heads"}, " heads over ", {"$var": "kv_i"}, " kv heads"]}]}, "layer": true},
