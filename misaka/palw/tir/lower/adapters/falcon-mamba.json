{
  "format": "misaka.palw.model-adapter.v1",
  "id": "falcon-mamba",
  "doc": "FalconMamba (Mamba-1 with weightless RMS norms on dt, B and C); the -hf conversions' mamba_ssm keys (n_layer, d_model, d_inner, dt_rank, ssm_cfg ...) must agree or be inert.",
  "extends": ["spec-frame"],
  "match": {"architectures": ["FalconMambaForCausalLM"], "model_types": ["falcon_mamba"]},
  "config": {"defaults": {"vocab_size": 50280, "hidden_size": 768, "num_hidden_layers": 32, "state_size": 16, "expand": 2, "conv_kernel": 4, "layer_norm_epsilon": 1e-05, "use_bias": false, "use_conv_bias": true, "tie_word_embeddings": true, "hidden_act": "silu"}, "inert": ["fused_add_norm", "pad_vocab_size_multiple", "d_inner", "dt_rank", "time_step_scale", "time_step_min", "time_step_max", "time_step_init_scheme", "time_step_floor", "rescale_prenorm_residual", "use_mambapy", "use_associative_scan", "residual_in_fp32", "use_falcon_mambapy"]},
  "vars": [
    {"name": "vocab", "value": {"$cfg": "vocab_size"}},
    {"name": "hidden", "value": {"$cfg": "hidden_size"}},
    {"name": "n", "value": {"$cfg": "num_hidden_layers"}},
    {"name": "state", "value": {"$cfg": "state_size"}},
    {"name": "expand", "value": {"$cfg": "expand"}},
    {"name": "conv", "value": {"$cfg": "conv_kernel"}},
    {"name": "eps", "value": {"$cfg": "layer_norm_epsilon"}},
    {"name": "bias", "value": {"$cfg": "use_bias"}},
    {"name": "conv_bias", "value": {"$cfg": "use_conv_bias"}},
    {"name": "tied", "value": {"$cfg": "tie_word_embeddings"}},
    {"name": "act_name", "value": {"$cfg": "hidden_act"}},
    {"name": "act_ok", "value": {"$check": [{"$or": [{"$eq": [{"$var": "act_name"}, "silu"]}, {"$eq": [{"$var": "act_name"}, "swish"]}]}, {"$cat": ["hidden_act ", {"$var": "act_name"}]}]}},
    {"name": "n_layer_ok", "value": {"$let": ["nl", {"$cfg?": "n_layer"}, {"$bad": [{"$or": [{"$eq": [{"$var": "nl"}, null]}, {"$eq": [{"$var": "nl"}, {"$var": "n"}]}]}, "n_layer ≠ num_hidden_layers"]}]}},
    {"name": "rms_ok", "value": {"$require_eq": ["rms_norm", true, "transformers' Mamba always uses RMSNorm"]}},
    {"name": "d_model_ok", "value": {"$let": ["dm", {"$cfg?": "d_model"}, {"$bad": [{"$or": [{"$eq": [{"$var": "dm"}, null]}, {"$eq": [{"$var": "dm"}, {"$var": "hidden"}]}]}, "d_model ≠ hidden_size"]}]}},
    {"name": "ssm_ok", "value": {"$let": ["_", {"$forbid": ["ssm_cfg", "a mamba_ssm layer configuration transformers does not read"]}, false]}},
    {"name": "dt_rank", "value": {"$let": ["r", {"$cfg?": "time_step_rank"}, {"$if": [{"$or": [{"$eq": [{"$var": "r"}, null]}, {"$eq": [{"$var": "r"}, "auto"]}]}, {"$idiv": [{"$add": [{"$var": "hidden"}, 15]}, 16]}, {"$var": "r"}]}]}},
    {"name": "inner", "value": {"$mul": [{"$var": "expand"}, {"$var": "hidden"}]}},
    {"name": "inter_ok", "value": {"$let": ["i", {"$cfg?": "intermediate_size"}, {"$bad": [{"$or": [{"$eq": [{"$var": "i"}, null]}, {"$eq": [{"$var": "i"}, {"$var": "inner"}]}]}, "intermediate_size ≠ expand·hidden"]}]}},
    {"name": "mixer_eps", "value": {"$if": [true, {"$cfg": ["mixer_rms_eps", 1e-06]}, null]}},
    {"name": "bcdt", "value": {"kind": "Rms", "eps": {"$var": "mixer_eps"}, "gain": "None", "bias": false}},
    {"name": "norm", "value": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}},
    {"name": "l_mixer", "value": {"Mamba": {"inner": {"$var": "inner"}, "state": {"$var": "state"}, "conv_kernel": {"$var": "conv"}, "dt_rank": {"$var": "dt_rank"}, "conv_bias": {"$var": "conv_bias"}, "proj_bias": {"$var": "bias"}, "bcdt_norm": {"$var": "bcdt"}}}, "layer": true},
    {"name": "l_ffn", "value": "None", "layer": true},
    {"name": "l_residual", "value": {"Sequential": {"pre_mixer": {"$var": "norm"}, "post_mixer": null, "pre_ffn": null, "post_ffn": null, "multiplier": 1.0}}, "layer": true},
    {"name": "final_norm", "value": {"$var": "norm"}},
    {"name": "names", "value": {"embed": "backbone.embeddings", "final_norm": "backbone.norm_f", "norm.mix": "backbone.layers.{L}.norm", "mamba.in": "backbone.layers.{L}.mixer.in_proj", "mamba.conv": "backbone.layers.{L}.mixer.conv1d", "mamba.x": "backbone.layers.{L}.mixer.x_proj", "mamba.dt": "backbone.layers.{L}.mixer.dt_proj", "mamba.A_log": "backbone.layers.{L}.mixer.A_log", "mamba.D": "backbone.layers.{L}.mixer.D", "mamba.out": "backbone.layers.{L}.mixer.out_proj", "mamba2.in": "backbone.layers.{L}.mixer.in_proj", "mamba2.conv": "backbone.layers.{L}.mixer.conv1d", "mamba2.dt_bias": "backbone.layers.{L}.mixer.dt_bias", "mamba2.A_log": "backbone.layers.{L}.mixer.A_log", "mamba2.D": "backbone.layers.{L}.mixer.D", "mamba2.norm": "backbone.layers.{L}.mixer.norm", "mamba2.out": "backbone.layers.{L}.mixer.out_proj", "lm_head": {"$if": [{"$var": "tied"}, "backbone.embeddings", "lm_head"]}}},
    {"name": "families", "value": ["C5"]},
    {"name": "model_type", "value": "falcon_mamba"}
  ]
}
