{
  "format": "misaka.palw.model-adapter.v1",
  "id": "gpt-oss",
  "doc": "gpt-oss: attention sinks, alternating 128-token sliding / full attention, YaRN (truncate = false), a biased router with softmax over the top-k logits, clamped SwiGLU experts with interleaved gate/up columns stored [E, in, out].",
  "extends": ["decoder-core"],
  "match": {"architectures": ["GptOssForCausalLM"], "model_types": ["gpt_oss"]},
  "config": {"defaults": {"vocab_size": 201088, "hidden_size": 2880, "intermediate_size": 2880, "num_hidden_layers": 36, "num_attention_heads": 64, "num_key_value_heads": 8, "head_dim": 64, "max_position_embeddings": 131072, "rms_norm_eps": 1e-05, "attention_bias": true, "sliding_window": 128, "num_experts_per_tok": 4}, "inert": ["hidden_act", "initial_context_length", "rope_scaling_factor"]},
  "vars": [
    {"name": "sw", "value": {"$cfgn": "sliding_window"}},
    {"name": "e", "value": {"$alias": [["num_local_experts", "num_experts"], 128]}},
    {"name": "k", "value": {"$alias": [["num_experts_per_tok", "experts_per_token"], 4]}},
    {"name": "topk_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "k"}, 0]}, {"$le": [{"$var": "k"}, {"$var": "e"}]}]}, {"$cat": ["top-k ", {"$var": "k"}, " of ", {"$var": "e"}, " experts"]}]}},
    {"name": "swiglu_ok", "value": {"$require_eq": ["swiglu_limit", 7.0, "GptOssExperts hard-codes limit = 7.0"]}},
    {"name": "types", "value": {"$layer_types": {"n": {"$var": "n"}, "allowed": ["full_attention", "sliding_attention"], "each": {"$if": [{"$eq": [{"$mod": [{"$var": "i"}, 2]}, 0]}, "sliding_attention", "full_attention"]}}}},
    {"name": "act", "value": "Silu"},
    {"name": "rope_theta", "value": 150000.0},
    {"name": "mbias", "value": false},
    {"name": "attn_extra", "value": {"sinks": true}},
    {"name": "l_ffn", "value": {"Moe": {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "inter"}, "act": "Silu", "glu": {"ClampedSwiGlu": {"alpha": 1.702, "limit": 7.0}}, "expert_bias": true, "router": {"scoring": "TopKThenSoftmax", "normalize": false, "linear_bias": true}}}, "layer": true},
    {"name": "experts_layout", "value": "FusedInterleaved"},
    {"name": "names", "value": {"$merge": [{"$var": "names_base"}, {"attn.sinks": "{p}layers.{L}.self_attn.sinks", "moe.router": "{p}layers.{L}.mlp.router", "moe.gate_up.stacked": "{p}layers.{L}.mlp.experts.gate_up_proj", "moe.gate_up_bias.stacked": "{p}layers.{L}.mlp.experts.gate_up_proj_bias", "moe.down.stacked": "{p}layers.{L}.mlp.experts.down_proj", "moe.down_bias.stacked": "{p}layers.{L}.mlp.experts.down_proj_bias"}]}},
    {"name": "families", "value": ["C2", "C3", "C8"]},
    {"name": "model_type", "value": "gpt_oss"}
  ]
}
