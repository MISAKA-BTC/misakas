{
 "schema": "misaka.palw.quant-format.v1",
 "name": "MLX_AFFINE",
 "doc": "MLX's affine quantisation (mlx.core.quantize, mode affine; what mlx-lm saves, MLX_QUANT_V1): a quantised module keeps its codes under the float export's own name, `<module>.weight` uint32 [out, in * bits / 32] \u2014 per row a little-endian bit stream, code i in bits [i * bits, (i + 1) * bits), so 3, 5 and 6 bits straddle the words \u2014 beside `<module>.scales` and `<module>.biases` [out, in / group_size] in the model's float type. W[o, i] = scales[o, g] * q[o, i] + biases[o, g], g = i / group_size: served as the float `<module>.weight` (f64, exact for float16 / bfloat16 operands, rounded once to float32), so every binding that reads the float export \u2014 projections, the embedding table, a tied head \u2014 reads it unchanged. A module MLX left in float has a float `.weight` and no companions, and passes through. MLX writes no quant_method; the reader names an MLX block `mlx` (prequant::quant_block). Its other modes (mxfp4, mxfp8, nvfp4) store other tensors and are refused by name. The vectors are MLX 0.32's own quantize, and its dequantize on the GPU with the scales and biases widened to float32 (a fused multiply-add: the same single rounding), checked against the definition when they were made (tools/gen_mlx_fixtures.py vectors).",
 "ids": [
  {
   "scheme": "config",
   "method": "mlx"
  }
 ],
 "params": {
  "bits": {
   "config": "bits",
   "allowed": [
    2,
    3,
    4,
    5,
    6,
    8
   ]
  },
  "group_size": {
   "config": "group_size",
   "allowed": [
    32,
    64,
    128
   ]
  },
  "affine": {
   "config": "mode",
   "default": 1,
   "map": {
    "affine": 1
   },
   "allowed": [
    1
   ]
  }
 },
 "layout": {
  "kind": "virtual",
  "serve_suffix": ".weight",
  "roles": [
   {
    "name": "weight",
    "suffix": ".weight",
    "dtypes": [
     "U32"
    ],
    "rank": 2
   },
   {
    "name": "scales",
    "suffix": ".scales",
    "dtypes": [
     "F16",
     "BF16",
     "F32"
    ],
    "rank": 2
   },
   {
    "name": "biases",
    "suffix": ".biases",
    "dtypes": [
     "F16",
     "BF16",
     "F32"
    ],
    "rank": 2
   }
  ],
  "axes": [
   "o",
   "i"
  ],
  "shape": [
   "dim_weight[0]",
   "dim_weight[1] * 32 / bits"
  ],
  "checks": [
   {
    "expr": "(dim_weight[1] * 32) % bits == 0",
    "message": "a packed row is not a whole number of codes"
   },
   {
    "expr": "dim_scales[0] == dim_weight[0] && dim_biases[0] == dim_weight[0]",
    "message": "the scales and biases are not one row per output"
   },
   {
    "expr": "dim_scales[1] * group_size == dim_weight[1] * 32 / bits && dim_biases[1] == dim_scales[1]",
    "message": "the scales and biases are not one per group of the input"
   }
  ]
 },
 "decode": {
  "target": "tensor",
  "value": "scales[o, i / group_size] * ((((i * bits) % 32 + bits <= 32) ? (weight[o, (i * bits) / 32] >> ((i * bits) % 32)) : ((weight[o, (i * bits) / 32] >> ((i * bits) % 32)) | (weight[o, (i * bits) / 32 + 1] << (32 - (i * bits) % 32)))) & ((1 << bits) - 1)) + biases[o, i / group_size]"
 },
