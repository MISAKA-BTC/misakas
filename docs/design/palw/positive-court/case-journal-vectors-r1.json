  "generator_source": "#!/usr/bin/env python3\n\"\"\"Independent A0-r1 journal vectors: Python standard library only.\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nimport struct\nimport sys\n\nEVENT_KEY = b'misaka/positive/case-journal-event/v2/r1'\nHISTORY_KEY = b'misaka/positive/case-journal-history/v2/r1'\ndef d(n):\n    return bytes([n]) * 64\ndef origin(n, tx=0x04030201, event=0x08070605):\n    return d(n) + d(n+1) + d(n+2) + struct.pack('<IIQQ', tx, event, 0x0102030405060708, 0x1112131415161718)\ndef digest(key, raw):\n    return hashlib.blake2b(raw, key=key, digest_size=64).digest()\nSCOPE = d(1) + d(2) + d(3)\nCASE = d(4)\nRESULT = d(5)\nORIGIN = origin(11)\ndef record(name, sequence, previous, kind, payload, aux):\n    assert payload\n    aux = sorted(aux, key=lambda entry: entry[0])\n    raw = (struct.pack('<HH', 2, 1) + SCOPE + CASE + RESULT + struct.pack('<Q', sequence) + previous + ORIGIN\n           + bytes([kind]) + struct.pack('<I', len(payload)) + payload + struct.pack('<I', len(aux)))\n    for material, preimage in aux:\n        assert len(material) == 280 and preimage\n        raw += material + struct.pack('<I', len(preimage)) + preimage\n    head = digest(EVENT_KEY, raw)\n    history = digest(HISTORY_KEY, raw)\n    return dict(name=name, sequence=sequence, previous_hex=previous.hex(), kind=kind,\n                origin_hex=ORIGIN.hex(), payload_hex=payload.hex(), aux=[dict(material_hex=m.hex(),preimage_hex=p.hex()) for m,p in aux],\n                record_bytes=len(raw), record_hex=raw.hex(), head_hex=head.hex(), history_digest_hex=history.hex(),\n                history_material_hex=(ORIGIN + history).hex()), head\n\n# Complete existing op6/op5 body bytes. Their phase/admission/authenticity is\n# deliberately not asserted by this leaf codec fixture.\na, head_a = record('initial_zero_aux_body_envelope', 1, bytes(64), 0, struct.pack('<HHB', 2, 1, 6) + CASE + RESULT, [])\n# Raw Borsh lexicographic order puts LE tx ordinal256 before ordinal1.\naux = [(origin(31, 1, 0) + d(81), b'one'), (origin(31, 256, 0) + d(80), bytes([0,1,0,255,127]))]\nb, head_b = record('continued_finish_with_lexicographic_aux', 2, head_a, 0, struct.pack('<HHB', 2, 1, 5) + CASE + RESULT + d(6), aux)\nc, _ = record('opaque_native_transaction_preimage', 3, head_b, 1, bytes(range(32)) + b'opaque-native-transaction-fixture', [])\ndocument = dict(contract='A0 Positive case journal v2/r1', generator='Python3 hashlib.blake2b(key=domain,digest_size=64) + struct.pack; no Rust/Borsh encoder',\n                event_domain=EVENT_KEY.decode(), history_domain=HISTORY_KEY.decode(),\n                authority='Vectors validate only bounded leaf encoding/identity. Native owner must validate operation phase, complete payload semantics, accepted origins and aux preimage domains; opaque transaction bytes are not a native admission.',\n                header_bytes=613, auxiliary_material_bytes=280, vectors=[a,b,c])\ndocument['generator_source'] = Path(__file__).read_text()\nPath(sys.argv[1]).write_text(json.dumps(document, indent=2) + '\\n')\n"
