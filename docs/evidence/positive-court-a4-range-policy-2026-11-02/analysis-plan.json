  "plan_without_numeric_relaxation": [
    {
      "step": 1,
      "action": "Keep the existing raw analysis JSON immutable, including Element cap errors, null partial work and NOT_COMPARABLE_INCOMPLETE. Do not fill in cap+1 as measured partial work."
    },
    {
      "step": 2,
      "action": "For class-only reporting, expose the already completed Range result as diagnostic primary_bounds; preserve Element as reference_crosscheck with its own status/work/time. Without authentic policy inputs mark it DIAGNOSTIC_ONLY, not ADMITTED. Do not rewrite the existing global status to imply full twin comparison."
    },
    {
      "step": 3,
      "action": "For native or full pure-gate evaluation resolve original params/DAA/fence/demand/F7/court/window/ceilings/ladder/canonical input and authentic registration/funding/signature facts. Use only the twin selected by existing rules, not a fabricated H7/court value."
    },
    {
      "step": 4,
      "action": "If H7 is active, use the existing Range implementation already selected by v10/V2. G03 terminal allocation already uses Range. Retain cap67108864, original model/context/layout, 4B/8B pricing, complete key coverage, stop/comparison rules, coarse envelope, bytes, fees and work units."
    },
    {
      "step": 5,
      "action": "If Release2000 selects Element, do not auto-fallback to Range, raise the cap, borrow the court-on result for court-off, reduce context or reinterpret the error. That would alter cap-limited acceptance even if numeric constants were unchanged."
    },
    {
      "step": 6,
      "action": "Preserve existing read-set/bound differential tests, exact-cap/cap-1 tests and known-valid nonzero success fixtures. Treat work counts as implementation-specific sizing work, not equal twin counters or model compute-credit. For Smol off, record uncompleted crosscheck honestly."
    },
    {
      "step": 7,
      "action": "After separate authorization only, run a same-source genuine native/pure registration evaluation with actual inputs and runtime resource/funding boundaries. Full-pass/correctness/credit cannot be inferred from Range sizing completion."
    }
