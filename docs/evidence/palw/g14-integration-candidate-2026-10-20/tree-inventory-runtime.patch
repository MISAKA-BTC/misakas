+//! All branches of one pinned numerical tree, before any root disclosure.
+//! Callers must derive tiles and demand bounds from the actual original job and
+//! registered program, and sum every eligible leaf. This inventory omits roots,
+//! terminal witnesses, signed envelopes, source/semantic work, repeated invalid
+//! ingress, CPU/IO, retention and funding. It grants no capacity or default right.
+use std::collections::BTreeMap;
+use crate::palw_attn_dissect::palw_attn_arity_is_legal_v1;
+use super::{PALW_TIR_DISSECT_MAX_REDUCTIONS, PALW_TIR_DISSECT_MAX_VALUES};
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct NumericalTreeInventoryV1 {
+    pub disclosures: u64,
+    pub terminals: u64,
+    pub child_claims: u64,
+    /// Sum of path lengths over internal nodes, excluding Vec prefixes.
+    pub disclosure_path_bytes: u64,
+    pub max_depth: u32,
+    /// Only PalwTirDissectRoundV1 bodies, with demand at the supplied bound.
+    pub round_body_bytes_upper: u64,
+    pub max_round_body_bytes_upper: u64,
+}
+
+/// Exact tree topology for the existing ceil-width cut, not a full k-ary tree
+/// approximation. Equal-sized ranges are aggregated, so even u32::MAX tiles do
+/// not allocate or visit one record per tile. Zero tiles and illegal arities
+/// refuse. Reduction/value bounds are existing native caps, never enlarged here.
+pub fn numerical_tree_inventory_v1(
+    tiles: u32, arity: u8, reductions: usize, values_upper: u64,
+) -> Option<NumericalTreeInventoryV1> {
+    if tiles == 0 || !palw_attn_arity_is_legal_v1(arity)
+        || reductions > PALW_TIR_DISSECT_MAX_REDUCTIONS
+        || values_upper > PALW_TIR_DISSECT_MAX_VALUES as u64 {
+        return None;
+    }
+    let child_bytes = 4u64.checked_add(4u64.checked_mul(reductions as u64)?)?
+        .checked_add(16u64.checked_mul(values_upper)?)?;
+    let mut out = NumericalTreeInventoryV1::default();
+    let mut level = BTreeMap::from([(u64::from(tiles), 1u64)]);
+    let mut depth = 0u32;
+    while !level.is_empty() {
+        let mut next = BTreeMap::<u64, u64>::new();
+        for (count, multiplicity) in level {
+            out.max_depth = depth;
+            if count == 1 {
+                out.terminals = out.terminals.checked_add(multiplicity)?;
+                continue;
+            }
+            // Same partition as palw_attn_child_ranges_v1: full ceil-width
+            // children followed by at most one shorter remainder.
+            let width = count.div_ceil(u64::from(arity));
+            let full = count / width;
+            let tail = count % width;
+            let children = full.checked_add(u64::from(tail != 0))?;
+            out.disclosures = out.disclosures.checked_add(multiplicity)?;
+            out.child_claims = out.child_claims.checked_add(multiplicity.checked_mul(children)?)?;
+            out.disclosure_path_bytes = out.disclosure_path_bytes
+                .checked_add(multiplicity.checked_mul(u64::from(depth))?)?;
+            let bytes = 6u64.checked_add(children.checked_mul(child_bytes)?)?;
+            out.round_body_bytes_upper = out.round_body_bytes_upper.checked_add(multiplicity.checked_mul(bytes)?)?;
+            out.max_round_body_bytes_upper = out.max_round_body_bytes_upper.max(bytes);
+            let entry = next.entry(width).or_default();
+            *entry = entry.checked_add(multiplicity.checked_mul(full)?)?;
+            if tail != 0 {
+                let entry = next.entry(tail).or_default();
+                *entry = entry.checked_add(multiplicity)?;
+            }
+        }
+        level = next;
+        depth = depth.checked_add(1)?;
+    }
+    Some(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::palw_attn_dissect::{palw_attn_child_ranges_v1, palw_kary_rounds_v1};
+    use crate::palw_tir_dissect_v1::{PalwTirDissectRoundV1, PalwTirRangeClaimV1};
+
+    #[test]
+    fn aggregated_inventory_matches_native_cuts_and_actual_borsh_bodies() {
+        for arity in [2, 4, 8, 16, 32, 64] {
+            for tiles in 1..=257 {
+                let mut expected = NumericalTreeInventoryV1::default();
+                let mut todo = vec![(0, u64::from(tiles), 0u32)];
+                while let Some((first, count, depth)) = todo.pop() {
+                    expected.max_depth = expected.max_depth.max(depth);
+                    let ranges = palw_attn_child_ranges_v1(first, count, arity).unwrap();
+                    if ranges.is_empty() { expected.terminals += 1; continue; }
+                    expected.disclosures += 1;
+                    expected.child_claims += ranges.len() as u64;
+                    expected.disclosure_path_bytes += u64::from(depth);
+                    let body = PalwTirDissectRoundV1 { version: 1, children: ranges.iter().map(|_| {
+                        PalwTirRangeClaimV1 { partials: vec![vec![0; 2], vec![0; 3]] }
+                    }).collect() };
+                    let bytes = borsh::to_vec(&body).unwrap().len() as u64;
+                    expected.round_body_bytes_upper += bytes;
+                    expected.max_round_body_bytes_upper = expected.max_round_body_bytes_upper.max(bytes);
+                    todo.extend(ranges.into_iter().map(|(f, n)| (f, n, depth + 1)));
+                }
+                assert_eq!(numerical_tree_inventory_v1(tiles, arity, 2, 5), Some(expected));
+                assert_eq!(Some(expected.max_depth), palw_kary_rounds_v1(u64::from(tiles), arity));
+                assert_eq!(expected.child_claims + 1, expected.disclosures + expected.terminals);
+            }
+        }
+    }
+
+    #[test]
+    fn maximum_history_and_native_caps_without_enumerating_leaves() {
+        for arity in [2, 4, 8, 16, 32, 64] {
+            let v = numerical_tree_inventory_v1(u32::MAX, arity, 16, 4096).unwrap();
+            assert_eq!(v.terminals, u64::from(u32::MAX));
+            assert!(v.disclosures < v.terminals);
+            assert_eq!(v.child_claims + 1, v.disclosures + v.terminals);
+            assert_eq!(Some(v.max_depth), palw_kary_rounds_v1(u64::from(u32::MAX), arity));
+        }
+        for arity in 0..=u8::MAX {
+            assert_eq!(numerical_tree_inventory_v1(1, arity, 0, 0).is_some(), palw_attn_arity_is_legal_v1(arity));
+        }
+        assert!(numerical_tree_inventory_v1(0, 2, 0, 0).is_none());
+        assert!(numerical_tree_inventory_v1(1, 2, 17, 0).is_none());
+        assert!(numerical_tree_inventory_v1(1, 2, 1, 4097).is_none());
+    }
+}
