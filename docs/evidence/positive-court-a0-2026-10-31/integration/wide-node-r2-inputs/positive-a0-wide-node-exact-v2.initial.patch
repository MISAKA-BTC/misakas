+        } else {
+            (
+                vec![],
+                Some(WideGeneratedIdsPinV2 {
+                    rows_root: crate::palw_logits_q24_v2::rows_root(&f.binding.job_context, &f.rows).unwrap(),
+                    generated_token_ids: f.generated.clone(),
