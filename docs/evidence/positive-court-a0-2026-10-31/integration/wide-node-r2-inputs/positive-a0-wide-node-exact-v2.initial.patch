+        let row = step.logits.data.iter().map(|v| i64::try_from(*v).unwrap()).collect::<Vec<_>>();
+        let selected = row.iter().enumerate().reduce(|a, b| if b.1 > a.1 { b } else { a }).unwrap().0 as u32;
