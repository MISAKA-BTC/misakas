+            operands: PalwStepInputRowV1 {
+                preimages: vec![f.preimages[index].clone()],
+                run_siblings: vec![step_merkle_range_siblings_v1(&f.hashes, index, 1).unwrap()],
+            },
+            params: PalwTirParamOpeningV1::None,
