+            compiled: &compiled,
+            class: &class,
+            artifact,
+            expected_class: class_id,
+            space,
+            original_context: &ctx,
+            expected_execution: execution,
+            external_retained_bytes: EXTERNAL,
+            external_ticket: &ticket,
+        },
