+            let mut budget = DenseMeasurementBudgetV2::new(dense_limits()).unwrap();
+            let prepared = owner.prepare_dense_measurement(&ordinary, &mut budget).unwrap();
+            // Execute is a generic runner rejection, not Miner/arithmetic blame.
