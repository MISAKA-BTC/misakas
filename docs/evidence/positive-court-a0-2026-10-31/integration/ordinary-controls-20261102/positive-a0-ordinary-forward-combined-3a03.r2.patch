+fn reserver(held: Arc<AtomicU64>, calls: Arc<AtomicUsize>) -> TirMemoryReserverV1 {
+    Arc::new(move |_, _, _, n| {
+        assert!(n > 0);
+        calls.fetch_add(1, Ordering::SeqCst);
+        held.fetch_add(n, Ordering::SeqCst);
+        Ok(Box::new(Guard(held.clone(), n)))
+    })
