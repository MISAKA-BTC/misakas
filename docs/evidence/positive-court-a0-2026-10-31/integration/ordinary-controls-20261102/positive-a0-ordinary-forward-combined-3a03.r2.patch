+fn reserve(live: Arc<AtomicU64>, calls: Arc<AtomicUsize>) -> TirMemoryReserverV1 {
+    Arc::new(move |_, _, _, bytes| {
+        calls.fetch_add(1, Ordering::SeqCst);
+        live.fetch_add(bytes, Ordering::SeqCst);
+        Ok(Box::new(Guard(live.clone(), bytes)))
+    })
+}
