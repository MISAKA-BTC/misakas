diff --git a/misaka/palw/tir/core/tests/wide_logits_structural.rs b/misaka/palw/tir/core/tests/wide_logits_structural.rs
new file mode 100644
--- /dev/null
+++ b/misaka/palw/tir/core/tests/wide_logits_structural.rs
@@ -0,0 +1,165 @@
+//! Structural recognition only: no new wire, execution adapter or native admission.
+mod common;
+
+use common::models::{Gen, Model, materialize};
+use misaka_palw_tir::builder::ProgramBuilder;
+use misaka_palw_tir::program::{HISTORY_BOUND_V1_SMALL, LOGITS_I64_Q24_SCHEME_V2};
+use misaka_palw_tir::validate::validate;
+use misaka_palw_tir::{DType, Interpreter, MapParams, Node, Prim, Ref, TirErrorKind, TirProgramV1};
+
+fn scheme(domain: &[u8], part: &[u8]) -> [u8; 64] {
+    let mut hash = blake2b_simd::Params::new().hash_length(64).key(domain).to_state();
+    hash.update(&(part.len() as u64).to_le_bytes());
+    hash.update(part);
+    hash.finalize().as_bytes().try_into().unwrap()
+}
+
+fn old_scheme() -> [u8; 64] {
+    scheme(b"misaka-palw/tiled-logits/scheme/v1", b"tiled-logits-v1")
+}
+
+// The existing whole-program fixture's parameter generator supplies actual
+// reference-interpreter inputs; this is not a second mock validation grammar.
+fn wide_fixture() -> (TirProgramV1, MapParams) {
+    let mut model = Model::new(4);
+    let input = model.p("input", DType::I32, &[2], false, Gen::Const(3));
+    let scale = model.pb.scalar(DType::I64, 1i128 << 40);
+    let pre = {
+        let mut b = model.pb.block("pre", vec![]);
+        let row = b.reshape_fixed(input, &[2]);
+        b.finish(&[row])
+    };
+    let carry = model.pb.blocks[pre as usize].nodes[0].out.clone();
+    let (post, logits) = {
+        let mut b = model.pb.block("post", vec![carry]);
+        let wide = b.cast(Ref::CarryIn(0), DType::I64);
+        let result = b.mul(wide, scale, DType::I64);
+        b.commit(result);
+        let Ref::Node(logits) = result else { unreachable!() };
+        (b.finish(&[]), logits)
+    };
+    let mut program = model.pb.finish(pre, vec![], post, logits);
+    program.logits_scheme_id = LOGITS_I64_Q24_SCHEME_V2;
+    let params = materialize(&program, &model.gens, 7);
+    (program, params)
+}
+
+fn reject(program: &TirProgramV1, reason: &str) {
+    let error = validate(program).unwrap_err();
+    assert_eq!(error.kind, TirErrorKind::NormalForm);
+    assert!(error.msg.contains(reason), "unexpected refusal: {error}");
+    assert!(TirProgramV1::decode_canonical(&program.encode()).is_err());
+}
+
+#[test]
+fn wide_scheme_matches_the_adopted_independent_keyed_hash_vector() {
+    let derived = scheme(b"misaka-palw/tiled-logits/scheme/v2", b"tiled-logits-i64-q24-v2");
+    assert_eq!(derived, LOGITS_I64_Q24_SCHEME_V2);
+    let hex = derived.iter().map(|byte| format!("{byte:02x}")).collect::<String>();
+    assert_eq!(
+        hex,
+        "ad7dc4fbb0a83019c4f27ad54f44395d7cd9700f886e9d6ca8515ee3360679eaec36ef8765fdac4fc72091cb41cb22fa890fc827833b60ab3d060d94f30625cb"
+    );
+    assert_ne!(derived, old_scheme());
+    assert_ne!(derived, scheme(b"misaka-palw/tiled-logits/scheme/v1", b"tiled-logits-i64-q24-v2"));
+    let unframed =
+        blake2b_simd::Params::new().hash_length(64).key(b"misaka-palw/tiled-logits/scheme/v2").hash(b"tiled-logits-i64-q24-v2");
+    assert_ne!(&derived[..], unframed.as_bytes());
+}
+
+#[test]
+fn only_the_final_post_i64_logits_round_trip_and_keep_wide_values() {
+    let (program, params) = wide_fixture();
+    validate(&program).unwrap();
+    let bytes = program.encode();
+    assert_eq!(TirProgramV1::decode_canonical(&bytes).unwrap(), program);
+    assert_eq!(program.encode(), bytes);
+    for (block, value) in program.blocks.iter().enumerate() {
+        for node in 0..value.nodes.len() {
+            assert_eq!(
+                program.is_wide_logits_node(block, node),
+                block == program.schedule.post as usize && node == program.logits as usize
+            );
+        }
+    }
+    let outputs = Interpreter::new(&program).unwrap().run(&params, &[0, 1]).unwrap();
+    for output in outputs {
+        assert_eq!(output.logits.dtype, DType::I64);
+        assert_eq!(output.logits.data, vec![3i128 << 40; 2]);
+        assert!(output.logits.data.iter().all(|v| *v > i32::MAX as i128));
+    }
+}
+
+#[test]
+fn i64_logits_under_the_old_scheme_remain_rejected() {
+    let (mut program, _) = wide_fixture();
+    program.logits_scheme_id = old_scheme();
+    assert!(!program.wide_logits_q24());
+    reject(&program, "the logits node is a committed, committable tensor");
+}
+
+#[test]
+fn wide_scheme_requires_i64_and_a_committed_final_post_node() {
+    let (program, _) = wide_fixture();
+    for dtype in [DType::I32, DType::I128, DType::Idx] {
+        let mut bad = program.clone();
+        bad.blocks[bad.schedule.post as usize].nodes[bad.logits as usize].out.dtype = dtype;
+        reject(&bad, "wide Q24 requires an i64 final post logits node");
+    }
+    let mut uncommitted = program.clone();
+    uncommitted.blocks[uncommitted.schedule.post as usize].nodes[uncommitted.logits as usize].commit = false;
+    reject(&uncommitted, "the logits node is a committed");
+    let mut nonfinal = program;
+    let post = &mut nonfinal.blocks[nonfinal.schedule.post as usize];
+    let output = post.nodes[nonfinal.logits as usize].out.clone();
+    post.nodes.push(Node { prim: Prim::Reshape, inputs: vec![Ref::Node(nonfinal.logits)], out: output, commit: true });
+    reject(&nonfinal, "wide Q24 requires an i64 final post logits node");
+}
+
+#[test]
+fn extra_i64_commit_points_in_post_or_other_blocks_remain_rejected() {
+    let (program, _) = wide_fixture();
+    let mut post_intermediate = program.clone();
+    post_intermediate.blocks[post_intermediate.schedule.post as usize].nodes[0].commit = true;
+    reject(&post_intermediate, "a commit point is i8, i16, i32 or idx");
+    let mut other = program;
+    let pre = &mut other.blocks[other.schedule.pre as usize];
+    let mut output = pre.nodes[0].out.clone();
+    output.dtype = DType::I64;
+    pre.nodes.push(Node { prim: Prim::Cast, inputs: vec![Ref::Node(0)], out: output, commit: true });
+    reject(&other, "a commit point is i8, i16, i32 or idx");
+}
+
+#[test]
+fn wide_scheme_does_not_relax_carry_or_state_dtypes() {
+    let (mut carry, _) = wide_fixture();
+    carry.blocks[carry.schedule.pre as usize].nodes[0].out.dtype = DType::I64;
+    reject(&carry, "carried tensors are committable");
+    let mut pb = ProgramBuilder::new(4, HISTORY_BOUND_V1_SMALL);
+    let state = pb.fixed_state("state", DType::I32, &[1], -16, 16, true);
+    let mut program = common::admission::one_layer(pb, |b| {
+        b.state_write(state, Ref::CarryIn(0));
+    });
+    let post = &mut program.blocks[program.schedule.post as usize];
+    let mut output = post.nodes[program.logits as usize].out.clone();
+    output.dtype = DType::I64;
+    post.nodes.push(Node { prim: Prim::Cast, inputs: vec![Ref::Node(program.logits)], out: output, commit: true });
+    program.logits = (post.nodes.len() - 1) as u16;
+    program.logits_scheme_id = LOGITS_I64_Q24_SCHEME_V2;
+    validate(&program).unwrap();
+    program.states[state as usize].dtype = DType::I64;
+    reject(&program, "state 0 must be i8, i16 or i32");
+}
+
+#[test]
+fn the_old_i32_fixture_and_nonfinal_logits_keep_their_canonical_bytes() {
+    let mut program = common::admission::one_layer(ProgramBuilder::new(4, HISTORY_BOUND_V1_SMALL), |_| {});
+    program.logits_scheme_id = old_scheme();
+    let post = &mut program.blocks[program.schedule.post as usize];
+    let output = post.nodes[program.logits as usize].out.clone();
+    post.nodes.push(Node { prim: Prim::Reshape, inputs: vec![Ref::Node(program.logits)], out: output, commit: true });
+    assert!(!program.wide_logits_q24());
+    validate(&program).unwrap();
+    let bytes = program.encode();
+    assert_eq!(TirProgramV1::decode_canonical(&bytes).unwrap().encode(), bytes);
+}
