{
  "format": "misaka.palw.model-adapter.v1",
  "id": "minimax-m2",
  "doc": "MiniMax-M2: Mixtral-named experts (block_sparse_moe.experts.{E}.w1/w2/w3) on EVERY layer, a sigmoid router whose top-k is chosen on sigmoid + e_score_correction_bias and whose weights are the unbiased sigmoids renormalised by their sum, and an RMS q/k norm over the whole projection (OLMo-2 style). Third-party adapter (lane H): data only.",
  "extends": ["decoder-core"],
  "match": {"architectures": ["MiniMaxM2ForCausalLM"], "model_types": ["minimax_m2"]},
  "config": {
    "defaults": {"vocab_size": 200064, "hidden_size": 3072, "intermediate_size": 1536, "num_hidden_layers": 62, "num_attention_heads": 48, "num_key_value_heads": 8, "head_dim": 128, "max_position_embeddings": 196608, "rms_norm_eps": 1e-06, "tie_word_embeddings": false, "num_experts_per_tok": 8, "num_local_experts": 256},
    "inert": ["output_router_logits", "router_aux_loss_coef", "router_jitter_noise"]
  },
  "vars": [
    {"name": "e", "value": {"$alias": [["num_local_experts", "num_experts"], 256]}},
    {"name": "k", "value": {"$cfg": "num_experts_per_tok"}},
    {"name": "topk_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "k"}, 0]}, {"$le": [{"$var": "k"}, {"$var": "e"}]}]}, "top-k out of range"]}},
    {"name": "qk_norm", "value": {"norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}, "scope": "Whole"}},
    {"name": "router", "value": {"scoring": "Sigmoid", "linear_bias": false, "selection_bias": true, "groups": null, "normalize": true, "norm_eps": 0.0, "scale": 1.0, "jitter_eps": 0.0, "per_expert_scale": false}},
    {"name": "l_ffn", "value": {"Moe": {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "inter"}, "act": {"$var": "act"}, "router": {"$var": "router"}, "shared": null}}, "layer": true},
    {"name": "names", "value": {"$merge": [{"$var": "names_base"}, {"moe.router": "{p}layers.{L}.block_sparse_moe.gate", "moe.sel_bias": "{p}layers.{L}.block_sparse_moe.e_score_correction_bias", "moe.gate": "{p}layers.{L}.block_sparse_moe.experts.{E}.w1", "moe.up": "{p}layers.{L}.block_sparse_moe.experts.{E}.w3", "moe.down": "{p}layers.{L}.block_sparse_moe.experts.{E}.w2"}]}},
    {"name": "families", "value": ["C3", "C8"]},
    {"name": "model_type", "value": "minimax_m2"}
  ]
}
