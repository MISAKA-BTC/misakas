{
  "format": "misaka.palw.model-adapter.v1",
  "id": "albert",
  "doc": "ALBERT (AlbertModel): BERT's post-LN encoder whose ONE layer (albert_layer_groups.0.albert_layers.0, num_hidden_groups = inner_group_num = 1) is shared by every depth (a tensor name without `{L}` serves all layers), over a FACTORISED embedding: word + position + token-type rows of embedding_size, a LayerNorm over embedding_size, then embedding_hidden_mapping_in (a biased Linear to hidden_size). Third-party adapter (lane H).",
  "extends": ["mixin-bert-encoder"],
  "match": {"architectures": ["AlbertModel"], "model_types": ["albert"]},
  "config": {"defaults": {"vocab_size": 30000, "embedding_size": 128, "hidden_size": 4096, "num_hidden_layers": 12, "num_hidden_groups": 1, "num_attention_heads": 64, "intermediate_size": 16384, "inner_group_num": 1, "hidden_act": "gelu_new", "max_position_embeddings": 512, "type_vocab_size": 2, "layer_norm_eps": 1e-12, "pad_token_id": 0}, "inert": ["classifier_dropout_prob", "attention_probs_dropout_prob", "hidden_dropout_prob"]},
  "vars": [
    {"name": "groups_ok", "value": {"$check": [{"$and": [{"$eq": [{"$cfg": "num_hidden_groups"}, 1]}, {"$eq": [{"$cfg": "inner_group_num"}, 1]}]}, "ALBERT with several layer groups is not modelled"]}},
    {"name": "vocab", "value": {"$cfg": "vocab_size"}},
    {"name": "hidden", "value": {"$cfg": "hidden_size"}},
    {"name": "emb", "value": {"$cfg": "embedding_size"}},
    {"name": "inter", "value": {"$cfg": "intermediate_size"}},
    {"name": "n", "value": {"$cfg": "num_hidden_layers"}},
    {"name": "heads", "value": {"$cfg": "num_attention_heads"}},
    {"name": "max_pos0", "value": {"$cfg": "max_position_embeddings"}},
    {"name": "type_rows", "value": {"$cfg": "type_vocab_size"}},
    {"name": "act", "value": {"$act": {"$cfg": "hidden_act"}}},
    {"name": "eps", "value": {"$cfg": "layer_norm_eps"}},
    {"name": "pad", "value": {"$cfg": "pad_token_id"}},
    {"name": "offset", "value": 0},
    {"name": "embedding", "value": {"dim": {"$var": "emb"}, "scale": 1.0, "positions": {"rows": {"$var": "max_pos0"}, "offset": 0}, "norm": {"$var": "norm"}, "type_rows": {"$var": "type_rows"}, "rel_bias": null, "proj_in": true}},
    {"name": "names", "value": {"embed": "embeddings.word_embeddings", "pos_embed": "embeddings.position_embeddings", "type_embed": "embeddings.token_type_embeddings", "embed_norm": "embeddings.LayerNorm", "proj_in": "encoder.embedding_hidden_mapping_in", "attn.q": "encoder.albert_layer_groups.0.albert_layers.0.attention.query", "attn.k": "encoder.albert_layer_groups.0.albert_layers.0.attention.key", "attn.v": "encoder.albert_layer_groups.0.albert_layers.0.attention.value", "attn.o": "encoder.albert_layer_groups.0.albert_layers.0.attention.dense", "norm.mix": "encoder.albert_layer_groups.0.albert_layers.0.attention.LayerNorm", "mlp.up": "encoder.albert_layer_groups.0.albert_layers.0.ffn", "mlp.down": "encoder.albert_layer_groups.0.albert_layers.0.ffn_output", "norm.ffn": "encoder.albert_layer_groups.0.albert_layers.0.full_layer_layer_norm"}},
    {"name": "model_type", "value": "albert"}
  ]
}
