{
  "format": "misaka.palw.model-adapter.v1",
  "id": "hy_v3",
  "doc": "Hy3 / HunYuan-V3 (Tencent): a Llama-shaped decoder with a per-head shared q/k RMS norm before the rotation, the dense/sparse pattern per layer in mlp_layer_types, and a DeepSeek-style sigmoid router without groups (top-k chosen on sigmoid + expert_bias, weights the unbiased sigmoids renormalised by their sum + 1e-20, times router_scaling_factor) with a shared expert; the hub names are mlp.router.gate, mlp.expert_bias and mlp.shared_mlp. enable_moe_fp32_combine only picks the dtype of the final add. Third-party adapter (lane H): data only.",
  "extends": ["decoder-core"],
  "match": {"architectures": ["HYV3ForCausalLM"], "model_types": ["hy_v3"]},
  "config": {
    "defaults": {"num_experts": 192, "num_experts_per_tok": 8, "num_shared_experts": 1, "moe_intermediate_size": 1536, "router_scaling_factor": 2.826, "tie_word_embeddings": false, "attention_bias": false, "mlp_bias": false},
    "inert": ["enable_moe_fp32_combine", "output_router_logits"]
  },
  "vars": [
    {"name": "e", "value": {"$alias": [["num_experts", "num_local_experts"], 192]}},
    {"name": "k", "value": {"$cfg": "num_experts_per_tok"}},
    {"name": "topk_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "k"}, 0]}, {"$le": [{"$var": "k"}, {"$var": "e"}]}]}, "top-k out of range"]}},
    {"name": "moe_inter", "value": {"$cfg": "moe_intermediate_size"}},
    {"name": "n_shared", "value": {"$cfg": "num_shared_experts"}},
    {"name": "rsf", "value": {"$cfg": "router_scaling_factor"}},
    {"name": "mlt", "value": {"$cfg?": "mlp_layer_types"}},
    {"name": "qk_norm", "value": {"norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}, "scope": "PerHeadShared"}},
    {"name": "router", "value": {"scoring": "Sigmoid", "linear_bias": false, "selection_bias": true, "groups": null, "normalize": true, "norm_eps": 1e-20, "scale": {"$var": "rsf"}, "jitter_eps": 0.0, "per_expert_scale": false}},
    {"name": "shared", "value": {"$if": [{"$gt": [{"$var": "n_shared"}, 0]}, {"intermediate": {"$mul": [{"$var": "moe_inter"}, {"$var": "n_shared"}]}, "sigmoid_gate": false}, null]}},
    {"name": "sparse_here", "layer": true, "value": {"$if": [{"$ne": [{"$var": "mlt"}, null]}, {"$eq": [{"$index": [{"$var": "mlt"}, {"$var": "i"}]}, "sparse"]}, {"$ge": [{"$var": "i"}, 1]}]}},
    {"name": "l_ffn", "layer": true, "value": {"$if": [{"$var": "sparse_here"}, {"Moe": {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "moe_inter"}, "act": {"$var": "act"}, "router": {"$var": "router"}, "shared": {"$var": "shared"}}}, {"Mlp": {"intermediate": {"$var": "inter"}, "act": {"$var": "act"}, "gated": true, "up_bias": {"$var": "mbias"}, "down_bias": {"$var": "mbias"}}}]}},
    {"name": "names", "value": {"$merge": [{"$var": "names_base"}, {"moe.router": "{p}layers.{L}.mlp.router.gate", "moe.sel_bias": "{p}layers.{L}.mlp.expert_bias", "moe.gate": "{p}layers.{L}.mlp.experts.{E}.gate_proj", "moe.up": "{p}layers.{L}.mlp.experts.{E}.up_proj", "moe.down": "{p}layers.{L}.mlp.experts.{E}.down_proj", "moe.shared.gate": "{p}layers.{L}.mlp.shared_mlp.gate_proj", "moe.shared.up": "{p}layers.{L}.mlp.shared_mlp.up_proj", "moe.shared.down": "{p}layers.{L}.mlp.shared_mlp.down_proj"}]}},
    {"name": "model_type", "value": "hy_v3"}
  ]
}
