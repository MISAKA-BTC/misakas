{
  "format": "misaka.palw.model-adapter.v1",
  "id": "glm",
  "doc": "GLM (glm-4-9b-chat-hf, GLM-Edge): Llama math with a fused gate_up_proj, q/k/v biases (attention_bias, default true; o_proj never), partial interleaved rotary (default 0.5).",
  "extends": ["decoder-core"],
  "match": {"architectures": ["GlmForCausalLM"], "model_types": ["glm"]},
  "config": {"defaults": {"vocab_size": 151552, "intermediate_size": 13696, "num_hidden_layers": 40, "num_key_value_heads": 2, "head_dim": 128, "max_position_embeddings": 131072, "rms_norm_eps": 1.5625e-07, "attention_bias": true}},
  "vars": [
    {"name": "partial", "value": {"$partial_rotary": {"legacy": ["partial_rotary_factor"], "default": 0.5}}},
    {"name": "rope_dim", "value": {"$floor": {"$mul": [{"$var": "hd"}, {"$var": "partial"}]}}},
    {"name": "rope_partial", "value": {"$var": "partial"}},
    {"name": "rope_style", "value": "Interleaved"},
    {"name": "qkv_bias", "value": {"$var": "abias"}},
    {"name": "o_bias", "value": false},
    {"name": "mbias", "value": false},
    {"name": "mlp_layout", "value": "FusedGateFirst"},
    {"name": "names", "value": {"$merge": [{"$omit": [{"$var": "names_base"}, ["mlp.gate", "mlp.up"]]}, {"mlp.gate_up": "{p}layers.{L}.mlp.gate_up_proj"}]}},
    {"name": "families", "value": ["C1"]},
    {"name": "model_type", "value": "glm"}
  ]
}
