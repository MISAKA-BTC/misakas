{
  "format": "misaka.palw.model-adapter.v1",
  "id": "qwen2",
  "doc": "Qwen2 / Qwen2.5 (and the checkpoints that ship as Qwen2: QwQ, DeepSeek-R1-Distill-Qwen, ...): q/k/v biases, no o/MLP bias, an optional sliding window from max_window_layers on.",
  "extends": ["decoder-core", "mixin-qwen-sliding"],
  "match": {"architectures": ["Qwen2ForCausalLM"], "model_types": ["qwen2"]},
  "config": {
    "defaults": {"vocab_size": 151936, "intermediate_size": 22016, "num_key_value_heads": 32, "max_position_embeddings": 32768}
  },
  "vars": [
    {"name": "no_mrope", "value": {"$forbid": ["use_mrope", "multimodal rope positions are not a text decoder's"]}},
    {"name": "abias", "value": false},
    {"name": "qkv_bias", "value": true},
    {"name": "o_bias", "value": false},
    {"name": "mbias", "value": false},
    {"name": "model_type", "value": "qwen2"}
  ]
}
