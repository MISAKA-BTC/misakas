{
  "format": "misaka.palw.model-adapter.v1",
  "id": "deepseek-v4",
  "doc": "DeepSeek-V4's text decoder (hub names): hc_mult residual streams under manifold-constrained hyper-connections (a per-site mixing of the streams, `pre`/`post`/`comb` with a Sinkhorn-projected `comb`, a final collapse), shared-KV multi-query attention (one key/value head that is also the value, a low-rank query with a weightless per-head norm, the output's rope slice rotated back, the output through block-diagonal low-rank groups, a learned sink per head, a sliding window), compressed entries per layer type (`compressed_sparse_attention`: windows of compress_rates[csa] pooled with the previous window's first series and a lightning indexer that keeps the top index_topk entries; `heavily_compressed_attention`: non-overlapping windows of compress_rates[hca], all entries), sliding-only layers with the main rope, and a MoE per layer with a sqrt-softplus router (`hash_moe` layers pick their experts by the frozen tid2eid table), a shared expert and the swiglu limit. scoring_func must be `sqrtsoftplus`; norm_topk_prob and n_shared_experts are never read by transformers; the training-only router keys are inert.",
  "extends": [
    "decoder-core"
  ],
  "match": {
    "architectures": [
      "DeepseekV4ForCausalLM"
    ],
    "model_types": [
      "deepseek_v4"
    ]
  },
  "config": {
    "defaults": {
      "vocab_size": 129280,
      "hidden_size": 4096,
      "num_hidden_layers": 43,
      "num_attention_heads": 64,
      "num_key_value_heads": 1,
      "head_dim": 512,
      "max_position_embeddings": 1048576,
      "hidden_act": "silu",
      "tie_word_embeddings": false,
      "moe_intermediate_size": 2048,
      "q_lora_rank": 1024,
      "num_experts_per_tok": 6,
      "n_routed_experts": 256,
      "scoring_func": "sqrtsoftplus",
      "routed_scaling_factor": 1.5,
      "compress_rope_theta": 160000.0,
      "hc_mult": 4,
      "hc_sinkhorn_iters": 20,
      "hc_eps": 1e-06,
      "swiglu_limit": 10.0,
      "sliding_window": 128,
      "o_groups": 8,
      "o_lora_rank": 1024,
      "index_n_heads": 64,
      "index_head_dim": 128,
      "index_topk": 512
    },
    "inert": [
      "norm_topk_prob",
      "n_shared_experts",
      "num_nextn_predict_layers",
      "output_router_logits",
      "router_aux_loss_coef",
      "router_jitter_noise",
      "rope_theta",
      "compress_rope_theta"
    ]
  },
  "spec": {
    "mhc": {
      "streams": {
        "$var": "hc_mult"
      },
      "iters": {
        "$var": "hc_iters"
      },
      "eps": {
        "$var": "hc_eps"
      },
      "norm_eps": {
        "$var": "eps"
      }
    }
  },
  "vars": [
    {"name": "rope_keyed", "value": {"$check": [{"$has": "rope_parameters"}, "rope_parameters keyed by main/compress is required (transformers 5 folds the legacy rope keys into it)"]}},
    {"name": "scoring_ok", "value": {"$check": [{"$eq": [{"$cfg": "scoring_func"}, "sqrtsoftplus"]}, "scoring_func is not sqrtsoftplus"]}},
    {"name": "one_kv", "value": {"$check": [{"$eq": [{"$var": "kv"}, 1]}, "V4 attention has one key/value head"]}},
    {"name": "act", "value": {"$act": {"$cfg": "hidden_act"}}},
    {"name": "hc_mult", "value": {"$cfg": "hc_mult"}},
    {"name": "hc_iters", "value": {"$cfg": "hc_sinkhorn_iters"}},
    {"name": "hc_eps", "value": {"$cfg": "hc_eps"}},
    {"name": "q_rank", "value": {"$cfg": "q_lora_rank"}},
    {"name": "o_groups", "value": {"$cfg": "o_groups"}},
    {"name": "o_rank", "value": {"$cfg": "o_lora_rank"}},
    {"name": "window", "value": {"$cfg": "sliding_window"}},
    {"name": "moe_inter", "value": {"$cfg": "moe_intermediate_size"}},
    {"name": "n_exp", "value": {"$cfg": "n_routed_experts"}},
    {"name": "topk", "value": {"$cfg": "num_experts_per_tok"}},
    {"name": "routed_scale", "value": {"$cfg": "routed_scaling_factor"}},
    {"name": "limit", "value": {"$cfg": "swiglu_limit"}},
    {"name": "ix_heads", "value": {"$cfg": "index_n_heads"}},
    {"name": "ix_dim", "value": {"$cfg": "index_head_dim"}},
    {"name": "ix_topk", "value": {"$cfg": "index_topk"}},
    {"name": "rd_cfg", "value": {"$cfg?": "qk_rope_head_dim"}},
    {"name": "prf_cfg", "value": {"$cfg?": "partial_rotary_factor"}},
    {"name": "rd_from_prf", "value": {"$int": {"$mul": [{"$var": "hd"}, {"$if": [{"$ne": [{"$var": "prf_cfg"}, null]}, {"$var": "prf_cfg"}, 0.125]}]}}},
    {"name": "rd_ok", "value": {"$or": [{"$eq": [{"$var": "rd_cfg"}, null]}, {"$check": [{"$or": [{"$eq": [{"$var": "prf_cfg"}, null]}, {"$eq": [{"$var": "rd_cfg"}, {"$var": "rd_from_prf"}]}]}, "qk_rope_head_dim and partial_rotary_factor disagree"]}]}},
    {"name": "rd", "value": {"$if": [{"$ne": [{"$var": "rd_cfg"}, null]}, {"$var": "rd_cfg"}, {"$var": "rd_from_prf"}]}},
    {"name": "prf", "value": {"$div": [{"$var": "rd"}, {"$var": "hd"}]}},
    {"name": "rates", "value": {"$cfg?": "compress_rates"}},
    {"name": "rate_csa", "value": {"$if": [{"$ne": [{"$var": "rates"}, null]}, {"$get": [{"$var": "rates"}, "compressed_sparse_attention"]}, 4]}},
    {"name": "rate_hca", "value": {"$if": [{"$ne": [{"$var": "rates"}, null]}, {"$get": [{"$var": "rates"}, "heavily_compressed_attention"]}, 128]}},
    {"name": "types", "value": {"$layer_types": {"n": {"$var": "n"}, "allowed": ["sliding_attention", "compressed_sparse_attention", "heavily_compressed_attention"], "each": {"$if": [{"$lt": [{"$var": "i"}, 2]}, "heavily_compressed_attention", {"$if": [{"$eq": [{"$mod": [{"$sub": [{"$var": "i"}, 2]}, 2]}, 1]}, "compressed_sparse_attention", "heavily_compressed_attention"]}]}}}},
    {"name": "mlp_types_cfg", "value": {"$cfg?": "mlp_layer_types"}},
    {"name": "kind", "value": {"$index": [{"$var": "types"}, {"$var": "i"}]}, "layer": true},
    {"name": "csa", "value": {"$eq": [{"$var": "kind"}, "compressed_sparse_attention"]}, "layer": true},
    {"name": "compressed", "value": {"$ne": [{"$var": "kind"}, "sliding_attention"]}, "layer": true},
    {"name": "ratio", "value": {"$if": [{"$var": "csa"}, {"$var": "rate_csa"}, {"$var": "rate_hca"}]}, "layer": true},
    {"name": "is_hash", "value": {"$if": [{"$ne": [{"$var": "mlp_types_cfg"}, null]}, {"$eq": [{"$index": [{"$var": "mlp_types_cfg"}, {"$var": "i"}]}, "hash_moe"]}, {"$lt": [{"$var": "i"}, 3]}]}, "layer": true},
    {"name": "rope", "value": null},
    {"name": "rope_i", "value": {"$rope": {"dim": {"$var": "rd"}, "style": "Interleaved", "layer_type": {"$if": [{"$var": "compressed"}, "compress", "main"]}, "offset": {"$sub": [{"$var": "hd"}, {"$var": "rd"}]}, "partial": {"$var": "prf"}, "max_pos": {"$var": "max_pos"}}}, "layer": true},
    {"name": "rope_back_i", "value": {"$rope": {"dim": {"$var": "rd"}, "style": "Interleaved", "layer_type": {"$if": [{"$var": "compressed"}, "compress", "main"]}, "offset": {"$sub": [{"$var": "hd"}, {"$var": "rd"}]}, "partial": {"$var": "prf"}, "max_pos": {"$var": "max_pos"}, "reverse": true}}, "layer": true},
    {"name": "rope_ix_i", "value": {"$rope": {"dim": {"$var": "rd"}, "style": "Interleaved", "layer_type": "compress", "offset": {"$sub": [{"$var": "ix_dim"}, {"$var": "rd"}]}, "partial": {"$var": "prf"}, "max_pos": {"$var": "max_pos"}}}, "layer": true},
    {"name": "l_mixer", "value": {"SharedKv": {"heads": {"$var": "heads"}, "head_dim": {"$var": "hd"}, "window": {"$var": "window"}, "scale": {"$div": [1.0, {"$sqrt": {"$var": "hd"}}]}, "q_rank": {"$var": "q_rank"}, "q_a_norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}, "q_b_norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "None", "bias": false}, "kv_norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}, "rope": {"$var": "rope_i"}, "rope_back": {"$var": "rope_back_i"}, "o_groups": {"$var": "o_groups"}, "o_rank": {"$var": "o_rank"}, "sinks": true, "compressed": {"$if": [{"$var": "compressed"}, {"ratio": {"$var": "ratio"}, "overlap": {"$var": "csa"}, "norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}, "rope": {"$var": "rope_i"}, "indexer": {"$if": [{"$var": "csa"}, {"heads": {"$var": "ix_heads"}, "head_dim": {"$var": "ix_dim"}, "topk": {"$var": "ix_topk"}, "norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}, "rope": {"$var": "rope_ix_i"}}, null]}}, null]}}}, "layer": true},
    {"name": "l_ffn", "value": {"Moe": {"experts": {"$var": "n_exp"}, "top_k": {"$var": "topk"}, "intermediate": {"$var": "moe_inter"}, "act": {"$var": "act"}, "glu": {"LimitedGlu": {"limit": {"$var": "limit"}}}, "expert_bias": false, "router": {"scoring": {"$if": [{"$var": "is_hash"}, "SqrtSoftplusHash", "SqrtSoftplus"]}, "linear_bias": false, "selection_bias": {"$not": {"$var": "is_hash"}}, "groups": null, "normalize": true, "norm_eps": 1e-20, "scale": {"$var": "routed_scale"}, "jitter_eps": 0.0, "per_expert_scale": false}, "shared": {"intermediate": {"$var": "moe_inter"}, "sigmoid_gate": false}, "input_scaled": false}}, "layer": true},
    {"name": "l_residual", "value": {"Mhc": {"pre_mixer": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}, "pre_ffn": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}}}, "layer": true},
    {"name": "lm_head_name", "value": "head"},
    {"name": "names", "value": {"$merge": [{"$var": "names_base"}, {"norm.mix": "{p}layers.{L}.attn_norm", "norm.ffn": "{p}layers.{L}.ffn_norm", "mhc.attn.fn": "{p}layers.{L}.hc_attn_fn", "mhc.attn.base": "{p}layers.{L}.hc_attn_base", "mhc.attn.scale": "{p}layers.{L}.hc_attn_scale", "mhc.ffn.fn": "{p}layers.{L}.hc_ffn_fn", "mhc.ffn.base": "{p}layers.{L}.hc_ffn_base", "mhc.ffn.scale": "{p}layers.{L}.hc_ffn_scale", "mhc.head.fn": "{p}hc_head.hc_fn", "mhc.head.base": "{p}hc_head.hc_base", "mhc.head.scale": "{p}hc_head.hc_scale", "attn.wq_a": "{p}layers.{L}.attn.wq_a", "attn.q_a_norm": "{p}layers.{L}.attn.q_norm", "attn.wq_b": "{p}layers.{L}.attn.wq_b", "attn.wkv": "{p}layers.{L}.attn.wkv", "attn.kv_norm": "{p}layers.{L}.attn.norm", "attn.sinks": "{p}layers.{L}.attn.attn_sink", "attn.wo_a": "{p}layers.{L}.attn.wo_a", "attn.wo_b": "{p}layers.{L}.attn.wo_b", "attn.idx.comp.wkv": "{p}layers.{L}.attn.indexer.compressor.wkv", "attn.idx.comp.wgate": "{p}layers.{L}.attn.indexer.compressor.wgate", "attn.idx.comp.ape": "{p}layers.{L}.attn.indexer.compressor.ape", "attn.idx.comp.norm": "{p}layers.{L}.attn.indexer.compressor.norm", "attn.idx.wq_b": "{p}layers.{L}.attn.indexer.wq_b", "attn.idx.weights_proj": "{p}layers.{L}.attn.indexer.weights_proj", "moe.router": "{p}layers.{L}.ffn.gate", "moe.sel_bias": "{p}layers.{L}.ffn.gate.bias", "moe.tid2eid": "{p}layers.{L}.ffn.gate.tid2eid", "moe.gate": "{p}layers.{L}.ffn.experts.{E}.w1", "moe.up": "{p}layers.{L}.ffn.experts.{E}.w3", "moe.down": "{p}layers.{L}.ffn.experts.{E}.w2", "moe.shared.gate": "{p}layers.{L}.ffn.shared_experts.w1", "moe.shared.up": "{p}layers.{L}.ffn.shared_experts.w3", "moe.shared.down": "{p}layers.{L}.ffn.shared_experts.w2", "attn.csa.wkv": "{p}layers.{L}.attn.compressor.wkv", "attn.hca.wkv": "{p}layers.{L}.attn.compressor.wkv", "attn.csa.wgate": "{p}layers.{L}.attn.compressor.wgate", "attn.hca.wgate": "{p}layers.{L}.attn.compressor.wgate", "attn.csa.ape": "{p}layers.{L}.attn.compressor.ape", "attn.hca.ape": "{p}layers.{L}.attn.compressor.ape", "attn.csa.norm": "{p}layers.{L}.attn.compressor.norm", "attn.hca.norm": "{p}layers.{L}.attn.compressor.norm"}]}},
    {"name": "families", "value": ["C1", "C2"]},
    {"name": "model_type", "value": "deepseek_v4"}
  ]
}
