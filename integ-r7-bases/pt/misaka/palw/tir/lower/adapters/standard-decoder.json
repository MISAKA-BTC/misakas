{
  "format": "misaka.palw.model-adapter.v1",
  "id": "standard-decoder",
  "doc": "The Level A reader: the strict decoder core plus the features the STANDARD Hugging Face keys and tensor names select — sliding window (sliding_window, use_sliding_window, max_window_layers, layer_types), partial rotary (partial_rotary_factor, rope_parameters), biases and a q/k norm (read from the tensor names; assumed absent from a config alone), Granite-style multipliers, query_pre_attn_scalar and the two soft-caps. It is applied to a `…ForCausalLM` class that no adapter claims; a family whose class departs from this reading has an adapter. A key it does not read is refused, never ignored.",
  "extends": ["decoder-core"],
  "vars": [
    {"name": "layer0", "value": {"$cat": [{"$var": "p"}, "layers.0."]}},
    {"name": "qkv_bias", "value": {"$tensor_flag": [{"$cat": [{"$var": "layer0"}, "self_attn.q_proj.bias"]}, {"$var": "abias"}]}},
    {"name": "o_bias", "value": {"$tensor_flag": [{"$cat": [{"$var": "layer0"}, "self_attn.o_proj.bias"]}, {"$var": "abias"}]}},
    {"name": "mbias", "value": {"$let": ["m", {"$cfg": "mlp_bias"}, {"$tensor_flag": [{"$cat": [{"$var": "layer0"}, "mlp.up_proj.bias"]}, {"$var": "m"}]}]}},
    {"name": "qkn_present", "value": {"$tensor_flag": [{"$cat": [{"$var": "layer0"}, "self_attn.q_norm.weight"]}, false]}},
    {"name": "qkn_shape", "value": {"$tensor_shape": {"$cat": [{"$var": "layer0"}, "self_attn.q_norm.weight"]}}},
    {"name": "qk_norm", "value": {"$if": [{"$var": "qkn_present"}, {"norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}, "scope": {"$if": [{"$or": [{"$eq": [{"$var": "qkn_shape"}, null]}, {"$eq": [{"$index": [{"$var": "qkn_shape"}, 0]}, {"$var": "hd"}]}]}, "PerHeadShared", {"$if": [{"$eq": [{"$index": [{"$var": "qkn_shape"}, 0]}, {"$mul": [{"$var": "heads"}, {"$var": "hd"}]}]}, "Whole", "PerHeadSeparate"]}]}}, null]}},
    {"name": "sw_cfg", "value": {"$cfgn": "sliding_window"}},
    {"name": "use_sw", "value": {"$cfg?": "use_sliding_window"}},
    {"name": "mwl", "value": {"$cfg?": "max_window_layers"}},
    {"name": "sw_on", "value": {"$and": [{"$ne": [{"$var": "sw_cfg"}, null]}, {"$ne": [{"$var": "use_sw"}, false]}]}},
    {"name": "sw", "value": {"$if": [{"$var": "sw_on"}, {"$var": "sw_cfg"}, null]}},
    {"name": "mwl_v", "value": {"$if": [{"$ne": [{"$var": "mwl"}, null]}, {"$var": "mwl"}, 0]}},
    {"name": "types", "value": {"$layer_types": {"n": {"$var": "n"}, "allowed": ["full_attention", "sliding_attention"], "each": {"$if": [{"$and": [{"$var": "sw_on"}, {"$ge": [{"$var": "i"}, {"$var": "mwl_v"}]}]}, "sliding_attention", "full_attention"]}}}},
    {"name": "partial", "value": {"$partial_rotary": {"legacy": ["partial_rotary_factor"], "default": 1.0}}},
    {"name": "rope_dim", "value": {"$floor": {"$mul": [{"$var": "hd"}, {"$var": "partial"}]}}},
    {"name": "rope_partial", "value": {"$var": "partial"}},
    {"name": "emb_mult", "value": {"$cfg?": "embedding_multiplier"}},
    {"name": "emb_scale", "value": {"$if": [{"$ne": [{"$var": "emb_mult"}, null]}, {"$var": "emb_mult"}, 1.0]}},
    {"name": "res_m", "value": {"$cfg?": "residual_multiplier"}},
    {"name": "res_mult", "value": {"$if": [{"$ne": [{"$var": "res_m"}, null]}, {"$var": "res_m"}, 1.0]}},
    {"name": "attn_mult", "value": {"$cfg?": "attention_multiplier"}},
    {"name": "qpas", "value": {"$cfg?": "query_pre_attn_scalar"}},
    {"name": "attn_scale", "value": {"$if": [{"$ne": [{"$var": "attn_mult"}, null]}, {"$var": "attn_mult"}, {"$if": [{"$ne": [{"$var": "qpas"}, null]}, {"$div": [1.0, {"$sqrt": {"$var": "qpas"}}]}, {"$div": [1.0, {"$sqrt": {"$var": "hd"}}]}]}]}},
    {"name": "logits_div", "value": {"$cfg?": "logits_scaling"}},
    {"name": "logit_scale", "value": {"$if": [{"$ne": [{"$var": "logits_div"}, null]}, {"$div": [1.0, {"$var": "logits_div"}]}, 1.0]}},
    {"name": "attn_cap", "value": {"$cfg?": "attn_logit_softcapping"}},
    {"name": "final_cap", "value": {"$cfg?": "final_logit_softcapping"}},
    {"name": "attn_extra", "value": {"$if": [{"$ne": [{"$var": "attn_cap"}, null]}, {"softcap": {"$var": "attn_cap"}}, {}]}},
    {"name": "head", "value": {"tied": {"$var": "tied"}, "logit_scale": {"$var": "logit_scale"}, "pre_scale": 1.0, "softcap": {"$var": "final_cap"}}},
    {"name": "no_rope", "value": {"$cfg?": "no_rope_layers"}},
    {"name": "l_position", "value": {"$if": [{"$and": [{"$ne": [{"$var": "no_rope"}, null]}, {"$eq": [{"$index": [{"$var": "no_rope"}, {"$var": "i"}]}, 0]}]}, "None", {"Rope": {"$var": "rope"}}]}, "layer": true},
    {"name": "families", "value": {"$if": [{"$ne": [{"$var": "sw"}, null]}, ["C1", "C2"], ["C1"]]}},
    {"name": "mt", "value": {"$cfg?": "model_type"}},
    {"name": "model_type", "value": {"$if": [{"$ne": [{"$var": "mt"}, null]}, {"$var": "mt"}, "decoder"]}}
  ]
}
