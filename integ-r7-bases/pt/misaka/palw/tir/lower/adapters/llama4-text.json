{
  "format": "misaka.palw.model-adapter.v1",
  "id": "llama4-text",
  "doc": "Llama-4's text decoder: rope layers rotate interleaved pairs (llama3 scaling) and run chunked attention with a weightless L2 QK-norm; NoPE layers (every no_rope_layer_interval-th) attend to every key with a query temperature; MoE layers (moe_layers, else every interleave_moe_layer_step-th) take the top-k of the router logits, each selected expert reading sigmoid(logit)*x, summed with a shared expert; experts stored [E, in, out].",
  "extends": ["decoder-core"],
  "match": {"architectures": ["Llama4ForCausalLM"], "model_types": ["llama4_text"]},
  "config": {"defaults": {"vocab_size": 202048, "hidden_size": 5120, "intermediate_size": 8192, "num_hidden_layers": 48, "num_attention_heads": 40, "num_key_value_heads": 8, "head_dim": 128, "max_position_embeddings": 131072, "rms_norm_eps": 1e-05, "intermediate_size_mlp": 16384, "num_local_experts": 16, "num_experts_per_tok": 1, "use_qk_norm": true, "attn_temperature_tuning": true, "floor_scale": 8192, "attn_scale": 0.1, "attention_chunk_size": 8192, "no_rope_layer_interval": 4, "interleave_moe_layer_step": 1}, "inert": ["router_jitter_noise", "router_aux_loss_coef", "output_router_logits"]},
  "vars": [
    {"name": "inter_mlp", "value": {"$cfg": "intermediate_size_mlp"}},
    {"name": "e", "value": {"$cfg": "num_local_experts"}},
    {"name": "k", "value": {"$cfg": "num_experts_per_tok"}},
    {"name": "topk_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "k"}, 0]}, {"$le": [{"$var": "k"}, {"$var": "e"}]}]}, {"$cat": ["top-k ", {"$var": "k"}, " of ", {"$var": "e"}, " experts"]}]}},
    {"name": "qk_on", "value": {"$cfg": "use_qk_norm"}},
    {"name": "tune", "value": {"$cfg": "attn_temperature_tuning"}},
    {"name": "floor", "value": {"$cfg": "floor_scale"}},
    {"name": "attn_scale_t", "value": {"$cfg": "attn_scale"}},
    {"name": "floor_ok", "value": {"$bad": [{"$ne": [{"$var": "floor"}, 0]}, "floor_scale 0"]}},
    {"name": "chunk", "value": {"$cfgn": "attention_chunk_size"}},
    {"name": "interval", "value": {"$cfg": "no_rope_layer_interval"}},
    {"name": "nrl", "value": {"$cfg?": "no_rope_layers"}},
    {"name": "nrl_ok", "value": {"$bad": [{"$or": [{"$eq": [{"$var": "nrl"}, null]}, {"$eq": [{"$len": {"$var": "nrl"}}, 0]}, {"$eq": [{"$len": {"$var": "nrl"}}, {"$var": "n"}]}]}, "no_rope_layers has the wrong number of entries"]}},
    {"name": "use_rope", "value": {"$if": [{"$and": [{"$ne": [{"$var": "nrl"}, null]}, {"$gt": [{"$len": {"$var": "nrl"}}, 0]}]}, {"$map": [{"$var": "nrl"}, "v", {"$ne": [{"$var": "v"}, 0]}]}, {"$map": [{"$range": {"$var": "n"}}, "i", {"$or": [{"$eq": [{"$var": "interval"}, 0]}, {"$ne": [{"$mod": [{"$add": [{"$var": "i"}, 1]}, {"$max": [{"$var": "interval"}, 1]}]}, 0]}]}]}]}},
    {"name": "types", "value": {"$layer_types": {"n": {"$var": "n"}, "allowed": ["chunked_attention", "full_attention"], "each": {"$if": [{"$index": [{"$var": "use_rope"}, {"$var": "i"}]}, "chunked_attention", "full_attention"]}}}},
    {"name": "step", "value": {"$cfg": "interleave_moe_layer_step"}},
    {"name": "moe_list", "value": {"$cfg?": "moe_layers"}},
    {"name": "is_moe", "value": {"$if": [{"$ne": [{"$var": "moe_list"}, null]}, {"$contains": [{"$var": "moe_list"}, {"$var": "i"}]}, {"$and": [{"$ge": [{"$var": "i"}, {"$max": [{"$sub": [{"$var": "step"}, 1]}, 0]}]}, {"$eq": [{"$mod": [{"$sub": [{"$var": "i"}, {"$max": [{"$sub": [{"$var": "step"}, 1]}, 0]}]}, {"$max": [{"$var": "step"}, 1]}]}, 0]}]}]}, "layer": true},
    {"name": "rope_theta", "value": 500000.0},
    {"name": "rope_style", "value": "Interleaved"},
    {"name": "rope_att_ok", "value": {"$check": [{"$or": [{"$not": {"$var": "qk_on"}}, {"$eq": [{"$get": [{"$get": [{"$var": "rope"}, "freqs"]}, "attention_factor"]}, 1.0]}]}, "a QK-norm after a rope with an attention factor (the order matters then)"]}},
    {"name": "l2", "value": {"norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "None", "bias": false}, "scope": "PerHeadShared"}},
    {"name": "is_rope", "value": {"$index": [{"$var": "use_rope"}, {"$var": "i"}]}, "layer": true},
    {"name": "chunked", "value": {"$and": [{"$eq": [{"$index": [{"$var": "types"}, {"$var": "i"}]}, "chunked_attention"]}, {"$ne": [{"$var": "chunk"}, null]}]}, "layer": true},
    {"name": "l_mixer", "value": {"Attention": {"heads": {"$var": "heads"}, "kv_heads": {"$var": "kv"}, "head_dim": {"$var": "hd"}, "v_head_dim": {"$var": "hd"}, "q_bias": {"$var": "abias"}, "k_bias": {"$var": "abias"}, "v_bias": {"$var": "abias"}, "o_bias": {"$var": "abias"}, "qk_norm": {"$if": [{"$and": [{"$var": "is_rope"}, {"$var": "qk_on"}]}, {"$var": "l2"}, null]}, "position": {"$if": [{"$var": "is_rope"}, {"Rope": {"$var": "rope"}}, "None"]}, "scale": {"$var": "attn_scale"}, "window": {"$if": [{"$var": "chunked"}, {"$var": "chunk"}, null]}, "chunk": {"$if": [{"$var": "chunked"}, {"$var": "chunk"}, null]}, "q_temperature": {"$if": [{"$and": [{"$not": {"$var": "is_rope"}}, {"$var": "tune"}]}, {"floor": {"$var": "floor"}, "scale": {"$var": "attn_scale_t"}, "offset": 1}, null]}}}, "layer": true},
    {"name": "l_ffn", "value": {"$if": [{"$var": "is_moe"}, {"Moe": {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "inter"}, "act": {"$var": "act"}, "router": {"scoring": "TopKThenSigmoid", "normalize": false}, "shared": {"intermediate": {"$var": "inter"}, "sigmoid_gate": false}, "input_scaled": true}}, {"Mlp": {"intermediate": {"$var": "inter_mlp"}, "act": {"$var": "act"}, "gated": true}}]}, "layer": true},
    {"name": "experts_layout", "value": "FusedGateFirstInOut"},
    {"name": "names", "value": {"$merge": [{"$var": "names_base"}, {"mlp.gate": "{p}layers.{L}.feed_forward.gate_proj", "mlp.up": "{p}layers.{L}.feed_forward.up_proj", "mlp.down": "{p}layers.{L}.feed_forward.down_proj", "moe.router": "{p}layers.{L}.feed_forward.router", "moe.gate_up.stacked": "{p}layers.{L}.feed_forward.experts.gate_up_proj", "moe.down.stacked": "{p}layers.{L}.feed_forward.experts.down_proj", "moe.shared.gate": "{p}layers.{L}.feed_forward.shared_expert.gate_proj", "moe.shared.up": "{p}layers.{L}.feed_forward.shared_expert.up_proj", "moe.shared.down": "{p}layers.{L}.feed_forward.shared_expert.down_proj"}]}},
    {"name": "families", "value": ["C1", "C3", "C8"]},
    {"name": "model_type", "value": "llama4_text"}
  ]
}
