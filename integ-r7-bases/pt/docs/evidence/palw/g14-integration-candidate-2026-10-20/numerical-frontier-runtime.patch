+/// Numerical shared-material candidate, not a funded original/public shared
+/// court or T05. Native root admission is real here; fixture signatures use the
+/// existing exact-message test verifier, not real ML-DSA registration/transactions.
+#[test]
+fn numerical_frontier_preserves_all_children_and_native_fold_checks(){
+    use kaspa_consensus_core::palw_tir_dissect_v1::PalwTirNumericalFrontierV1;
+    use kaspa_consensus_core::palw_tir_court_v1::check_tir_dissect_bottom_v1;
+    use kaspa_consensus_core::palw_step_refute::PalwStepRefuteError;
+    let w=world();
+    let sum=w.site.folds.iter().position(|f|*f==PalwTirFoldV1::Sum).unwrap();
+    for arity in [2,4] {for forged in [false,true] {
+        let (root,x)=if forged {let (r,x,_)=lie_in(&w,sum).unwrap();(r,x)}else{
+            (build_tir_root_claim_v1(&w.honest.binding,w.leaf,&Store {f:&w.f,x:&w.honest},&RULES).unwrap(),w.honest.clone())
+        };
+        let (mut run,claim)=licensed(&w,&x);let sid=court_at_leaf(&mut run,claim,&x,w.leaf);
+        run.step(&[root_claimed(&run,sid,root,arity)]);
+        let initial=run.phase(&sid);let native_root=run.s.state_root();
+        let mut frontier=PalwTirNumericalFrontierV1::new(initial.clone()).unwrap();
+        assert_eq!(frontier.terminal_tiles(),12);assert_eq!(frontier.maximum_disclosures(),11);
+        assert!(frontier.project_unrooted_phase(&[0]).is_err(),"a child needs its actual parent disclosure");
+        assert!(frontier.project_unrooted_phase(&vec![0;initial.round_budget() as usize+1]).is_err());
+        let mut todo=vec![Vec::new()];let mut terminal=std::collections::BTreeSet::new();let mut faults=0;
+        while let Some(path)=todo.pop(){
+            let phase=frontier.project_unrooted_phase(&path).unwrap();
+            assert_eq!(phase.last_deadline_daa(),initial.last_deadline_daa(),"projection never invents an accepted move clock");
+            if let Some(range)=phase.terminal_range(){
+                assert!(terminal.insert(range));
+                let bottom=build_tir_dissect_bottom_v1(&x.binding,&phase,&Store {f:&w.f,x:&x},&RULES).unwrap();
+                match check_tir_dissect_bottom_v1(&phase,&bottom,w.leaf,&RULES){
+                    Ok(_)=>{assert!(forged);faults+=1;},Err(PalwStepRefuteError::NoFaultFound)=>{},Err(e)=>panic!("{e}"),
+                }
+                continue;
+            }
+            let (truth,pushed)=children_of(&w,&x,&phase);let msg=if forged {pushed}else{truth};
+            let before=frontier.clone();let mut bad=msg.clone();
+            let i=w.site.folds.iter().enumerate().find(|(i,f)|**f==PalwTirFoldV1::Sum && !phase.elements()[*i].is_empty()).unwrap().0;
+            bad.children[0].partials[i][0]+=1;
+            assert!(frontier.disclose(&path,&bad).is_err());assert_eq!(frontier,before);
+            let admitted=frontier.disclose(&path,&msg);
+            if admitted.is_err(){assert!(forged);assert_eq!(frontier,before);faults+=1;continue;}
+            assert!(admitted.unwrap());let saved=frontier.clone();
+            assert!(!frontier.disclose(&path,&msg).unwrap());assert_eq!(frontier,saved);
+            assert!(frontier.disclose(&path,&bad).is_err());assert_eq!(frontier,saved);
+            assert!(frontier.project_unrooted_phase(&[path.as_slice(),&[arity]].concat()).is_err());
+            // Explore the first child first; every other legal child remains
+            // available after it. No destructive global child choice exists.
+            for child in (0..msg.children.len()).rev(){let mut next=path.clone();next.push(child as u8);todo.push(next);}
+        }
+        if forged {assert!(faults>0);}else{
+            assert_eq!(faults,0);assert_eq!(terminal.len(),12);
+            assert_eq!(terminal.iter().map(|(lo,hi)|hi-lo).sum::<usize>(),24);
+        }
+        assert!(frontier.disclosed_count() as u64<=frontier.maximum_disclosures());
+        assert_eq!(run.s.state_root(),native_root);assert_eq!(run.phase(&sid),initial,"numerical projection cannot update native duty/state");
+    }}
+}
