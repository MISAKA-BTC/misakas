+mod tests {
+    use super::*;
+    fn h(n:u64)->Hash64 {Hash64::from_u64_word(n)}
+    fn rules()->NativeCourtRulesV1 {
+        let f=crate::palw_tir_public_claim_v1::palw_tir_public_frame_fixture_v1(None,1);
+        NativeCourtRulesV1 {network_domain:h(1),at:crate::palw_state_v2::PalwBlockContextV2 {
+            block:h(2),daa_score:1,blue_score:0,subsidy:0},court:f.rules.court,step_ladder:f.rules.maximum_leaves,
+            prompt_ids_merkle:false,held_regime:false,decode_close_convicts_only:false,fp_decode_from_daa:None,
+            cell_closure_from_daa:None,memory_routing_from_daa:None,tir_active:true,gen_active:false,task_heads_active:false,
+            improvement_active:false,constraint_active:false}
+    }
+    fn raw_parts(m:&NumericalManifestV1,bytes:&[u8])->Vec<NumericalPartV1> {
+        bytes.chunks(NUMERICAL_PART_BYTES_V1).enumerate().map(|(i,p)|NumericalPartV1 {version:1,
+            stream_id:m.id().unwrap(),offset:(i*NUMERICAL_PART_BYTES_V1) as u64,bytes:p.to_vec()}).collect()
+    }
+    #[test]
+    fn multipart_codec_preserves_inner_bytes_and_rejects_shape_before_nested_allocation() {
+        // Synthetic width/parser corpus only: no purported valid root, signature
+        // or adjudication. The native-fold fixture tests real signed evidence.
+        let r=rules();let control=Round {version:1,claim:h(3),leaf:7,root_id:h(4),path:vec![0;3],parent_id:h(5),
+            signer:PalwBondKeyV2(crate::tx::TransactionOutpoint::new(h(6),0)),
+            round:Box::new(crate::palw_tir_dissect_v1::PalwTirDissectRoundV1 {version:1,children:(0..2).map(|_|
+                crate::palw_tir_dissect_v1::PalwTirRangeClaimV1 {partials:vec![vec![0;1024]]}).collect()}),
+            signature:vec![0;crate::mldsa87_primitives::MLDSA87_SIGNATURE_LEN]};
+        let c=NumericalControlRefV1::Round(&control);let m=describe_numerical_v1(&c,h(7),&r).unwrap();
+        let mut parts=Vec::new();write_numerical_parts_v1(&c,&m,&r,|p| {
+            parts.push(borsh::from_slice::<NumericalPartV1>(&borsh::to_vec(&p)?)?);Ok(())
+        }).unwrap();
+        assert!(parts.len()>=3);
+        let raw=borsh::to_vec(&control).unwrap();
+        assert_eq!(parts,raw_parts(&m,&raw));
+        let DecodedNumericalV1::Round(decoded)=decode_numerical_v1(&m,&parts,h(7),&r).unwrap() else {panic!()};
+        assert_eq!(*decoded,control);
+        for kind in 0..5 {
+            let mut p=parts.clone();match kind {0=>p.swap(0,1),1=>{p.pop();},2=>p[1]=p[0].clone(),
+                3=>p[0].bytes[0]^=1,_=>p[0].bytes.pop().map(|_|()).unwrap()}
+            assert!(decode_numerical_v1(&m,&p,h(7),&r).is_err());
+        }
+        // Recomputed envelope hash is not a checked flag: the missing declared
+        // 4 GiB signature is refused by actual shape scanning before allocation.
+        let sig_at=raw.len()-crate::mldsa87_primitives::MLDSA87_SIGNATURE_LEN-4;
+        let mut malformed=raw[..sig_at].to_vec();malformed.extend(u32::MAX.to_le_bytes());
+        let mut bad=m.clone();bad.total_bytes=malformed.len() as u64;
+        bad.body_hash=Hash64::from_bytes(blake2b_simd::Params::new().hash_length(64).key(BODY_DOMAIN)
+            .hash(&malformed).as_bytes().try_into().unwrap());
+        assert!(matches!(decode_numerical_v1(&bad,&raw_parts(&bad,&malformed),h(7),&r),Err(TransportErrorV1::Resource(_))));
+    }
+    #[test]
+    fn fragment_and_manifest_codec_refuse_unbounded_lengths_and_versions() {
+        let mut prefix=borsh::to_vec(&(1u16,h(1),0u64)).unwrap();prefix.extend(u32::MAX.to_le_bytes());
+        assert!(NumericalPartV1::deserialize_reader(&mut prefix.as_slice()).is_err());
+        for v in [0u16,2,u16::MAX] {
+            assert!(NumericalPartV1::deserialize_reader(&mut v.to_le_bytes().as_slice()).is_err());
+            assert!(NumericalManifestV1::deserialize_reader(&mut v.to_le_bytes().as_slice()).is_err());
+        }
+        let p=NumericalPartV1 {version:1,stream_id:h(1),offset:0,bytes:vec![1;NUMERICAL_PART_BYTES_V1]};
+        let wire=borsh::to_vec(&p).unwrap();assert_eq!(borsh::from_slice::<NumericalPartV1>(&wire).unwrap(),p);
+        assert!(borsh::from_slice::<NumericalPartV1>(&wire[..wire.len()-1]).is_err());
+        let mut trailing=wire;trailing.push(0);assert!(borsh::from_slice::<NumericalPartV1>(&trailing).is_err());
+    }
