@@ -0,0 +1,257 @@
+//! Private numerical-control transport, separate from DATA stream/lifecycle tags.
+//! Complete bundles only: no consensus prefix ownership, paid ingress, restart,
+//! delivery/opportunity/default or financial authority. The inner producer/filer
+//! signature is authenticated by the unchanged typed fold after bounded decode.
+use crate::{Hash64, palw_state_v2::PalwBondKeyV2};
+use crate::palw_court_close_receipt_v1::NativeCourtRulesV1;
+use crate::palw_court_shared_tir_root_v1::SignedSharedTirRootV1 as Root;
+use crate::palw_court_shared_tir_round_v1::{SignedSharedTirRoundV1 as Round, SHARED_TIR_MAX_PATH_V1 as PATH};
+use crate::palw_court_shared_tir_bottom_v1::SignedSharedTirBottomV1 as Bottom;
+use crate::palw_native_resource_v1::{NativeCoverageV1, NativeRetainedV1, NativeWireScanV1,
+    preflight_native_value_v1, reserve_native_requests_v1};
+use borsh::{BorshDeserialize, BorshSerialize};
+use std::io::{self, Read, Write};
+pub const NUMERICAL_PART_BYTES_V1: usize = crate::palw_tir_public_owned_v1::PALW_TIR_PUBLIC_OWNED_PART_BYTES_V1;
+const BODY_DOMAIN: &[u8] = b"misaka-palw/numerical-body/v1";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, BorshSerialize, BorshDeserialize)]
+pub enum NumericalKindV1 { Root, Round, Bottom }
+#[derive(Clone, Debug, PartialEq, Eq, BorshSerialize)]
+pub struct NumericalManifestV1 {
+    pub version:u16, pub network:Hash64, pub scope:Hash64, pub claim:Hash64,
+    pub leaf:u64, pub kind:NumericalKindV1, pub total_bytes:u64, pub body_hash:Hash64,
+}
+impl BorshDeserialize for NumericalManifestV1 {
+    fn deserialize_reader<R:Read>(r:&mut R)->io::Result<Self> {
+        let version=u16::deserialize_reader(r)?;
+        if version!=1 {return Err(io::Error::other("numerical manifest version"));}
+        Ok(Self {version,network:Hash64::deserialize_reader(r)?,scope:Hash64::deserialize_reader(r)?,
+            claim:Hash64::deserialize_reader(r)?,leaf:u64::deserialize_reader(r)?,kind:NumericalKindV1::deserialize_reader(r)?,
+            total_bytes:u64::deserialize_reader(r)?,body_hash:Hash64::deserialize_reader(r)?})
+    }
+}
+impl NumericalManifestV1 {
+    pub fn id(&self)->Result<Hash64,TransportErrorV1> {
+        if self.version!=1 || self.total_bytes==0 {return Err(invalid("numerical manifest version/empty body"));}
+        crate::palw_court_shared_tir_stream_v1::stream_digest(b"misaka-palw/numerical-manifest/v1",self).map_err(invalid)
+    }
+}
+#[derive(Clone, Debug, PartialEq, Eq, BorshSerialize)]
+pub struct NumericalPartV1 { pub version:u16, pub stream_id:Hash64, pub offset:u64, pub bytes:Vec<u8> }
+impl BorshDeserialize for NumericalPartV1 {
+    fn deserialize_reader<R:Read>(r:&mut R)->io::Result<Self> {
+        let version=u16::deserialize_reader(r)?;
+        if version!=1 {return Err(io::Error::other("numerical part version"));}
+        let stream_id=Hash64::deserialize_reader(r)?;let offset=u64::deserialize_reader(r)?;
+        let bytes=crate::palw_public_binding_v1::read_bounded_bytes_v1(r,NUMERICAL_PART_BYTES_V1)?;
+        if bytes.is_empty() {return Err(io::Error::other("empty numerical part"));}
+        Ok(Self {version,stream_id,offset,bytes})
+    }
+}
+/// Borrowed sender callback; retaining/copying emitted fragments is the caller's
+/// separately admitted work. No complete body serialization buffer is created.
+#[derive(BorshSerialize)]
+pub struct NumericalPartRefV1<'a> { pub version:u16, pub stream_id:Hash64, pub offset:u64, pub bytes:&'a [u8] }
+pub enum NumericalControlRefV1<'a> { Root(&'a Root), Round(&'a Round), Bottom(&'a Bottom) }
+impl BorshSerialize for NumericalControlRefV1<'_> {
+    fn serialize<W:Write>(&self,w:&mut W)->io::Result<()> {match self {Self::Root(c)=>c.serialize(w),Self::Round(c)=>c.serialize(w),Self::Bottom(c)=>c.serialize(w)}}
+}
+impl NumericalControlRefV1<'_> {
+    fn header(&self)->(NumericalKindV1,Hash64,u64) {match self {
+        Self::Root(c)=>(NumericalKindV1::Root,c.claim,c.leaf),Self::Round(c)=>(NumericalKindV1::Round,c.claim,c.leaf),
+        Self::Bottom(c)=>(NumericalKindV1::Bottom,c.claim,c.leaf)}}
+}
+#[derive(Debug)]
+pub enum TransportErrorV1 { Resource(NativeCoverageV1), Invalid(String) }
+impl std::fmt::Display for TransportErrorV1 {
+    fn fmt(&self,f:&mut std::fmt::Formatter<'_>)->std::fmt::Result {match self {Self::Resource(e)=>e.fmt(f),Self::Invalid(e)=>f.write_str(e)}}
+}
+fn invalid(s:impl ToString)->TransportErrorV1 {TransportErrorV1::Invalid(s.to_string())}
+fn length<T:BorshSerialize>(value:&T)->Result<u64,TransportErrorV1> {borsh::object_length(value).map(|n|n as u64).map_err(invalid)}
+fn plus(a:u64,b:u64)->Result<u64,TransportErrorV1> {a.checked_add(b).ok_or_else(||invalid("numerical transport length overflow"))}
+/// Grammar ceilings only. Caller supplies actual native rules, not a wire
+/// policy. Full profile/admission and semantic signatures are separate checks.
+pub fn control_ceiling_v1(kind:NumericalKindV1,rules:&NativeCourtRulesV1)->Result<u64,TransportErrorV1> {
+    rules.check().map_err(invalid)?;
+    if !rules.tir_active || !crate::palw_attn_dissect::palw_attn_arity_is_legal_v1(rules.court.dissection_arity()) {
+        return Err(invalid("numerical transport needs native TIR/arity"));
+    }
+    let z=Hash64::default();let signer=PalwBondKeyV2(crate::tx::TransactionOutpoint::new(z,0));
+    let signature=crate::mldsa87_primitives::MLDSA87_SIGNATURE_LEN as u64;
+    match kind {
+        NumericalKindV1::Root=>plus(crate::palw_court_shared_tir_root_v1::shared_root_body_ceiling_v1().map_err(invalid)?,
+            plus(length(&(1u16,z,z,z,0u64,0u8,signer,(),Vec::<u8>::new()))?,signature)?),
+        NumericalKindV1::Round|NumericalKindV1::Bottom=>{
+            let body=if kind==NumericalKindV1::Round {
+                crate::palw_tir_dissect_v1::palw_tir_dissect_round_bytes_v1(rules.court.dissection_arity(),
+                    crate::palw_tir_dissect_v1::PALW_TIR_DISSECT_MAX_REDUCTIONS,
+                    crate::palw_tir_dissect_v1::PALW_TIR_DISSECT_MAX_VALUES as u64)
+            } else {rules.court.max_close_bytes().checked_sub(1).ok_or_else(||invalid("numerical bottom ceiling"))?};
+            plus(body,plus(plus(length(&(1u16,z,0u64,z,Vec::<u8>::new(),z,signer,(),Vec::<u8>::new()))?,signature)?,PATH as u64)?)
+        }
+    }
+}
+pub fn describe_numerical_v1(control:&NumericalControlRefV1<'_>,scope:Hash64,rules:&NativeCourtRulesV1)
+    ->Result<NumericalManifestV1,TransportErrorV1> {
+    let (kind,claim,leaf)=control.header();let total_bytes=length(control)?;
+    if total_bytes==0 || total_bytes>control_ceiling_v1(kind,rules)? {return Err(invalid("numerical body exceeds native grammar ceiling"));}
+    let body_hash=crate::palw_court_shared_tir_stream_v1::stream_digest(BODY_DOMAIN,control).map_err(invalid)?;
+    Ok(NumericalManifestV1 {version:1,network:rules.network_domain,scope,claim,leaf,kind,total_bytes,body_hash})
+}
+/// Emits canonical existing-size parts. A callback failure may already have
+/// emitted a prefix; emission is not consensus acceptance or a completion flag.
+pub fn write_numerical_parts_v1(control:&NumericalControlRefV1<'_>,m:&NumericalManifestV1,rules:&NativeCourtRulesV1,
+    mut emit:impl FnMut(NumericalPartRefV1<'_>)->io::Result<()>)->Result<(),TransportErrorV1> {
+    if m.network!=rules.network_domain || m.total_bytes>control_ceiling_v1(m.kind,rules)?
+        || control.header()!=(m.kind,m.claim,m.leaf) || length(control)?!=m.total_bytes {return Err(invalid("numerical sender manifest mismatch"));}
+    let id=m.id()?;
+    let _workspace=reserve_native_requests_v1((NUMERICAL_PART_BYTES_V1 as u64)*2+std::mem::size_of::<Vec<u8>>() as u64)
+        .map_err(TransportErrorV1::Resource)?;
+    struct Sink<'a,F> {id:Hash64,offset:u64,buffer:Vec<u8>,hash:blake2b_simd::State,emit:&'a mut F}
+    impl<F:FnMut(NumericalPartRefV1<'_>)->io::Result<()>> Sink<'_,F> {
+        fn send(&mut self)->io::Result<()> {
+            if self.buffer.is_empty(){return Ok(());}
+            (self.emit)(NumericalPartRefV1 {version:1,stream_id:self.id,offset:self.offset,bytes:&self.buffer})?;
+            self.offset=self.offset.checked_add(self.buffer.len() as u64).ok_or_else(||io::Error::other("numerical sender overflow"))?;
+            self.buffer.clear();Ok(())
+        }
+    }
+    impl<F:FnMut(NumericalPartRefV1<'_>)->io::Result<()>> Write for Sink<'_,F> {
+        fn write(&mut self,mut bytes:&[u8])->io::Result<usize> {
+            let n=bytes.len();self.hash.update(bytes);
+            while !bytes.is_empty(){let take=bytes.len().min(NUMERICAL_PART_BYTES_V1-self.buffer.len());
+                self.buffer.extend_from_slice(&bytes[..take]);bytes=&bytes[take..];
+                if self.buffer.len()==NUMERICAL_PART_BYTES_V1 {self.send()?;}}
+            Ok(n)
+        }
+        fn flush(&mut self)->io::Result<()> {Ok(())}
+    }
+    let mut sink=Sink {id,offset:0,buffer:Vec::with_capacity(NUMERICAL_PART_BYTES_V1),
+        hash:blake2b_simd::Params::new().hash_length(64).key(BODY_DOMAIN).to_state(),emit:&mut emit};
+    control.serialize(&mut sink).map_err(invalid)?;sink.send().map_err(invalid)?;
+    if sink.offset!=m.total_bytes || sink.hash.finalize().as_bytes()!=m.body_hash.as_byte_slice() {
+        return Err(invalid("numerical sender length/hash changed"));
+    }
+    Ok(())
+}
+struct PartsReader<'a> {parts:&'a [NumericalPartV1],part:usize,offset:usize}
+impl<'a> PartsReader<'a> {fn new(parts:&'a [NumericalPartV1])->Self {Self {parts,part:0,offset:0}}}
+impl Read for PartsReader<'_> {
+    fn read(&mut self,buf:&mut [u8])->io::Result<usize> {
+        if buf.is_empty() || self.part==self.parts.len(){return Ok(0);}
+        let bytes=&self.parts[self.part].bytes;let n=buf.len().min(bytes.len()-self.offset);
+        buf[..n].copy_from_slice(&bytes[self.offset..self.offset+n]);self.offset+=n;
+        if self.offset==bytes.len(){self.part+=1;self.offset=0;}
+        Ok(n)
+    }
+}
+pub(crate) enum DecodedNumericalV1 {Root(NativeRetainedV1<Root>),Round(NativeRetainedV1<Round>),Bottom(NativeRetainedV1<Bottom>)}
+fn decode_owned<T:NativeWireScanV1>(m:&NumericalManifestV1,parts:&[NumericalPartV1],
+    decode:impl FnOnce(&mut PartsReader<'_>)->io::Result<T>)->Result<NativeRetainedV1<T>,TransportErrorV1> {
+    // Always scan, even when logical resource enforcement is disabled. No
+    // nested allocation occurs until the full actual shape is known/reserved.
+    let shape=preflight_native_value_v1::<T>(PartsReader::new(parts),m.total_bytes).map_err(|e|
+        TransportErrorV1::Resource(NativeCoverageV1::unsupported::<T>("numerical control shape",&e.to_string())))?;
+    let requests=plus(shape.logical_requests_v1(),std::mem::size_of::<DecodedNumericalV1>() as u64)?;
+    let lease=reserve_native_requests_v1(requests).map_err(TransportErrorV1::Resource)?;
+    let mut reader=PartsReader::new(parts);let value=decode(&mut reader).map_err(invalid)?;
+    if reader.read(&mut [0u8;1]).map_err(invalid)?!=0 {return Err(invalid("numerical decoded trailing bytes"));}
+    Ok(NativeRetainedV1::from_owner_reserved_v1(value,lease))
+}
+fn version(r:&mut impl Read)->io::Result<u16> {let v=u16::deserialize_reader(r)?;if v!=1 {return Err(io::Error::other("numerical inner version"));}Ok(v)}
+/// Not a validity capability: the caller must run the native typed fold. This
+/// receiver allocates no joined body and no persistent incomplete-prefix row.
+pub(crate) fn decode_numerical_v1(m:&NumericalManifestV1,parts:&[NumericalPartV1],scope:Hash64,rules:&NativeCourtRulesV1)
+    ->Result<DecodedNumericalV1,TransportErrorV1> {
+    let id=m.id()?;
+    if m.network!=rules.network_domain || m.scope!=scope || m.total_bytes>control_ceiling_v1(m.kind,rules)?
+        || parts.len() as u64!=m.total_bytes.div_ceil(NUMERICAL_PART_BYTES_V1 as u64) {return Err(invalid("numerical receive scope/ceiling/count"));}
+    let mut accepted=0u64;let mut hash=blake2b_simd::Params::new().hash_length(64).key(BODY_DOMAIN).to_state();
+    for p in parts {
+        if p.version!=1 || p.stream_id!=id {return Err(invalid("numerical part stream/version"));}
+        accepted=crate::palw_court_shared_tir_stream_v1::check_shared_stream_part_v1(m.total_bytes,accepted,p.offset,p.bytes.len()).map_err(invalid)?;
+        hash.update(&p.bytes);
+    }
+    if accepted!=m.total_bytes || hash.finalize().as_bytes()!=m.body_hash.as_byte_slice(){return Err(invalid("numerical body hash/length"));}
+    use crate::palw_public_binding_v1::{read_bounded_bytes_v1 as bytes,read_signature_v1 as sig};
+    let decoded=match m.kind {
+        NumericalKindV1::Root=>DecodedNumericalV1::Root(decode_owned(m,parts,|r|Ok(Root {
+            version:version(r)?,claim:Hash64::deserialize_reader(r)?,scope_id:Hash64::deserialize_reader(r)?,policy_id:Hash64::deserialize_reader(r)?,
+            leaf:u64::deserialize_reader(r)?,arity:u8::deserialize_reader(r)?,signer:PalwBondKeyV2::deserialize_reader(r)?,
+            root:Box::deserialize_reader(r)?,signature:sig(r)?}))?),
+        NumericalKindV1::Round=>DecodedNumericalV1::Round(decode_owned(m,parts,|r|Ok(Round {
+            version:version(r)?,claim:Hash64::deserialize_reader(r)?,leaf:u64::deserialize_reader(r)?,root_id:Hash64::deserialize_reader(r)?,
+            path:bytes(r,PATH)?,parent_id:Hash64::deserialize_reader(r)?,signer:PalwBondKeyV2::deserialize_reader(r)?,
+            round:Box::deserialize_reader(r)?,signature:sig(r)?}))?),
+        NumericalKindV1::Bottom=>DecodedNumericalV1::Bottom(decode_owned(m,parts,|r|Ok(Bottom {
+            version:version(r)?,claim:Hash64::deserialize_reader(r)?,leaf:u64::deserialize_reader(r)?,root_id:Hash64::deserialize_reader(r)?,
+            path:bytes(r,PATH)?,parent_id:Hash64::deserialize_reader(r)?,filer:PalwBondKeyV2::deserialize_reader(r)?,
+            bottom:Box::deserialize_reader(r)?,signature:sig(r)?}))?),
+    };
+    let (claim,leaf)=match &decoded {DecodedNumericalV1::Root(c)=>(c.claim,c.leaf),DecodedNumericalV1::Round(c)=>(c.claim,c.leaf),DecodedNumericalV1::Bottom(c)=>(c.claim,c.leaf)};
+    if (claim,leaf)!=(m.claim,m.leaf){return Err(invalid("numerical inner original/leaf substitution"));}
+    Ok(decoded)
+}
