+        if opening.leaf_index != leaf { return Err("parameter opening substitutes requested coordinate".into()); }
+        self.check(&opening).map_err(|e| e.to_string())?;
+        Ok(NativeRetainedV1::from_owner_reserved_v1(opening, lease))
+    }
