{
  "format": "misaka.palw.model-adapter.v1",
  "id": "mixin-tokcls-encoder",
  "doc": "A mixin: `…ForTokenClassification` over a BERT-lineage encoder (mixin-bert-encoder): EVERY row of the encoder through `classifier` to `labels` logits per token (OUTPUT_TOKEN_LOGITS_V1, no pooling, no pooler). `labels` is the length of `id2label` (num_labels, 2, when the configuration names none).",
  "vars": [
    {
      "name": "labels",
      "value": {
        "$let": [
          "m",
          {
            "$cfg?": "id2label"
          },
          {
            "$if": [
              {
                "$ne": [
                  {
                    "$var": "m"
                  },
                  null
                ]
              },
              {
                "$len": {
                  "$var": "m"
                }
              },
              {
                "$cfg": [
                  "num_labels",
                  2
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "spec": {
    "output": {
      "Embedding": {
        "$unset": true
      },
      "TokenLogits": {
        "labels": {
          "$var": "labels"
        },
        "bias": true
      }
    }
  }
}
