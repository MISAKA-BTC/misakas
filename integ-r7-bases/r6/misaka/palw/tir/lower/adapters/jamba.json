{
  "format": "misaka.palw.model-adapter.v1",
  "id": "jamba",
  "doc": "Jamba: attention (NoPE) every attn_layer_period layers at attn_layer_offset, Mamba-1 elsewhere with RMS-normalised dt/B/C, MoE every expert_layer_period (softmax top-k, NOT renormalised).",
  "extends": ["decoder-core"],
  "match": {"architectures": ["JambaForCausalLM"], "model_types": ["jamba"]},
  "config": {"defaults": {"vocab_size": 65536, "intermediate_size": 14336, "num_key_value_heads": 8, "max_position_embeddings": 262144, "num_experts_per_tok": 2, "attn_layer_period": 8, "attn_layer_offset": 4, "expert_layer_period": 2, "expert_layer_offset": 1, "mamba_d_state": 16, "mamba_d_conv": 4, "mamba_expand": 2, "mamba_conv_bias": true, "mamba_proj_bias": false}, "inert": ["use_mamba_kernels", "use_associative_scan", "use_mambapy", "num_logits_to_keep"]},
  "vars": [
    {"name": "e", "value": {"$alias": [["num_experts", "num_local_experts"], 16]}},
    {"name": "k", "value": {"$cfg": "num_experts_per_tok"}},
    {"name": "ap", "value": {"$cfg": "attn_layer_period"}},
    {"name": "ao", "value": {"$cfg": "attn_layer_offset"}},
    {"name": "ep", "value": {"$cfg": "expert_layer_period"}},
    {"name": "eo", "value": {"$cfg": "expert_layer_offset"}},
    {"name": "d_state", "value": {"$cfg": "mamba_d_state"}},
    {"name": "d_conv", "value": {"$cfg": "mamba_d_conv"}},
    {"name": "expand", "value": {"$cfg": "mamba_expand"}},
    {"name": "dt_raw", "value": {"$cfg?": "mamba_dt_rank"}},
    {"name": "dt_rank", "value": {"$if": [{"$or": [{"$eq": [{"$var": "dt_raw"}, null]}, {"$eq": [{"$var": "dt_raw"}, "auto"]}]}, {"$idiv": [{"$add": [{"$var": "hidden"}, 15]}, 16]}, {"$var": "dt_raw"}]}},
    {"name": "conv_bias", "value": {"$cfg": "mamba_conv_bias"}},
    {"name": "proj_bias", "value": {"$cfg": "mamba_proj_bias"}},
    {"name": "sw", "value": {"$cfg?": "sliding_window"}},
    {"name": "periods_ok", "value": {"$bad": [{"$and": [{"$ne": [{"$var": "ap"}, 0]}, {"$ne": [{"$var": "ep"}, 0]}, {"$gt": [{"$var": "k"}, 0]}, {"$le": [{"$var": "k"}, {"$var": "e"}]}]}, "periods/top-k"]}},
    {"name": "mamba", "value": {"inner": {"$mul": [{"$var": "expand"}, {"$var": "hidden"}]}, "state": {"$var": "d_state"}, "conv_kernel": {"$var": "d_conv"}, "dt_rank": {"$var": "dt_rank"}, "conv_bias": {"$var": "conv_bias"}, "proj_bias": {"$var": "proj_bias"}, "bcdt_norm": {"$var": "norm"}}},
    {"name": "is_attn", "value": {"$eq": [{"$mod": [{"$var": "i"}, {"$var": "ap"}]}, {"$var": "ao"}]}, "layer": true},
    {"name": "l_mixer", "value": {"$if": [{"$var": "is_attn"}, {"Attention": {"heads": {"$var": "heads"}, "kv_heads": {"$var": "kv"}, "head_dim": {"$var": "hd"}, "v_head_dim": {"$var": "hd"}, "position": "None", "scale": {"$var": "attn_scale"}, "window": {"$var": "sw"}}}, {"Mamba": {"$var": "mamba"}}]}, "layer": true},
    {"name": "l_ffn", "value": {"$if": [{"$eq": [{"$mod": [{"$var": "i"}, {"$var": "ep"}]}, {"$var": "eo"}]}, {"Moe": {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "inter"}, "act": {"$var": "act"}, "router": {"scoring": "Softmax", "normalize": false}}}, {"Mlp": {"intermediate": {"$var": "inter"}, "act": {"$var": "act"}, "gated": true}}]}, "layer": true},
    {"name": "names", "value": {"$merge": [{"$var": "names_base"}, {"final_norm": "{p}final_layernorm", "norm.ffn": "{p}layers.{L}.pre_ff_layernorm", "mlp.gate": "{p}layers.{L}.feed_forward.gate_proj", "mlp.up": "{p}layers.{L}.feed_forward.up_proj", "mlp.down": "{p}layers.{L}.feed_forward.down_proj", "moe.router": "{p}layers.{L}.feed_forward.router", "moe.gate": "{p}layers.{L}.feed_forward.experts.{E}.gate_proj", "moe.up": "{p}layers.{L}.feed_forward.experts.{E}.up_proj", "moe.down": "{p}layers.{L}.feed_forward.experts.{E}.down_proj", "mamba.in": "{p}layers.{L}.mamba.in_proj", "mamba.conv": "{p}layers.{L}.mamba.conv1d", "mamba.x": "{p}layers.{L}.mamba.x_proj", "mamba.dt": "{p}layers.{L}.mamba.dt_proj", "mamba.A_log": "{p}layers.{L}.mamba.A_log", "mamba.D": "{p}layers.{L}.mamba.D", "mamba.out": "{p}layers.{L}.mamba.out_proj", "mamba.dt_norm": "{p}layers.{L}.mamba.dt_layernorm", "mamba.b_norm": "{p}layers.{L}.mamba.b_layernorm", "mamba.c_norm": "{p}layers.{L}.mamba.c_layernorm"}]}},
    {"name": "families", "value": ["C3", "C5", "C7"]},
    {"name": "model_type", "value": "jamba"}
  ]
}
