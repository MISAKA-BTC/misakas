{
  "format": "misaka.palw.model-adapter.v1",
  "id": "glm4-moe",
  "doc": "GLM-4.5 / 4.6 (Glm4MoeForCausalLM): GQA with q/k/v biases (attention_bias; o_proj none), an optional per-head QK RMSNorm (use_qk_norm), partial rotary in NeoX halves, DeepSeek-V3's routing — sigmoid scores, a selection-only bias, groups ranked by their top-2 sum, renormalised, times routed_scaling_factor — with n_shared_experts fused into one shared MLP; the first first_k_dense_replace layers dense; the multi-token-prediction layers are not read.",
  "extends": ["decoder-core"],
  "match": {"architectures": ["Glm4MoeForCausalLM"], "model_types": ["glm4_moe"]},
  "config": {"defaults": {"vocab_size": 151552, "intermediate_size": 10944, "num_hidden_layers": 46, "num_attention_heads": 96, "num_key_value_heads": 8, "max_position_embeddings": 131072, "rms_norm_eps": 1e-05, "use_qk_norm": false, "n_shared_experts": 1, "num_experts_per_tok": 8, "moe_intermediate_size": 1408, "routed_scaling_factor": 1.0, "n_group": 1, "topk_group": 1, "norm_topk_prob": true, "first_k_dense_replace": 1}},
  "vars": [
    {"name": "qk_on", "value": {"$cfg": "use_qk_norm"}},
    {"name": "mtp", "value": {"$alias": [["num_nextn_predict_layers", "num_mtp_layers"], 1]}},
    {"name": "ignored_prefixes", "value": {"$map": [{"$range": {"$var": "mtp"}}, "j", {"$cat": [{"$var": "p"}, "layers.", {"$add": [{"$var": "n"}, {"$var": "j"}]}, "."]}]}},
    {"name": "n_shared", "value": {"$cfg": "n_shared_experts"}},
    {"name": "e", "value": {"$alias": [["n_routed_experts", "num_local_experts"], 128]}},
    {"name": "k", "value": {"$cfg": "num_experts_per_tok"}},
    {"name": "topk_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "k"}, 0]}, {"$le": [{"$var": "k"}, {"$var": "e"}]}]}, {"$cat": ["top-k ", {"$var": "k"}, " of ", {"$var": "e"}, " experts"]}]}},
    {"name": "moe_inter", "value": {"$cfg": "moe_intermediate_size"}},
    {"name": "rsf", "value": {"$cfg": "routed_scaling_factor"}},
    {"name": "ng", "value": {"$cfg": "n_group"}},
    {"name": "tg", "value": {"$cfg": "topk_group"}},
    {"name": "groups_ok", "value": {"$bad": [{"$and": [{"$ne": [{"$var": "ng"}, 0]}, {"$eq": [{"$mod": [{"$var": "e"}, {"$var": "ng"}]}, 0]}, {"$ne": [{"$var": "tg"}, 0]}, {"$le": [{"$var": "tg"}, {"$var": "ng"}]}]}, {"$cat": [{"$var": "e"}, " experts in ", {"$var": "ng"}, " groups, top ", {"$var": "tg"}]}]}},
    {"name": "normalize", "value": {"$cfg": "norm_topk_prob"}},
    {"name": "first_dense", "value": {"$cfg": "first_k_dense_replace"}},
    {"name": "partial", "value": {"$partial_rotary": {"legacy": ["partial_rotary_factor"], "default": 0.5}}},
    {"name": "rope_dim", "value": {"$floor": {"$mul": [{"$var": "hd"}, {"$var": "partial"}]}}},
    {"name": "rope_partial", "value": {"$var": "partial"}},
    {"name": "qkv_bias", "value": {"$var": "abias"}},
    {"name": "o_bias", "value": false},
    {"name": "mbias", "value": false},
    {"name": "qk_norm", "value": {"$if": [{"$var": "qk_on"}, {"norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}, "scope": "PerHeadShared"}, null]}},
    {"name": "l_ffn", "value": {"$if": [{"$ge": [{"$var": "i"}, {"$var": "first_dense"}]}, {"Moe": {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "moe_inter"}, "act": {"$var": "act"}, "router": {"scoring": "Sigmoid", "normalize": {"$var": "normalize"}, "selection_bias": true, "groups": {"n_group": {"$var": "ng"}, "topk_group": {"$var": "tg"}, "score": "Top2Sum"}, "norm_eps": {"$if": [{"$var": "normalize"}, 1e-20, 0.0]}, "scale": {"$var": "rsf"}}, "shared": {"$if": [{"$gt": [{"$var": "n_shared"}, 0]}, {"intermediate": {"$mul": [{"$var": "moe_inter"}, {"$var": "n_shared"}]}, "sigmoid_gate": false}, null]}}}, {"Mlp": {"intermediate": {"$var": "inter"}, "act": {"$var": "act"}, "gated": true}}]}, "layer": true},
    {"name": "names", "value": {"$merge": [{"$var": "names_base"}, {"moe.router": "{p}layers.{L}.mlp.gate", "moe.sel_bias": "{p}layers.{L}.mlp.gate.e_score_correction_bias", "moe.gate": "{p}layers.{L}.mlp.experts.{E}.gate_proj", "moe.up": "{p}layers.{L}.mlp.experts.{E}.up_proj", "moe.down": "{p}layers.{L}.mlp.experts.{E}.down_proj", "moe.shared.gate": "{p}layers.{L}.mlp.shared_experts.gate_proj", "moe.shared.up": "{p}layers.{L}.mlp.shared_experts.up_proj", "moe.shared.down": "{p}layers.{L}.mlp.shared_experts.down_proj"}]}},
    {"name": "families", "value": ["C3", "C8"]},
    {"name": "model_type", "value": "glm4_moe"}
  ]
}
