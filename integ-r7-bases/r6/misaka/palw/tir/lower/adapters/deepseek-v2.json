{
  "format": "misaka.palw.model-adapter.v1",
  "id": "deepseek-v2",
  "doc": "DeepSeek-V2 / V2-Lite: MLA with a compressed latent KV, dense first layers, routed + shared experts; softmax scores, greedy or group-limited (max) selection, weights times routed_scaling_factor and never renormalised (transformers 5 native); YaRN's mscale_all_dim squared onto the attention scale.",
  "extends": ["decoder-core"],
  "match": {"architectures": ["DeepseekV2ForCausalLM"], "model_types": ["deepseek_v2"]},
  "remote_code": ["modeling_deepseek.DeepseekV2ForCausalLM"],
  "config": {"defaults": {"vocab_size": 102400, "hidden_size": 4096, "intermediate_size": 11008, "moe_intermediate_size": 1407, "num_hidden_layers": 32, "num_attention_heads": 32, "max_position_embeddings": 2048, "num_nextn_predict_layers": 0, "n_shared_experts": 2, "routed_scaling_factor": 1.0, "kv_lora_rank": 512, "q_lora_rank": 1536, "qk_rope_head_dim": 64, "v_head_dim": 128, "qk_nope_head_dim": 128, "first_k_dense_replace": 0, "norm_topk_prob": false, "topk_method": "greedy"}, "inert": ["head_dim", "qk_head_dim", "ep_size", "pretraining_tp", "aux_loss_alpha", "seq_aux"]},
  "vars": [
    {"name": "dims_ok", "value": {"$bad": [{"$gt": [{"$var": "heads"}, 0]}, "num_attention_heads must be positive"]}},
    {"name": "kv_eq", "value": {"$let": ["kvc", {"$cfg?": "num_key_value_heads"}, {"$check": [{"$or": [{"$eq": [{"$var": "kvc"}, null]}, {"$eq": [{"$var": "kvc"}, {"$var": "heads"}]}]}, "num_key_value_heads differs from num_attention_heads (the eager attention repeats the expanded K/V by heads / num_key_value_heads)"]}]}},
    {"name": "moe_inter", "value": {"$cfg": "moe_intermediate_size"}},
    {"name": "mtp", "value": {"$cfg": "num_nextn_predict_layers"}},
    {"name": "ignored_prefixes", "value": {"$map": [{"$range": {"$var": "mtp"}}, "j", {"$cat": ["model.layers.", {"$add": [{"$var": "n"}, {"$var": "j"}]}, "."]}]}},
    {"name": "n_shared", "value": {"$cfg": "n_shared_experts"}},
    {"name": "e", "value": {"$alias": [["n_routed_experts", "num_local_experts", "num_experts"], 64]}},
    {"name": "rsf", "value": {"$cfg": "routed_scaling_factor"}},
    {"name": "kv_lora", "value": {"$cfg": "kv_lora_rank"}},
    {"name": "q_lora", "value": {"$cfgn": "q_lora_rank"}},
    {"name": "rope_d", "value": {"$cfg": "qk_rope_head_dim"}},
    {"name": "v_d", "value": {"$cfg": "v_head_dim"}},
    {"name": "nope_d", "value": {"$cfg": "qk_nope_head_dim"}},
    {"name": "k", "value": {"$cfg": "num_experts_per_tok"}},
    {"name": "topk_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "k"}, 0]}, {"$le": [{"$var": "k"}, {"$var": "e"}]}]}, {"$cat": ["top-k ", {"$var": "k"}, " of ", {"$var": "e"}, " experts"]}]}},
    {"name": "first_dense", "value": {"$cfg": "first_k_dense_replace"}},
    {"name": "moe_freq", "value": {"$require_eq": ["moe_layer_freq", 1, "transformers 5 native DeepSeek ignores it; the remote code honours it"]}},
    {"name": "mbias", "value": {"$let": ["_", {"$forbid": ["mlp_bias", "DeepSeek MLPs have no biases"]}, false]}},
    {"name": "sf", "value": {"$cfg?": "scoring_func"}},
    {"name": "sf_ok", "value": {"$check": [{"$or": [{"$eq": [{"$var": "sf"}, null]}, {"$eq": [{"$var": "sf"}, "softmax"]}]}, {"$cat": ["deepseek_v2: scoring_func ", {"$var": "sf"}]}]}},
    {"name": "normalize", "value": {"$cfg": "norm_topk_prob"}},
    {"name": "normalize_ok", "value": {"$check": [{"$not": {"$var": "normalize"}}, "deepseek_v2: norm_topk_prob=true — the remote code renormalises, transformers 5 native never does; ambiguous reference"]}},
    {"name": "method", "value": {"$cfg": "topk_method"}},
    {"name": "ng", "value": {"$cfg?": "n_group"}},
    {"name": "tg", "value": {"$cfg?": "topk_group"}},
    {"name": "method_ok", "value": {"$check": [{"$or": [{"$eq": [{"$var": "method"}, "greedy"]}, {"$eq": [{"$var": "method"}, "group_limited_greedy"]}]}, {"$cat": ["deepseek_v2: topk_method ", {"$var": "method"}]}]}},
    {"name": "limited_ok", "value": {"$bad": [{"$or": [{"$ne": [{"$var": "method"}, "group_limited_greedy"]}, {"$and": [{"$ne": [{"$var": "ng"}, null]}, {"$ne": [{"$var": "tg"}, null]}]}]}, "deepseek_v2: group_limited_greedy without n_group / topk_group"]}},
    {"name": "groups", "value": {"$if": [{"$eq": [{"$var": "method"}, "group_limited_greedy"]}, {"n_group": {"$var": "ng"}, "topk_group": {"$var": "tg"}, "score": "Max"}, null]}},
    {"name": "scoring", "value": "Softmax"},
    {"name": "sel_bias", "value": false},
    {"name": "interleave", "value": true},
    {"name": "groups_ok", "value": {"$bad": [{"$or": [{"$eq": [{"$var": "groups"}, null]}, {"$and": [{"$gt": [{"$var": "ng"}, 0]}, {"$eq": [{"$mod": [{"$var": "e"}, {"$var": "ng"}]}, 0]}, {"$gt": [{"$var": "tg"}, 0]}, {"$le": [{"$var": "tg"}, {"$var": "ng"}]}]}]}, {"$cat": ["deepseek: ", {"$var": "e"}, " experts in ", {"$var": "ng"}, " groups, top ", {"$var": "tg"}]}]}},
    {"name": "qk_d", "value": {"$add": [{"$var": "nope_d"}, {"$var": "rope_d"}]}},
    {"name": "rc", "value": {"$rope_config": {"theta": 10000.0}}},
    {"name": "rc_type", "value": {"$get": [{"$var": "rc"}, "rope_type"]}},
    {"name": "rc_params", "value": {"$get": [{"$var": "rc"}, "params"]}},
    {"name": "mad", "value": {"$get": [{"$var": "rc_params"}, "mscale_all_dim", null]}},
    {"name": "mad_on", "value": {"$and": [{"$ne": [{"$var": "rc_type"}, "default"]}, {"$is_num": {"$var": "mad"}}, {"$ne": [{"$var": "mad"}, 0]}]}},
    {"name": "rf_raw", "value": {"$get": [{"$var": "rc_params"}, "factor", null]}},
    {"name": "rf", "value": {"$if": [{"$is_num": {"$var": "rf_raw"}}, {"$var": "rf_raw"}, 1.0]}},
    {"name": "ms", "lazy": true, "value": {"$if": [{"$le": [{"$var": "rf"}, 1.0]}, 1.0, {"$add": [{"$mul": [{"$mul": [0.1, {"$var": "mad"}]}, {"$ln": {"$var": "rf"}}]}, 1.0]}]}},
    {"name": "scale0", "value": {"$div": [1.0, {"$sqrt": {"$var": "qk_d"}}]}},
    {"name": "scale", "value": {"$if": [{"$var": "mad_on"}, {"$mul": [{"$var": "scale0"}, {"$mul": [{"$var": "ms"}, {"$var": "ms"}]}]}, {"$var": "scale0"}]}},
    {"name": "rope", "value": {"$rope": {"dim": {"$var": "rope_d"}, "style": {"$if": [{"$var": "interleave"}, "Interleaved", "Half"]}, "theta": 10000.0, "max_pos": {"$var": "max_pos"}, "offset": {"$var": "nope_d"}}}},
    {"name": "mla", "value": {"heads": {"$var": "heads"}, "q_lora_rank": {"$var": "q_lora"}, "kv_lora_rank": {"$var": "kv_lora"}, "qk_nope_head_dim": {"$var": "nope_d"}, "qk_rope_head_dim": {"$var": "rope_d"}, "v_head_dim": {"$var": "v_d"}, "q_a_norm": {"$var": "norm"}, "kv_a_norm": {"$var": "norm"}, "a_bias": {"$var": "abias"}, "rope": {"$var": "rope"}, "scale": {"$var": "scale"}}},
    {"name": "l_mixer", "value": {"Mla": {"$var": "mla"}}, "layer": true},
    {"name": "router", "value": {"scoring": {"$var": "scoring"}, "linear_bias": false, "selection_bias": {"$var": "sel_bias"}, "groups": {"$var": "groups"}, "normalize": {"$var": "normalize"}, "norm_eps": {"$if": [{"$var": "normalize"}, 1e-20, 0.0]}, "scale": {"$var": "rsf"}, "jitter_eps": 0.0, "per_expert_scale": false}},
    {"name": "shared", "value": {"$if": [{"$gt": [{"$var": "n_shared"}, 0]}, {"intermediate": {"$mul": [{"$var": "moe_inter"}, {"$var": "n_shared"}]}, "sigmoid_gate": false}, null]}},
    {"name": "l_ffn", "value": {"$if": [{"$ge": [{"$var": "i"}, {"$var": "first_dense"}]}, {"Moe": {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "moe_inter"}, "act": {"$var": "act"}, "router": {"$var": "router"}, "shared": {"$var": "shared"}}}, {"Mlp": {"intermediate": {"$var": "inter"}, "act": {"$var": "act"}, "gated": true, "up_bias": {"$var": "mbias"}, "down_bias": {"$var": "mbias"}}}]}, "layer": true},
    {"name": "names", "value": {"$merge": [{"$var": "names_base"}, {"mla.q": "{p}layers.{L}.self_attn.q_proj", "mla.q_a": "{p}layers.{L}.self_attn.q_a_proj", "mla.q_a_norm": "{p}layers.{L}.self_attn.q_a_layernorm", "mla.q_b": "{p}layers.{L}.self_attn.q_b_proj", "mla.kv_a": "{p}layers.{L}.self_attn.kv_a_proj_with_mqa", "mla.kv_a_norm": "{p}layers.{L}.self_attn.kv_a_layernorm", "mla.kv_b": "{p}layers.{L}.self_attn.kv_b_proj", "mla.o": "{p}layers.{L}.self_attn.o_proj", "moe.router": "{p}layers.{L}.mlp.gate", "moe.sel_bias": "{p}layers.{L}.mlp.gate.e_score_correction_bias", "moe.gate": "{p}layers.{L}.mlp.experts.{E}.gate_proj", "moe.up": "{p}layers.{L}.mlp.experts.{E}.up_proj", "moe.down": "{p}layers.{L}.mlp.experts.{E}.down_proj", "moe.shared.gate": "{p}layers.{L}.mlp.shared_experts.gate_proj", "moe.shared.up": "{p}layers.{L}.mlp.shared_experts.up_proj", "moe.shared.down": "{p}layers.{L}.mlp.shared_experts.down_proj"}]}},
    {"name": "families", "value": ["C3", "C8"]},
    {"name": "model_type", "value": "deepseek_v2"}
  ]
}
