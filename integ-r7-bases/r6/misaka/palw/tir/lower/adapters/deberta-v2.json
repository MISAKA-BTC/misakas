{
  "format": "misaka.palw.model-adapter.v1",
  "id": "deberta-v2",
  "doc": "DeBERTa-v2 / v3 (DebertaV2Model): a post-LN encoder whose attention adds, to the content score, content-to-position and position-to-content terms read from one log-bucketed relative-position table (position_buckets rows each side, passed through encoder.LayerNorm when norm_rel_ebd = layer_norm) projected by the layer's OWN query and key weights (share_att_key). The common scale is 1/sqrt(head_dim * (1 + number of position terms)). No learned positions unless position_biased_input; token types when type_vocab_size > 0. The convolution layer, share_att_key = false, unbucketed positions and a factorised embedding are refused. Features: ENC_BIDIR_V1 with ATTN_DISENTANGLED_V1.",
  "extends": ["mixin-bert-encoder"],
  "match": {"architectures": ["DebertaV2Model", "DebertaV2ForMaskedLM"], "model_types": ["deberta-v2", "deberta_v2"]},
  "config": {"defaults": {"vocab_size": 128100, "hidden_size": 1536, "intermediate_size": 6144, "num_hidden_layers": 24, "num_attention_heads": 24, "max_position_embeddings": 512, "type_vocab_size": 0, "hidden_act": "gelu", "layer_norm_eps": 1e-07, "pad_token_id": 0, "relative_attention": false, "position_buckets": -1, "max_relative_positions": -1, "pos_att_type": [], "share_att_key": false, "norm_rel_ebd": "none", "position_biased_input": true, "conv_kernel_size": 0, "legacy": true}, "inert": ["legacy", "pooler_dropout", "pooler_hidden_act", "pooler_hidden_size", "pooler_dropout", "conv_act", "conv_groups", "embedding_size_unused"]},
  "vars": [
    {"name": "vocab", "value": {"$cfg": "vocab_size"}},
    {"name": "hidden", "value": {"$cfg": "hidden_size"}},
    {"name": "inter", "value": {"$cfg": "intermediate_size"}},
    {"name": "n", "value": {"$cfg": "num_hidden_layers"}},
    {"name": "heads", "value": {"$cfg": "num_attention_heads"}},
    {"name": "max_pos0", "value": {"$cfg": "max_position_embeddings"}},
    {"name": "tvs", "value": {"$cfg": "type_vocab_size"}},
    {"name": "type_rows", "value": {"$if": [{"$gt": [{"$var": "tvs"}, 0]}, {"$var": "tvs"}, null]}},
    {"name": "act", "value": {"$act": {"$cfg": "hidden_act"}}},
    {"name": "eps", "value": {"$cfg": "layer_norm_eps"}},
    {"name": "pad", "value": {"$cfg": "pad_token_id"}},
    {"name": "offset", "value": 0},
    {"name": "rel_ok", "value": {"$check": [{"$eq": [{"$cfg": "relative_attention"}, true]}, "relative_attention = false (no position term at all) is not modelled by this adapter"]}},
    {"name": "share_ok", "value": {"$check": [{"$eq": [{"$cfg": "share_att_key"}, true]}, "share_att_key = false (separate position key/query projections) is not lowered"]}},
    {"name": "conv_ok", "value": {"$check": [{"$le": [{"$cfg": "conv_kernel_size"}, 0]}, "conv_kernel_size > 0 (DeBERTa's convolution layer) is not lowered"]}},
    {"name": "span", "value": {"$cfg": "position_buckets"}},
    {"name": "span_ok", "value": {"$check": [{"$gt": [{"$var": "span"}, 1]}, "position_buckets <= 1 (unbucketed relative positions) is not lowered"]}},
    {"name": "max_rel", "value": {"$if": [{"$gt": [{"$cfg": "max_relative_positions"}, 0]}, {"$cfg": "max_relative_positions"}, {"$var": "max_pos0"}]}},
    {"name": "pat", "value": {"$cfg": "pos_att_type"}},
    {"name": "c2p", "value": {"$contains": [{"$var": "pat"}, "c2p"]}},
    {"name": "p2c", "value": {"$contains": [{"$var": "pat"}, "p2c"]}},
    {"name": "terms", "value": {"$add": [{"$if": [{"$var": "c2p"}, 1, 0]}, {"$if": [{"$var": "p2c"}, 1, 0]}]}},
    {"name": "terms_ok", "value": {"$check": [{"$gt": [{"$var": "terms"}, 0]}, "pos_att_type names neither c2p nor p2c"]}},
    {"name": "nre", "value": {"$cfg": "norm_rel_ebd"}},
    {"name": "nre_ok", "value": {"$check": [{"$or": [{"$eq": [{"$var": "nre"}, "layer_norm"]}, {"$eq": [{"$var": "nre"}, "none"]}]}, {"$cat": ["norm_rel_ebd `", {"$var": "nre"}, "` is not modelled"]}]}},
    {"name": "norm", "value": {"kind": "Layer", "eps": {"$var": "eps"}, "gain": "W", "bias": true}},
    {"name": "l_mixer", "layer": true, "value": {"Attention": {"heads": {"$var": "heads"}, "kv_heads": {"$var": "heads"}, "head_dim": {"$var": "hd"}, "v_head_dim": {"$var": "hd"}, "q_bias": true, "k_bias": true, "v_bias": true, "o_bias": true, "position": "None", "scale": {"$div": [1.0, {"$sqrt": {"$mul": [{"$var": "hd"}, {"$add": [1, {"$var": "terms"}]}]}}]}}}},
    {"name": "embedding", "value": {"dim": {"$var": "hidden"}, "scale": 1.0, "positions": {"$if": [{"$cfg": "position_biased_input"}, {"rows": {"$var": "max_pos0"}, "offset": 0}, null]}, "norm": {"$var": "norm"}, "type_rows": {"$var": "type_rows"}, "rel_bias": null, "disentangled": {"span": {"$var": "span"}, "max_position": {"$var": "max_rel"}, "c2p": {"$var": "c2p"}, "p2c": {"$var": "p2c"}, "norm": {"$if": [{"$eq": [{"$var": "nre"}, "layer_norm"]}, {"$var": "norm"}, null]}}}},
    {"name": "names", "value": {"embed": "embeddings.word_embeddings", "pos_embed": "embeddings.position_embeddings", "type_embed": "embeddings.token_type_embeddings", "embed_norm": "embeddings.LayerNorm", "rel_embed": "encoder.rel_embeddings", "rel_norm": "encoder.LayerNorm", "attn.q": "encoder.layer.{L}.attention.self.query_proj", "attn.k": "encoder.layer.{L}.attention.self.key_proj", "attn.v": "encoder.layer.{L}.attention.self.value_proj", "attn.o": "encoder.layer.{L}.attention.output.dense", "norm.mix": "encoder.layer.{L}.attention.output.LayerNorm", "mlp.up": "encoder.layer.{L}.intermediate.dense", "mlp.down": "encoder.layer.{L}.output.dense", "norm.ffn": "encoder.layer.{L}.output.LayerNorm"}},
    {"name": "prefix_aliases", "value": [["", "deberta."]]},
    {"name": "model_type", "value": "deberta-v2"}
  ]
}
