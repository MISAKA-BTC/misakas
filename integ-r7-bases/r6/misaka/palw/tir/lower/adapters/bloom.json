{
  "format": "misaka.palw.model-adapter.v1",
  "id": "bloom",
  "doc": "BLOOM: embedding LayerNorm, per-head interleaved fused qkv, ALiBi (unscaled, added after the 1/sqrt(d) product), GeLU-tanh, 4x MLP.",
  "extends": ["decoder-core"],
  "match": {"architectures": ["BloomForCausalLM"], "model_types": ["bloom"]},
  "config": {"defaults": {"vocab_size": 250880, "layer_norm_epsilon": 1e-05, "tie_word_embeddings": true}, "inert": ["slow_but_exact", "attention_softmax_in_fp32", "bias_dropout_fusion", "masked_softmax_fusion", "offset_alibi", "skip_bias_add", "skip_bias_add_qkv", "seq_length"]},
  "vars": [
    {"name": "hidden", "value": {"$alias": [["hidden_size", "n_embed"], 64]}},
    {"name": "n", "value": {"$alias": [["n_layer", "num_hidden_layers"], 2]}},
    {"name": "heads", "value": {"$alias": [["n_head", "num_attention_heads"], 8]}},
    {"name": "eps", "value": {"$cfg": "layer_norm_epsilon"}},
    {"name": "chk1", "value": {"$let": ["_", {"$forbid": ["apply_residual_connection_post_layernorm", "BLOOM's post-LN residual variant is not modelled"]}, false]}},
    {"name": "chk2", "value": {"$let": ["_", {"$forbid": ["n_inner", "BLOOM's MLP is fixed at 4·hidden"]}, false]}},
    {"name": "hd", "value": {"$idiv": [{"$var": "hidden"}, {"$var": "heads"}]}},
    {"name": "kv", "value": {"$var": "heads"}},
    {"name": "inter", "value": {"$mul": [4, {"$var": "hidden"}]}},
    {"name": "act", "value": "GeluTanh"},
    {"name": "max_pos", "value": null},
    {"name": "norm", "value": {"kind": "Layer", "eps": {"$var": "eps"}, "gain": "W", "bias": true}},
    {"name": "abias", "value": true},
    {"name": "mbias", "value": true},
    {"name": "mlp_gated", "value": false},
    {"name": "l_position", "value": {"Alibi": {"$alibi": {"heads": {"$var": "heads"}, "kind": "bloom"}}}, "layer": true},
    {"name": "embedding", "value": {"dim": {"$var": "hidden"}, "scale": 1.0, "norm": {"$var": "norm"}}},
    {"name": "qkv_layout", "value": "FusedPerHead"},
    {"name": "names", "value": {"embed": "{p}word_embeddings", "embed_norm": "{p}word_embeddings_layernorm", "final_norm": "{p}ln_f", "lm_head": {"$if": [{"$var": "tied"}, "{p}word_embeddings", "lm_head"]}, "norm.mix": "{p}h.{L}.input_layernorm", "norm.ffn": "{p}h.{L}.post_attention_layernorm", "attn.qkv": "{p}h.{L}.self_attention.query_key_value", "attn.o": "{p}h.{L}.self_attention.dense", "mlp.up": "{p}h.{L}.mlp.dense_h_to_4h", "mlp.down": "{p}h.{L}.mlp.dense_4h_to_h"}},
    {"name": "p", "value": "transformer."},
    {"name": "prefix_aliases", "value": [["transformer.", ""]]},
    {"name": "families", "value": ["C1"]},
    {"name": "model_type", "value": "bloom"}
  ],
  "spec": {"max_position_embeddings": null}
}
