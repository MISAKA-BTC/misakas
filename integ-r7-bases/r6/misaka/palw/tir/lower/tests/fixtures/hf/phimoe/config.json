{
  "architectures": [
    "PhimoeForCausalLM"
  ],
  "attention_bias": true,
  "attention_dropout": 0.0,
  "bos_token_id": 1,
  "dtype": "bfloat16",
  "eos_token_id": 2,
  "hidden_act": "silu",
  "hidden_size": 32,
  "initializer_range": 0.02,
  "input_jitter_noise": 0.0,
  "intermediate_size": 64,
  "lm_head_bias": true,
  "max_position_embeddings": 32,
  "model_type": "phimoe",
  "num_attention_heads": 4,
  "num_experts_per_tok": 2,
  "num_hidden_layers": 2,
  "num_key_value_heads": 2,
  "num_local_experts": 4,
  "original_max_position_embeddings": 8,
  "output_router_logits": false,
  "pad_token_id": null,
  "rms_norm_eps": 1e-05,
  "rope_parameters": {
    "long_factor": [
      2.0,
      4.0,
      6.0,
      8.0
    ],
    "long_mscale": 1.2,
    "original_max_position_embeddings": 8,
    "rope_theta": 10000.0,
    "rope_type": "longrope",
    "short_factor": [
      1.0,
      1.25,
      1.5,
      2.0
    ],
    "short_mscale": 1.2
  },
  "router_aux_loss_coef": 0.001,
  "router_jitter_noise": 0.3,
  "sliding_window": null,
  "tie_word_embeddings": false,
  "transformers_version": "5.17.0",
  "use_cache": true,
  "vocab_size": 64
}
