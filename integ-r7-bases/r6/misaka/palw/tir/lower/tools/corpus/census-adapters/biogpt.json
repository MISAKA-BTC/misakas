{
  "format": "misaka.palw.model-adapter.v1",
  "id": "biogpt",
  "doc": "BioGPT (Microsoft): OPT's block (pre-LN LayerNorm with bias, biased projections, an ungated up/down MLP, learned positions at pos + 2, a final LayerNorm, a tied head) under the prefix `biogpt.`, with the activation read from hidden_act (gelu), the width from intermediate_size, the token embedding times sqrt(hidden) when scale_embedding, and LayerNorm epsilon the torch default 1e-5 (the config's layer_norm_eps is not read by the class). EXPECTED TO STOP at float_vs_hf: the HL builder applies `embedding.scale` to the SUM of token and position embeddings (`x = (tok + pos)\u00b7scale`, hl/build.rs) while BioGPT (like every fairseq-style model: XGLM, M2M-100, Speech2Text) scales the TOKEN embedding only, `tok\u00b7scale + pos` (FR-34); the variant `biogpt_unscaled` (scale_embedding false) shows the rest is data. PENDING VALIDATION (written during the quiet window). Third-party adapter (lane H): data only, extends the built-in opt.",
  "extends": [
    "opt"
  ],
  "match": {
    "architectures": [
      "BioGptForCausalLM"
    ],
    "model_types": [
      "biogpt"
    ]
  },
  "config": {
    "defaults": {
      "hidden_act": "gelu",
      "scale_embedding": true,
      "tie_word_embeddings": true
    },
    "inert": [
      "activation_dropout",
      "attention_probs_dropout_prob",
      "hidden_dropout_prob",
      "layerdrop",
      "layer_norm_eps"
    ]
  },
  "vars": [
    {
      "name": "inter",
      "value": {
        "$cfg": "intermediate_size"
      }
    },
    {
      "name": "act",
      "value": {
        "$act": {
          "$cfg": "hidden_act"
        }
      }
    },
    {
      "name": "wdim",
      "value": {
        "$var": "hidden"
      }
    },
    {
      "name": "se",
      "value": {
        "$cfg": "scale_embedding"
      }
    },
    {
      "name": "embedding",
      "value": {
        "dim": {
          "$var": "hidden"
        },
        "scale": {
          "$if": [
            {
              "$var": "se"
            },
            {
              "$sqrt": {
                "$var": "hidden"
              }
            },
            1.0
          ]
        },
        "positions": {
          "rows": {
            "$add": [
              {
                "$var": "max_pos"
              },
              2
            ]
          },
          "offset": 2
        },
        "proj_in": false
      }
    },
    {
      "name": "head",
      "value": {
        "tied": {
          "$var": "tied"
        },
        "proj_out": false
      }
    },
    {
      "name": "names",
      "value": {
        "embed": "biogpt.embed_tokens",
        "pos_embed": "biogpt.embed_positions",
        "final_norm": "biogpt.layer_norm",
        "lm_head": {
          "$if": [
            {
              "$var": "tied"
            },
            "biogpt.embed_tokens",
            "output_projection"
          ]
        },
        "norm.mix": "biogpt.layers.{L}.self_attn_layer_norm",
        "norm.ffn": "biogpt.layers.{L}.final_layer_norm",
        "attn.q": "biogpt.layers.{L}.self_attn.q_proj",
        "attn.k": "biogpt.layers.{L}.self_attn.k_proj",
        "attn.v": "biogpt.layers.{L}.self_attn.v_proj",
        "attn.o": "biogpt.layers.{L}.self_attn.out_proj",
        "mlp.up": "biogpt.layers.{L}.fc1",
        "mlp.down": "biogpt.layers.{L}.fc2"
      }
    },
    {
      "name": "model_type",
      "value": "biogpt"
    }
  ]
}
