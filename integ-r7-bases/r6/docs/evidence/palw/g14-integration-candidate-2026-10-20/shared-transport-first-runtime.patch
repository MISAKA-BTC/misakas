+#[derive(Clone,Copy,Debug,Default,PartialEq,Eq)]
+pub struct TirSharedDataTransportUpperV1 {
+    pub queries:u64,pub maximum_custodians:u64,pub streams:u64,pub parts:u64,
+    pub fresh_responses:u64,pub signed_controls:u64,pub signed_envelope_bytes:u64,
