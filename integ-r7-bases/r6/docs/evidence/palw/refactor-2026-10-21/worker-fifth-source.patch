+                    .tir_shard_public_court_move_v1(
+                        &session,
+                        network_domain,
+                        current_daa,
+                        duty,
+                        mv,
+                        pool_books.material.map(),
+                        pool_books.intervals.resume_mut(),
+                        &mut shard_books,
+                    )
+                    .await
