+    + `if the executor answers (ADR-0062).`;
+  return `<span class="dim" title="${esc(title)}">🔒 ${esc(what)} — committed, not disclosed${commitment?` <span class="hash">${esc(commitment)}</span>`:""}</span>${extra||""}`;
