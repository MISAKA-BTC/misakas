{
  "request": {
    "messages": [
      {
        "role": "system",
        "content": "You are a helpful assistant."
      },
      {
        "role": "user",
        "content": "Weather in Paris and Rome?"
      },
      {
        "role": "assistant",
        "content": "I will check both.",
        "tool_calls": [
          {
            "id": "call_1",
            "type": "function",
            "function": {
              "name": "get_weather",
              "arguments": "{\"city\": \"Paris\"}"
            }
          },
          {
            "id": "call_2",
            "type": "function",
            "function": {
              "name": "get_weather",
              "arguments": "{\"city\": \"Rome\"}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "call_1",
        "content": "{\"temp_c\": 21}"
      },
      {
        "role": "tool",
        "tool_call_id": "call_2",
        "content": "{\"temp_c\": 27}"
      },
      {
        "role": "user",
        "content": "And Berlin?"
      }
    ],
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "get_weather",
          "description": "Get the current weather for a city",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ],
            "additionalProperties": false
          }
        }
      }
    ],
    "tool_choice": {
      "type": "function",
      "function": {
        "name": "get_weather"
      }
    },
    "parallel_tool_calls": true
  },
  "expect": {
    "verdict": "accepted",
    "ignored_fields": [
      "messages[].tool_call_id",
      "messages[].tool_calls[].id",
      "parallel_tool_calls"
    ],
    "studio": {
      "verdict": "accepted",
      "ignored_fields": [
        "parallel_tool_calls"
      ],
      "why": "the Studio forwards messages[].tool_calls[].id and tool_call_id to an engine that speaks them; only parallel_tool_calls is a no-effect field there"
    }
  }
}
