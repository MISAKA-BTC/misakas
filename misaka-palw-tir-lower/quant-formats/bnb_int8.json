{
 "config": {
  "checks": [
   {
    "message": "this is the 8-bit format",
    "one_of": [
     true
    ],
    "path": "load_in_8bit"
   },
   {
    "message": "4-bit and 8-bit together",
    "one_of": [
     null,
     false
    ],
    "path": "load_in_4bit"
   },
   {
    "message": "llm_int8_threshold above 0 means outlier decomposition: LLM.int8 splits each matmul at run time (activation columns above the threshold go through float16 against the dequantised weight columns, the rest through int8), which a fixed integer graph does not reproduce — a checkpoint saved with llm_int8_threshold 0 is read",
    "one_of": [
     0,
     0.0
    ],
    "path": "llm_int8_threshold"
   }
  ],
  "inert": [
   "bnb_4bit_compute_dtype",
   "bnb_4bit_quant_type",
   "bnb_4bit_quant_storage",
   "bnb_4bit_use_double_quant",
   "llm_int8_enable_fp32_cpu_offload",
   "llm_int8_has_fp16_weight",
   "_load_in_4bit",
   "_load_in_8bit"
  ],
  "lm_head": "unless_skipped",
  "skip": "llm_int8_skip_modules",
  "skip_match": "path"
 },
 "decode": {
  "code": {
   "max": 127,
   "min": -128
  },
  "group": {
   "size": "inp"
  },
  "q": "weight[o, i]",
  "scale": "rnd(scb[o] * rnd(0.007874015718698502, 0), 0)",
  "target": "integers",
  "zero": "0"
 },
 "doc": "bitsandbytes LLM.int8, as `Linear8bitLt` saves it: `.weight` int8 [out, in] and `.SCB` float32 [out], the absolute maximum of each row of the original weight, so W[o, i] = weight[o, i] * SCB[o] / 127 (row-wise absmax quantisation); `.weight_format` (uint8 scalar) must be 0, the row-major layout. The stored integers are lowered as they are (the per-row scale is SCB * float32(1 / 127), rounded to float32; bitsandbytes' own `int8_vectorwise_dequant` rounds twice and agrees to one unit in the last place). Refused by name: `llm_int8_threshold` above 0 — LLM.int8 then splits every matmul at run time (the activation columns whose magnitude passes the threshold are multiplied in float16 against the dequantised weight columns, the rest in int8), which a fixed integer graph does not reproduce; and a hardware-reordered `weight_format` (col32 / col_turing / col_ampere).",
 "ids": [
  {
   "method": "bitsandbytes",
   "scheme": "config",
   "when": [
    {
     "one_of": [
      true
     ],
     "path": "load_in_8bit"
    }
   ]
  }
 ],
 "layout": {
  "checks": [
   {
    "expr": "dim_scb[0] == out",
    "message": "SCB is not one scale per output row"
   },
   {
    "expr": "!has_wfmt || wfmt == 0",
    "message": "the int8 weight is stored in a hardware-reordered layout (`weight_format` col32 / col_turing / col_ampere), not row-major"
   }
  ],
  "dims": {
   "inp": "dim_weight[1]",
   "out": "dim_weight[0]"
  },
  "kind": "tensors",
  "roles": [
   {
    "dtypes": [
     "I8"
    ],
    "name": "weight",
    "rank": 2,
    "suffix": ".weight"
   },
   {
    "dtypes": [
     "F32"
    ],
    "name": "scb",
    "rank": 1,
    "suffix": ".SCB"
   },
   {
    "dtypes": [
     "U8"
    ],
    "name": "wfmt",
    "rank": 0,
    "required": false,
    "suffix": ".weight_format"
   }
  ]
 },
