{
 "config": {
  "checks": [
   {
    "message": "more than one config group: modules of one checkpoint use different formats",
    "one_of": [
     null
    ],
    "path": "config_groups.group_1"
   },
   {
    "message": "targets other than all Linear modules",
    "one_of": [
     [
      "Linear"
     ]
    ],
    "path": "config_groups.group_0.targets"
   },
   {
    "message": "a quantised KV cache changes what the model computes",
    "one_of": [
     null
    ],
    "path": "kv_cache_scheme"
   },
   {
    "message": "a sparse checkpoint stores its tensors differently",
    "one_of": [
     null,
     {}
    ],
    "path": "sparsity_config"
   },
   {
    "message": "transforms (rotations) are applied to the weights at run time",
    "one_of": [
     null,
     {}
    ],
    "path": "transform_config"
   },
   {
    "message": "dynamic weight quantisation",
    "one_of": [
     null,
     false
    ],
    "path": "config_groups.group_0.weights.dynamic"
   },
   {
    "message": "float weights are format float-quantized",
    "one_of": [
     "int"
    ],
    "path": "config_groups.group_0.weights.type"
   },
   {
    "message": "a weight strategy other than group or channel",
    "one_of": [
     "group",
     "channel"
    ],
    "path": "config_groups.group_0.weights.strategy"
   },
   {
    "path": "config_groups.group_0.input_activations",
    "one_of": [
     null
    ],
    "message": "quantised input activations require their own arithmetic contract"
   },
   {
    "path": "config_groups.group_0.output_activations",
    "one_of": [
     null
    ],
    "message": "quantised output activations require their own arithmetic contract"
   }
  ],
  "inert": [
   "format",
   "global_compression_ratio",
   "compression_ratio",
   "quantization_status",
   "version",
   "config_groups.group_0.weights.observer"
  ],
  "lm_head": "unless_skipped",
  "skip": "ignore",
  "skip_match": "exact"
 },
 "decode": {
  "code": {
   "max": "(1 << bits) - 1",
   "min": 0
  },
  "group": {
   "index": "has_g_idx ? g_idx[i] : i / gs",
   "size": "group_size < 1 ? inp : group_size"
  },
  "offset_term": "bits == 8 && !sym",
  "order": "actorder != 0",
  "q": "(packed[o, i / (32 / bits)] >> (bits * (i % (32 / bits)))) & ((1 << bits) - 1)",
  "scale": "scale[o, g]",
  "target": "integers",
  "zero": "has_zp ? ((zp[o / (32 / bits), g] >> (bits * (o % (32 / bits)))) & ((1 << bits) - 1)) : (1 << (bits - 1))"
 },
 "doc": "compressed-tensors, format pack-quantized (llm-compressor W4A16 / W8A16): `weight_packed` int32 [out, in/pack] packs 32/bits codes along the INPUT axis, stored unsigned (offset by 2^(bits-1)); `weight_scale` [out, groups]; an asymmetric checkpoint adds `weight_zero_point` int32 [out/pack, groups] packed along the OUTPUT axis (offset the same way, so the offsets cancel in q - zero); `weight_shape` [out, in]; act-order adds `weight_g_idx` [in]. W = scale * (q - zero).",
 "ids": [
  {
   "method": "compressed-tensors/pack-quantized",
   "scheme": "config"
  }
 ],
 "layout": {
  "checks": [
   {
    "expr": "dim_packed[0] == out && dim_packed[1] == (inp + (32 / bits) - 1) / (32 / bits)",
    "message": "weight_packed is not [out, ceil(in / pack)]"
   },
   {
    "expr": "dim_scale[0] == out && dim_scale[1] == ng",
    "message": "weight_scale is not [out, groups]"
   },
   {
    "expr": "sym || (has_zp && dim_zp[0] * (32 / bits) >= out && dim_zp[1] == ng)",
    "message": "the checkpoint is asymmetric but weight_zero_point is missing or not [out / pack, groups]"
   },
   {
    "expr": "!has_g_idx || dim_g_idx[0] == inp",
    "message": "weight_g_idx is not one entry per input"
   }
  ],
  "dims": {
   "inp": "shape[1]",
   "out": "shape[0]"
  },
  "kind": "tensors",
  "roles": [
   {
    "dtypes": [
     "I32"
    ],
    "name": "packed",
    "rank": 2,
    "suffix": ".weight_packed"
   },
   {
    "dtypes": [
     "F16",
     "BF16",
     "F32"
    ],
    "name": "scale",
    "rank": 2,
    "suffix": ".weight_scale"
   },
   {
    "dtypes": [
     "I32"
    ],
    "name": "zp",
    "rank": 2,
    "required": false,
    "suffix": ".weight_zero_point"
   },
   {
    "dtypes": [
     "I64",
     "I32"
    ],
    "name": "shape",
    "rank": 1,
    "suffix": ".weight_shape"
   },
   {
    "dtypes": [
     "I32"
    ],
    "name": "g_idx",
    "rank": 1,
    "required": false,
    "suffix": ".weight_g_idx"
   }
  ]
 },
 "name": "CT_PACK_QUANTIZED",
 "params": {
  "actorder": {
   "config": "config_groups.group_0.weights.actorder",
   "default": 0,
   "map": {
    "dynamic": 1,
    "group": 1,
    "static": 1,
    "weight": 1
   }
  },
  "bits": {
   "allowed": [
    4,
