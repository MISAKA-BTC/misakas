{
 "decode": {
  "code": {
   "max": 15,
   "min": 0
  },
  "group": {
   "size": "group_size < 1 ? inp : group_size"
  },
  "q": "(qweight[i, o / 8] >> (4 * awq_slot[o % 8])) & 15",
  "scale": "scales[g, o]",
  "target": "integers",
  "zero": "(qzeros[g, o / 8] >> (4 * awq_slot[o % 8])) & 15"
 },
 "doc": "AutoAWQ GEMM: eight 4-bit codes per int32 along the OUTPUT axis in the order 0,2,4,6,1,3,5,7; qzeros the same; scales per (group, output).",
