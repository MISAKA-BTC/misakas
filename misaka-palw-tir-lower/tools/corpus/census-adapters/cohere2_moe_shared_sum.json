{
  "format": "misaka.palw.model-adapter.v1",
  "id": "cohere2_moe_shared_sum",
  "doc": "Cohere2-MoE: Cohere2's block (ONE bias-free LayerNorm feeding a parallel attention + MLP, interleaved rope on the sliding layers and none on the global ones, logit_scale) with every MLP a top-k mixture of per-expert gated MLPs (width intermediate_size): expert_selection_fn softmax = top-k of the raw logits then softmax over the k, sigmoid = top-k then sigmoid, renormalised when norm_topk_prob. NOT modelled, and refused: rms_norm_eps set (RMSNorm variant), dense prefix layers (mlp_layer_types containing dense), and a shared expert combined by `average` (needs a scale on the shared expert: not a spec field). A shared expert combined by `sum` is expressed. PENDING VALIDATION (written during the quiet window). Third-party adapter (lane H): data only, extends the built-in cohere2.",
  "extends": [
    "cohere2"
  ],
  "match": {
    "architectures": [
      "Cohere2MoeForCausalLM"
    ],
    "model_types": [
      "cohere2_moe"
    ]
  },
  "config": {
    "defaults": {
      "expert_selection_fn": "softmax",
      "norm_topk_prob": true,
      "num_shared_experts": 0,
      "shared_expert_combination_strategy": "average",
      "tie_word_embeddings": true
    },
    "inert": [
      "prefix_dense_intermediate_size",
      "prefix_dense_sliding_window_pattern",
      "output_router_logits",
      "router_aux_loss_coef"
    ]
  },
  "vars": [
    {
      "name": "rms_none",
      "value": {
        "$check": [
          {
            "$eq": [
              {
                "$cfg?": "rms_norm_eps"
              },
              null
            ]
          },
          "rms_norm_eps is set: this adapter models the LayerNorm variant only"
        ]
      }
    },
    {
      "name": "mlt",
      "value": {
        "$cfg?": "mlp_layer_types"
      }
    },
    {
      "name": "all_sparse",
      "value": {
        "$check": [
          {
            "$or": [
              {
                "$eq": [
                  {
                    "$var": "mlt"
                  },
                  null
                ]
              },
              {
                "$not": {
                  "$contains": [
                    {
                      "$var": "mlt"
                    },
                    "dense"
                  ]
                }
              }
            ]
          },
          "dense prefix layers (mlp_layer_types has `dense`) force rope and use prefix_dense_intermediate_size: not modelled"
        ]
      }
    },
    {
      "name": "e",
      "value": {
        "$cfg": "num_experts"
      }
    },
    {
      "name": "k",
      "value": {
        "$cfg": "num_experts_per_tok"
      }
    },
    {
      "name": "topk_ok",
      "value": {
        "$bad": [
          {
            "$and": [
              {
                "$gt": [
                  {
                    "$var": "k"
                  },
                  0
                ]
              },
              {
                "$le": [
                  {
                    "$var": "k"
                  },
                  {
                    "$var": "e"
                  }
                ]
              }
            ]
          },
          "top-k out of range"
        ]
      }
    },
    {
      "name": "sel",
      "value": {
        "$cfg": "expert_selection_fn"
      }
    },
    {
      "name": "sel_ok",
      "value": {
        "$check": [
          {
            "$or": [
              {
                "$eq": [
                  {
                    "$var": "sel"
                  },
                  "softmax"
                ]
              },
              {
                "$eq": [
                  {
                    "$var": "sel"
                  },
                  "sigmoid"
                ]
              }
            ]
          },
          "expert_selection_fn is softmax or sigmoid"
        ]
      }
    },
    {
      "name": "norm_topk",
      "value": {
        "$cfg": "norm_topk_prob"
      }
    },
    {
      "name": "n_shared",
      "value": {
        "$cfg": "num_shared_experts"
      }
    },
    {
      "name": "comb",
      "value": {
        "$cfg": "shared_expert_combination_strategy"
      }
    },
    {
      "name": "comb_ok",
      "value": {
        "$check": [
          {
            "$or": [
              {
                "$eq": [
                  {
                    "$var": "n_shared"
                  },
                  0
                ]
              },
              {
                "$eq": [
                  {
                    "$var": "comb"
                  },
                  "sum"
                ]
              }
            ]
          },
          "a shared expert combined by `average` needs a scale on the shared expert (not a spec field yet)"
        ]
      }
    },
    {
      "name": "router",
      "value": {
        "scoring": {
          "$if": [
            {
              "$eq": [
                {
                  "$var": "sel"
                },
                "softmax"
              ]
            },
            "TopKThenSoftmax",
            "TopKThenSigmoid"
          ]
        },
        "linear_bias": false,
        "selection_bias": false,
        "groups": null,
        "normalize": {
          "$if": [
            {
              "$eq": [
                {
                  "$var": "sel"
                },
                "sigmoid"
              ]
            },
            {
              "$var": "norm_topk"
            },
            false
          ]
        },
        "norm_eps": 0.0,
        "scale": 1.0,
        "jitter_eps": 0.0,
        "per_expert_scale": false
      }
    },
    {
      "name": "l_ffn",
      "layer": true,
      "value": {
        "Moe": {
          "experts": {
            "$var": "e"
          },
          "top_k": {
            "$var": "k"
          },
          "intermediate": {
            "$var": "inter"
          },
          "act": {
            "$var": "act"
          },
          "router": {
            "$var": "router"
          },
          "shared": {
            "$if": [
              {
                "$gt": [
                  {
                    "$var": "n_shared"
                  },
                  0
                ]
              },
              {
                "intermediate": {
                  "$mul": [
                    {
                      "$var": "inter"
                    },
                    {
                      "$var": "n_shared"
                    }
                  ]
                },
                "sigmoid_gate": false
              },
              null
            ]
          }
        }
      }
    },
    {
      "name": "names",
      "value": {
        "$merge": [
          {
            "$omit": [
              {
                "$var": "names_base"
              },
              [
                "norm.ffn"
              ]
            ]
          },
          {
            "moe.router": "{p}layers.{L}.mlp.gate",
            "moe.gate": "{p}layers.{L}.mlp.experts.{E}.gate_proj",
            "moe.up": "{p}layers.{L}.mlp.experts.{E}.up_proj",
            "moe.down": "{p}layers.{L}.mlp.experts.{E}.down_proj",
            "moe.shared.gate": "{p}layers.{L}.mlp.shared_experts.gate_proj",
            "moe.shared.up": "{p}layers.{L}.mlp.shared_experts.up_proj",
            "moe.shared.down": "{p}layers.{L}.mlp.shared_experts.down_proj"
          }
        ]
      }
    },
    {
      "name": "model_type",
      "value": "cohere2_moe"
    }
  ]
}
