{
 "format": "misaka.palw.model-adapter.v1",
 "id": "afmoe",
 "doc": "AFMoE (Arcee Trinity): sliding/global layers (global every global_attn_every_n_layers; rotary on the sliding layers only), per-head shared q/k RMS norm before the rotation, a SEPARATE sigmoid output gate per element (self_attn.gate_proj: ATTN_OUTPUT_GATE_SEPARATE_V1), norms before AND after attention and MLP, the first num_dense_layers dense, then a sigmoid router with a selection bias (expert_bias), renormalised times route_scale, plus shared experts. mup_enabled is not read by the native class. Third-party adapter (lane H): data only.",
 "extends": [
  "decoder-core"
 ],
 "match": {
  "architectures": [
   "AfmoeForCausalLM"
  ],
  "model_types": [
   "afmoe"
  ]
 },
 "config": {
  "defaults": {
   "num_experts": 64,
   "num_experts_per_tok": 6,
   "num_shared_experts": 2,
   "moe_intermediate_size": 1408,
   "route_scale": 1.0,
   "num_dense_layers": 1,
   "global_attn_every_n_layers": 4,
   "sliding_window": 1024,
   "tie_word_embeddings": false
  },
  "inert": [
   "output_router_logits",
   "mup_enabled"
  ]
 },
 "vars": [
  {
   "name": "sw",
   "value": {
    "$cfgn": [
     "sliding_window",
     1024
    ]
   }
  },
  {
   "name": "gev",
   "value": {
    "$cfg": "global_attn_every_n_layers"
   }
  },
  {
   "name": "types",
   "value": {
    "$layer_types": {
     "n": {
      "$var": "n"
     },
     "allowed": [
      "full_attention",
      "sliding_attention"
     ],
     "each": {
      "$if": [
       {
        "$eq": [
         {
          "$mod": [
           {
            "$add": [
             {
              "$var": "i"
             },
             1
            ]
           },
           {
            "$var": "gev"
           }
          ]
         },
         0
        ]
       },
       "full_attention",
       "sliding_attention"
      ]
     }
    }
   }
  },
  {
   "name": "l_position",
   "layer": true,
   "value": {
    "$if": [
     {
      "$eq": [
       {
        "$index": [
         {
          "$var": "types"
         },
         {
          "$var": "i"
         }
        ]
       },
       "sliding_attention"
      ]
     },
     {
      "Rope": {
       "$var": "rope"
      }
     },
     "None"
    ]
   }
  },
  {
   "name": "qk_norm",
   "value": {
    "norm": {
     "kind": "Rms",
     "eps": {
      "$var": "eps"
     },
     "gain": "W",
     "bias": false
    },
    "scope": "PerHeadShared"
   }
  },
  {
   "name": "attn_extra",
   "value": {
    "gate": {
     "act": "Sigmoid",
     "per_head": false
    }
   }
  },
  {
   "name": "residual",
   "value": {
    "Sequential": {
     "pre_mixer": {
      "$var": "norm"
     },
     "post_mixer": {
      "$var": "norm"
     },
     "pre_ffn": {
      "$var": "norm"
     },
     "post_ffn": {
      "$var": "norm"
     },
     "multiplier": 1.0
    }
   }
  },
  {
   "name": "e",
   "value": {
    "$cfg": "num_experts"
   }
  },
  {
   "name": "k",
   "value": {
    "$cfg": "num_experts_per_tok"
   }
  },
  {
   "name": "topk_ok",
   "value": {
    "$bad": [
     {
      "$and": [
       {
        "$gt": [
         {
          "$var": "k"
         },
         0
        ]
       },
       {
        "$le": [
         {
          "$var": "k"
         },
         {
          "$var": "e"
         }
        ]
       }
      ]
     },
     "top-k out of range"
    ]
   }
  },
  {
   "name": "moe_inter",
   "value": {
    "$cfg": "moe_intermediate_size"
   }
  },
  {
   "name": "n_shared",
   "value": {
    "$cfg": "num_shared_experts"
   }
  },
  {
   "name": "ndense",
   "value": {
    "$cfg": "num_dense_layers"
   }
  },
  {
   "name": "router",
   "value": {
    "scoring": "Sigmoid",
    "linear_bias": false,
    "selection_bias": true,
    "groups": null,
    "normalize": true,
    "norm_eps": 1e-20,
    "scale": {
     "$cfg": "route_scale"
    },
    "jitter_eps": 0.0,
    "per_expert_scale": false
   }
  },
  {
   "name": "shared",
   "value": {
    "$if": [
     {
      "$gt": [
       {
        "$var": "n_shared"
       },
       0
      ]
     },
     {
      "intermediate": {
       "$mul": [
        {
         "$var": "moe_inter"
        },
        {
         "$var": "n_shared"
        }
       ]
      },
      "sigmoid_gate": false
     },
     null
    ]
   }
  },
  {
   "name": "l_ffn",
   "layer": true,
   "value": {
    "$if": [
     {
      "$ge": [
       {
        "$var": "i"
       },
       {
        "$var": "ndense"
       }
      ]
     },
     {
      "Moe": {
       "experts": {
        "$var": "e"
       },
       "top_k": {
        "$var": "k"
       },
       "intermediate": {
        "$var": "moe_inter"
       },
       "act": {
        "$var": "act"
       },
       "router": {
        "$var": "router"
       },
       "shared": {
        "$var": "shared"
       }
      }
     },
     {
      "Mlp": {
       "intermediate": {
        "$var": "inter"
       },
       "act": {
        "$var": "act"
       },
       "gated": true,
       "up_bias": {
        "$var": "mbias"
       },
       "down_bias": {
        "$var": "mbias"
       }
      }
     }
    ]
   }
  },
  {
   "name": "names",
   "value": {
    "$merge": [
     {
      "$var": "names_base"
     },
     {
      "norm.post_mix": "{p}layers.{L}.post_attention_layernorm",
      "norm.ffn": "{p}layers.{L}.pre_mlp_layernorm",
      "norm.post_ffn": "{p}layers.{L}.post_mlp_layernorm",
      "attn.gate": "{p}layers.{L}.self_attn.gate_proj",
      "moe.router": "{p}layers.{L}.mlp.router.gate",
      "moe.sel_bias": "{p}layers.{L}.mlp.expert_bias",
      "moe.gate": "{p}layers.{L}.mlp.experts.{E}.gate_proj",
      "moe.up": "{p}layers.{L}.mlp.experts.{E}.up_proj",
      "moe.down": "{p}layers.{L}.mlp.experts.{E}.down_proj",
      "moe.shared.gate": "{p}layers.{L}.mlp.shared_experts.gate_proj",
      "moe.shared.up": "{p}layers.{L}.mlp.shared_experts.up_proj",
      "moe.shared.down": "{p}layers.{L}.mlp.shared_experts.down_proj"
     }
    ]
   }
  },
  {
   "name": "model_type",
   "value": "afmoe"
  }
 ]
}