{
  "format": "misaka.palw.model-adapter.v1",
  "id": "bert",
  "doc": "BERT (BertModel): post-LN encoder over word + position + token-type-0 embeddings and an embedding LayerNorm; positions from 0.",
  "extends": ["mixin-bert-encoder"],
  "match": {"architectures": ["BertModel"], "model_types": ["bert"]},
  "config": {"defaults": {"vocab_size": 30522, "hidden_size": 768, "intermediate_size": 3072, "num_hidden_layers": 12, "num_attention_heads": 12, "max_position_embeddings": 512, "type_vocab_size": 2, "hidden_act": "gelu", "layer_norm_eps": 1e-12, "pad_token_id": 0}},
  "vars": [
    {"name": "vocab", "value": {"$cfg": "vocab_size"}},
    {"name": "hidden", "value": {"$cfg": "hidden_size"}},
    {"name": "inter", "value": {"$cfg": "intermediate_size"}},
    {"name": "n", "value": {"$cfg": "num_hidden_layers"}},
    {"name": "heads", "value": {"$cfg": "num_attention_heads"}},
    {"name": "max_pos0", "value": {"$cfg": "max_position_embeddings"}},
    {"name": "type_rows", "value": {"$cfg": "type_vocab_size"}},
    {"name": "act", "value": {"$act": {"$cfg": "hidden_act"}}},
    {"name": "eps", "value": {"$cfg": "layer_norm_eps"}},
    {"name": "pad", "value": {"$cfg": "pad_token_id"}},
    {"name": "offset", "value": 0},
    {"name": "names", "value": {"embed": "embeddings.word_embeddings", "pos_embed": "embeddings.position_embeddings", "type_embed": "embeddings.token_type_embeddings", "embed_norm": "embeddings.LayerNorm", "attn.q": "encoder.layer.{L}.attention.self.query", "attn.k": "encoder.layer.{L}.attention.self.key", "attn.v": "encoder.layer.{L}.attention.self.value", "attn.o": "encoder.layer.{L}.attention.output.dense", "norm.mix": "encoder.layer.{L}.attention.output.LayerNorm", "mlp.up": "encoder.layer.{L}.intermediate.dense", "mlp.down": "encoder.layer.{L}.output.dense", "norm.ffn": "encoder.layer.{L}.output.LayerNorm"}},
    {"name": "model_type", "value": "bert"}
  ]
}
