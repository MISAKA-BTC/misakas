{
  "format": "misaka.palw.model-adapter.v1",
  "id": "opt",
  "doc": "OPT: learned positions at pos + 2, pre-LN (post-LN for OPT-350m), project_in/out when the embedding width differs, ReLU MLP.",
  "extends": ["standard-decoder"],
  "match": {"architectures": ["OPTForCausalLM"], "model_types": ["opt"]},
  "config": {"defaults": {"vocab_size": 50272, "hidden_size": 768, "num_hidden_layers": 12, "ffn_dim": 3072, "num_attention_heads": 12, "max_position_embeddings": 2048, "do_layer_norm_before": true, "_remove_final_layer_norm": false, "activation_function": "relu", "enable_bias": true, "layer_norm_elementwise_affine": true, "tie_word_embeddings": true}},
  "vars": [
    {"name": "inter", "value": {"$cfg": "ffn_dim"}},
    {"name": "pre", "value": {"$cfg": "do_layer_norm_before"}},
    {"name": "remove_final", "value": {"$cfg": "_remove_final_layer_norm"}},
    {"name": "wdim", "value": {"$let": ["w", {"$cfg?": "word_embed_proj_dim"}, {"$if": [{"$ne": [{"$var": "w"}, null]}, {"$var": "w"}, {"$var": "hidden"}]}]}},
    {"name": "act", "value": {"$act": {"$cfg": "activation_function"}}},
    {"name": "bias", "value": {"$cfg": "enable_bias"}},
    {"name": "affine", "value": {"$cfg": "layer_norm_elementwise_affine"}},
    {"name": "hd", "value": {"$idiv": [{"$var": "hidden"}, {"$var": "heads"}]}},
    {"name": "kv", "value": {"$var": "heads"}},
    {"name": "norm", "value": {"$if": [{"$var": "affine"}, {"kind": "Layer", "eps": 1e-05, "gain": "W", "bias": true}, {"kind": "Layer", "eps": 1e-05, "gain": "None", "bias": false}]}},
    {"name": "abias", "value": {"$var": "bias"}},
    {"name": "mbias", "value": {"$var": "bias"}},
    {"name": "mlp_gated", "value": false},
    {"name": "residual", "value": {"$if": [{"$var": "pre"}, {"Sequential": {"pre_mixer": {"$var": "norm"}, "post_mixer": null, "pre_ffn": {"$var": "norm"}, "post_ffn": null, "multiplier": 1.0}}, {"PostNorm": {"mixer_norm": {"$var": "norm"}, "ffn_norm": {"$var": "norm"}}}]}},
    {"name": "proj", "value": {"$ne": [{"$var": "wdim"}, {"$var": "hidden"}]}},
    {"name": "embedding", "value": {"dim": {"$var": "wdim"}, "scale": 1.0, "positions": {"rows": {"$add": [{"$var": "max_pos"}, 2]}, "offset": 2}, "proj_in": {"$var": "proj"}}},
    {"name": "head", "value": {"tied": {"$var": "tied"}, "proj_out": {"$var": "proj"}}},
    {"name": "final_norm", "value": {"$if": [{"$and": [{"$var": "pre"}, {"$not": {"$var": "remove_final"}}]}, {"$var": "norm"}, null]}},
    {"name": "names", "value": {"$merge": [{"embed": "{p}decoder.embed_tokens", "pos_embed": "{p}decoder.embed_positions", "final_norm": "{p}decoder.final_layer_norm", "lm_head": {"$if": [{"$var": "tied"}, "{p}decoder.embed_tokens", "lm_head"]}, "norm.mix": "{p}decoder.layers.{L}.self_attn_layer_norm", "norm.ffn": "{p}decoder.layers.{L}.final_layer_norm", "attn.q": "{p}decoder.layers.{L}.self_attn.q_proj", "attn.k": "{p}decoder.layers.{L}.self_attn.k_proj", "attn.v": "{p}decoder.layers.{L}.self_attn.v_proj", "attn.o": "{p}decoder.layers.{L}.self_attn.out_proj", "mlp.up": "{p}decoder.layers.{L}.fc1", "mlp.down": "{p}decoder.layers.{L}.fc2"}, {"$if": [{"$var": "proj"}, {"proj_in": "{p}decoder.project_in", "proj_out": "{p}decoder.project_out"}, {}]}]}},
    {"name": "p", "value": "model."},
    {"name": "l_position", "value": "None", "layer": true},
    {"name": "prefix_aliases", "value": [["model.", ""]]},
    {"name": "families", "value": ["C1"]},
    {"name": "model_type", "value": "opt"}
  ]
}
