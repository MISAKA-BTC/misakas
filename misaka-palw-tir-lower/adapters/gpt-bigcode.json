{
  "format": "misaka.palw.model-adapter.v1",
  "id": "gpt-bigcode",
  "doc": "GPTBigCode (StarCoder-1, SantaCoder): GPT-2 wiring with nn.Linear and multi-query attention (multi_query), learned positions.",
  "extends": ["standard-decoder"],
  "match": {"architectures": ["GPTBigCodeForCausalLM"], "model_types": ["gpt_bigcode"]},
  "config": {"defaults": {"vocab_size": 50257, "activation_function": "gelu_pytorch_tanh", "layer_norm_epsilon": 1e-05, "tie_word_embeddings": true, "scale_attn_weights": true, "multi_query": true}, "inert": ["attention_softmax_in_fp32", "scale_attention_softmax_in_fp32", "inference_runner", "validate_runner_input", "pre_allocate_kv_cache", "pad_key_length", "max_batch_size", "max_sequence_length"]},
  "vars": [
    {"name": "hidden", "value": {"$alias": [["n_embd", "hidden_size"], 768]}},
    {"name": "n", "value": {"$alias": [["n_layer", "num_hidden_layers"], 12]}},
    {"name": "heads", "value": {"$alias": [["n_head", "num_attention_heads"], 12]}},
    {"name": "n_pos", "value": {"$alias": [["n_positions", "max_position_embeddings"], 1024]}},
    {"name": "max_pos", "value": {"$var": "n_pos"}},
    {"name": "inter", "value": {"$let": ["i", {"$cfg?": "n_inner"}, {"$if": [{"$ne": [{"$var": "i"}, null]}, {"$var": "i"}, {"$mul": [4, {"$var": "hidden"}]}]}]}},
    {"name": "act", "value": {"$act": {"$cfg": "activation_function"}}},
    {"name": "eps", "value": {"$cfg": "layer_norm_epsilon"}},
    {"name": "scale_w", "value": {"$cfg": "scale_attn_weights"}},
    {"name": "mq", "value": {"$cfg": "multi_query"}},
    {"name": "kv_cfg", "value": {"$cfg?": "num_key_value_heads"}},
    {"name": "kv_ok", "value": {"$bad": [{"$or": [{"$eq": [{"$var": "kv_cfg"}, null]}, {"$eq": [{"$var": "kv_cfg"}, {"$if": [{"$var": "mq"}, 1, {"$var": "heads"}]}]}]}, "num_key_value_heads disagrees with multi_query"]}},
    {"name": "hd", "value": {"$idiv": [{"$var": "hidden"}, {"$var": "heads"}]}},
    {"name": "kv", "value": {"$if": [{"$var": "mq"}, 1, {"$var": "heads"}]}},
    {"name": "norm", "value": {"kind": "Layer", "eps": {"$var": "eps"}, "gain": "W", "bias": true}},
    {"name": "abias", "value": true},
    {"name": "mbias", "value": true},
    {"name": "mlp_gated", "value": false},
    {"name": "qkv_layout", "value": {"$if": [{"$var": "mq"}, "FusedConcat", "FusedPerHead"]}},
    {"name": "attn_scale", "value": {"$if": [{"$var": "scale_w"}, {"$div": [1.0, {"$sqrt": {"$var": "hd"}}]}, 1.0]}},
    {"name": "l_position", "value": "None", "layer": true},
    {"name": "embedding", "value": {"dim": {"$var": "hidden"}, "scale": 1.0, "positions": {"rows": {"$var": "n_pos"}, "offset": 0}}},
    {"name": "names", "value": {"embed": "{p}wte", "pos_embed": "{p}wpe", "final_norm": "{p}ln_f", "lm_head": {"$if": [{"$var": "tied"}, "{p}wte", "lm_head"]}, "norm.mix": "{p}h.{L}.ln_1", "norm.ffn": "{p}h.{L}.ln_2", "attn.qkv": "{p}h.{L}.attn.c_attn", "attn.o": "{p}h.{L}.attn.c_proj", "mlp.up": "{p}h.{L}.mlp.c_fc", "mlp.down": "{p}h.{L}.mlp.c_proj"}},
    {"name": "p", "value": "transformer."},
    {"name": "families", "value": ["C1", "C2"]},
    {"name": "model_type", "value": "gpt_bigcode"}
  ]
}
