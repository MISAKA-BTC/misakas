{
  "format": "misaka.palw.model-adapter.v1",
  "id": "phi",
  "doc": "Phi-1 / 1.5 / 2: ONE LayerNorm feeding a parallel attention+MLP, partial rotary (default 0.5), biases everywhere including the LM head, optional per-head QK LayerNorm (shared gain).",
  "extends": ["decoder-core"],
  "match": {"architectures": ["PhiForCausalLM"], "model_types": ["phi"]},
  "config": {"defaults": {"vocab_size": 51200, "hidden_size": 2048, "intermediate_size": 8192, "num_hidden_layers": 24, "hidden_act": "gelu_new", "max_position_embeddings": 2048, "layer_norm_eps": 1e-05, "qk_layernorm": false}},
  "vars": [
    {"name": "eps", "value": {"$cfg": "layer_norm_eps"}},
    {"name": "qk_ln", "value": {"$cfg": "qk_layernorm"}},
    {"name": "partial", "value": {"$partial_rotary": {"legacy": ["partial_rotary_factor"], "default": 0.5}}},
    {"name": "rope_dim", "value": {"$floor": {"$mul": [{"$var": "hd"}, {"$var": "partial"}]}}},
    {"name": "rope_partial", "value": {"$var": "partial"}},
    {"name": "norm", "value": {"kind": "Layer", "eps": {"$var": "eps"}, "gain": "W", "bias": true}},
    {"name": "qkv_bias", "value": true},
    {"name": "o_bias", "value": true},
    {"name": "abias", "value": true},
    {"name": "mbias", "value": true},
    {"name": "mlp_gated", "value": false},
    {"name": "qk_norm", "value": {"$if": [{"$var": "qk_ln"}, {"norm": {"kind": "Layer", "eps": {"$var": "eps"}, "gain": "W", "bias": true}, "scope": "PerHeadShared"}, null]}},
    {"name": "residual", "value": {"Parallel": {"norm": {"$var": "norm"}, "ffn_norm": null}}},
    {"name": "head", "value": {"tied": {"$var": "tied"}, "bias": true}},
    {"name": "names", "value": {"embed": "{p}embed_tokens", "final_norm": "{p}final_layernorm", "lm_head": {"$if": [{"$var": "tied"}, "{p}embed_tokens", "lm_head"]}, "norm.mix": "{p}layers.{L}.input_layernorm", "attn.q": "{p}layers.{L}.self_attn.q_proj", "attn.k": "{p}layers.{L}.self_attn.k_proj", "attn.v": "{p}layers.{L}.self_attn.v_proj", "attn.o": "{p}layers.{L}.self_attn.dense", "attn.q_norm": "{p}layers.{L}.self_attn.q_layernorm", "attn.k_norm": "{p}layers.{L}.self_attn.k_layernorm", "mlp.up": "{p}layers.{L}.mlp.fc1", "mlp.down": "{p}layers.{L}.mlp.fc2", "lm_head_bias": "lm_head.bias"}},
    {"name": "families", "value": ["C1"]},
    {"name": "model_type", "value": "phi"}
  ]
}
