{
  "format": "misaka.palw.model-adapter.v1",
  "id": "gpt2",
  "doc": "GPT-2: learned positions, Conv1D weights stored [in, out], fused c_attn, no rotary; scale_attn_weights and scale_attn_by_inverse_layer_idx change the score scale.",
  "extends": ["decoder-core"],
  "match": {"architectures": ["GPT2LMHeadModel"], "model_types": ["gpt2"]},
  "config": {"defaults": {"vocab_size": 50257, "activation_function": "gelu_new", "layer_norm_epsilon": 1e-05, "tie_word_embeddings": true, "scale_attn_weights": true, "scale_attn_by_inverse_layer_idx": false}, "inert": ["reorder_and_upcast_attn", "n_ctx"]},
  "vars": [
    {"name": "chk_n_special", "value": {"$forbid": ["n_special", "special-token rows beyond the vocabulary (openai-gpt) are not modelled"]}},
    {"name": "hidden", "value": {"$alias": [["n_embd", "hidden_size"], 768]}},
    {"name": "n", "value": {"$alias": [["n_layer", "num_hidden_layers"], 12]}},
    {"name": "heads", "value": {"$alias": [["n_head", "num_attention_heads"], 12]}},
    {"name": "n_pos", "value": {"$alias": [["n_positions", "max_position_embeddings"], 1024]}},
    {"name": "max_pos", "value": {"$var": "n_pos"}},
    {"name": "inter", "value": {"$let": ["i", {"$cfg?": "n_inner"}, {"$if": [{"$ne": [{"$var": "i"}, null]}, {"$var": "i"}, {"$mul": [4, {"$var": "hidden"}]}]}]}},
    {"name": "act", "value": {"$act": {"$cfg": "activation_function"}}},
    {"name": "eps", "value": {"$cfg": "layer_norm_epsilon"}},
    {"name": "scale_w", "value": {"$cfg": "scale_attn_weights"}},
    {"name": "inv_layer", "value": {"$cfg": "scale_attn_by_inverse_layer_idx"}},
    {"name": "div_ok", "value": {"$bad": [{"$eq": [{"$mod": [{"$var": "hidden"}, {"$var": "heads"}]}, 0]}, {"$cat": ["gpt2: n_embd ", {"$var": "hidden"}, " not divisible by n_head ", {"$var": "heads"}]}]}},
    {"name": "hd", "value": {"$idiv": [{"$var": "hidden"}, {"$var": "heads"}]}},
    {"name": "kv", "value": {"$var": "heads"}},
    {"name": "norm", "value": {"kind": "Layer", "eps": {"$var": "eps"}, "gain": "W", "bias": true}},
    {"name": "abias", "value": true},
    {"name": "mbias", "value": true},
    {"name": "mlp_gated", "value": false},
    {"name": "l_scale", "value": {"$if": [{"$var": "scale_w"}, {"$div": [1.0, {"$sqrt": {"$var": "hd"}}]}, 1.0]}, "layer": true},
    {"name": "l_scale2", "value": {"$if": [{"$var": "inv_layer"}, {"$div": [{"$var": "l_scale"}, {"$add": [{"$var": "i"}, 1]}]}, {"$var": "l_scale"}]}, "layer": true},
    {"name": "attn_extra", "value": {"scale": {"$var": "l_scale2"}}, "layer": true},
    {"name": "l_position", "value": "None", "layer": true},
    {"name": "embedding", "value": {"dim": {"$var": "hidden"}, "scale": 1.0, "positions": {"rows": {"$var": "n_pos"}, "offset": 0}}},
    {"name": "qkv_layout", "value": "FusedConcat"},
    {"name": "names", "value": {"embed": "{p}wte", "pos_embed": "{p}wpe", "final_norm": "{p}ln_f", "lm_head": {"$if": [{"$var": "tied"}, "{p}wte", "lm_head"]}, "norm.mix": "{p}h.{L}.ln_1", "norm.ffn": "{p}h.{L}.ln_2", "attn.qkv": "{p}h.{L}.attn.c_attn", "attn.o": "{p}h.{L}.attn.c_proj", "mlp.up": "{p}h.{L}.mlp.c_fc", "mlp.down": "{p}h.{L}.mlp.c_proj"}},
    {"name": "p", "value": "transformer."},
    {"name": "prefix_aliases", "value": [["transformer.", ""]]},
    {"name": "conv1d", "value": true},
    {"name": "families", "value": ["C1"]},
    {"name": "model_type", "value": "gpt2"}
  ],
  "spec": {"hf": {"conv1d_weights": {"$var": "conv1d"}}}
}
