{
  "format": "misaka.palw.model-adapter.v1",
  "id": "mpt",
  "doc": "MPT (native MptForCausalLM and the remote MPTForCausalLM configs): ALiBi (alibi_bias_max 8), bias-free LayerNorm and projections, fused Wqkv with an optional clamp, exact GeLU, 4x MLP; the nested attn_config and ffn_config are read key by key.",
  "extends": ["decoder-core"],
  "match": {"architectures": ["MptForCausalLM", "MPTForCausalLM"], "model_types": ["mpt"]},
  "remote_code": ["modeling_mpt.MPTForCausalLM"],
  "config": {"defaults": {"vocab_size": 50368, "layer_norm_epsilon": 1e-05, "tie_word_embeddings": true, "max_seq_len": 2048}, "inert": ["learned_pos_emb", "init_device", "verbose", "embedding_fraction", "init_config", "fc_type", "tokenizer_name", "use_pad_tok_in_ffn"]},
  "vars": [
    {"name": "hidden", "value": {"$alias": [["d_model", "hidden_size"], 2048]}},
    {"name": "n", "value": {"$alias": [["n_layers", "num_hidden_layers"], 24]}},
    {"name": "heads", "value": {"$alias": [["n_heads", "num_attention_heads"], 16]}},
    {"name": "max_pos", "value": {"$cfg": "max_seq_len"}},
    {"name": "eps", "value": {"$cfg": "layer_norm_epsilon"}},
    {"name": "chk1", "value": {"$require_eq": ["expansion_ratio", 4, "MptMLP hard-codes 4·hidden"]}},
    {"name": "chk2", "value": {"$require_eq": ["no_bias", true, "MptForCausalLM has no biases"]}},
    {"name": "chk3", "value": {"$let": ["_", {"$forbid": ["logit_scale", "MptForCausalLM does not scale logits"]}, false]}},
    {"name": "norm_type", "value": {"$cfg?": "norm_type"}},
    {"name": "chk4", "value": {"$check": [{"$or": [{"$eq": [{"$var": "norm_type"}, null]}, {"$eq": [{"$var": "norm_type"}, "low_precision_layernorm"]}, {"$eq": [{"$var": "norm_type"}, "layernorm"]}]}, {"$cat": ["norm_type ", {"$var": "norm_type"}]}]}},
    {"name": "ffn_cfg", "value": {"$cfg?": "ffn_config"}},
    {"name": "chk5", "value": {"$check": [{"$or": [{"$eq": [{"$var": "ffn_cfg"}, null]}, {"$or": [{"$eq": [{"$get": [{"$var": "ffn_cfg"}, "ffn_type"]}, null]}, {"$eq": [{"$get": [{"$var": "ffn_cfg"}, "ffn_type"]}, "mptmlp"]}]}]}, "ffn_type is not mptmlp"]}},
    {"name": "chk6", "value": {"$check": [{"$or": [{"$eq": [{"$var": "ffn_cfg"}, null]}, {"$eq": [{"$len": {"$var": "ffn_cfg"}}, {"$if": [{"$eq": [{"$get": [{"$var": "ffn_cfg"}, "ffn_type"]}, null]}, 0, 1]}]}]}, "ffn_config keys beyond ffn_type"]}},
    {"name": "ac", "value": {"$scope": {"key": "attn_config", "inert": ["attn_pdrop", "attn_impl", "attn_uses_sequence_id"], "body": {"$let": ["_t", {"$let": ["ty", {"$cfg?": "attn_type"}, {"$check": [{"$or": [{"$eq": [{"$var": "ty"}, null]}, {"$eq": [{"$var": "ty"}, "multihead_attention"]}]}, "attn_type (the native port is MHA only)"]}]}, {"$let": ["_a", {"$let": ["_", {"$forbid": ["prefix_lm", "prefix-LM attention is bidirectional over the prompt"]}, false]}, {"$let": ["_b", {"$let": ["_", {"$forbid": ["qk_ln", "MptAttention has no QK LayerNorm"]}, false]}, {"$let": ["_c", {"$require_eq": ["alibi", true, "the native port always adds ALiBi"]}, {"$let": ["_d", {"$require_eq": ["alibi_bias_max", 8, "the native port always uses alibi_bias_max = 8"]}, {"$let": ["_e", {"$let": ["_", {"$forbid": ["rope", "llm-foundry rope variants are not in the native port"]}, false]}, {"$let": ["_f", {"$let": ["_", {"$forbid": ["sliding_window_size", "not in the native port"]}, false]}, {"clip": {"$cfg?": "clip_qkv"}, "softmax_scale": {"$cfg?": "softmax_scale"}}]}]}]}]}]}]}]}}}},
    {"name": "clip", "value": {"$get": [{"$var": "ac"}, "clip"]}},
    {"name": "softmax_scale", "value": {"$get": [{"$var": "ac"}, "softmax_scale"]}},
    {"name": "hd", "value": {"$idiv": [{"$var": "hidden"}, {"$var": "heads"}]}},
    {"name": "kv", "value": {"$var": "heads"}},
    {"name": "inter", "value": {"$mul": [4, {"$var": "hidden"}]}},
    {"name": "act", "value": "Gelu"},
    {"name": "norm", "value": {"kind": "Layer", "eps": {"$var": "eps"}, "gain": "W", "bias": false}},
    {"name": "qkv_bias", "value": false},
    {"name": "o_bias", "value": false},
    {"name": "abias", "value": false},
    {"name": "mbias", "value": false},
    {"name": "mlp_gated", "value": false},
    {"name": "attn_scale", "value": {"$if": [{"$ne": [{"$var": "softmax_scale"}, null]}, {"$var": "softmax_scale"}, {"$div": [1.0, {"$sqrt": {"$var": "hd"}}]}]}},
    {"name": "attn_extra", "value": {"clip_qkv": {"$var": "clip"}}},
    {"name": "l_position", "value": {"Alibi": {"$alibi": {"heads": {"$var": "heads"}, "kind": "mpt", "bias_max": 8.0}}}, "layer": true},
    {"name": "qkv_layout", "value": "FusedConcat"},
    {"name": "names", "value": {"embed": "{p}wte", "final_norm": "{p}norm_f", "lm_head": {"$if": [{"$var": "tied"}, "{p}wte", "lm_head"]}, "norm.mix": "{p}blocks.{L}.norm_1", "norm.ffn": "{p}blocks.{L}.norm_2", "attn.qkv": "{p}blocks.{L}.attn.Wqkv", "attn.o": "{p}blocks.{L}.attn.out_proj", "mlp.up": "{p}blocks.{L}.ffn.up_proj", "mlp.down": "{p}blocks.{L}.ffn.down_proj"}},
    {"name": "p", "value": "transformer."},
    {"name": "families", "value": ["C1"]},
    {"name": "model_type", "value": "mpt"}
  ]
}
