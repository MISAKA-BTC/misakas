{
  "format": "misaka.palw.model-adapter.v1",
  "id": "qwen4-exp",
  "doc": "Qwen4-Exp's text decoder (transformers' qwen4_exp_text): a COMBINATION of generic features — hyper-connections (hc_count residual streams, each block reading a gated mean of them and writing back through learned injection weights; no final norm, the last mix norms), gated delta net layers at any key:value head ratio with a silu/sigmoid output gate, sparse-block-attention layers (a token indexer over mean-pooled key blocks, a fixed-K top-k of blocks, the incomplete tail always visible) with a gated output, hashed n-gram per-layer embeddings on the layers ple_layer_ids names, and a softmax top-k MoE with a sigmoid-gated shared expert. Nothing here is specific to a model name.",
  "extends": ["qwen3-5-moe"],
  "match": {"architectures": ["Qwen4ExpForCausalLM"], "model_types": ["qwen4_exp_text"]},
  "config": {"defaults": {"vocab_size": 248320, "hidden_size": 2048, "num_hidden_layers": 40, "num_attention_heads": 16, "num_key_value_heads": 2, "head_dim": 256, "max_position_embeddings": 32768, "num_experts": 512, "num_experts_per_tok": 10, "moe_intermediate_size": 512, "shared_expert_intermediate_size": 512, "norm_topk_prob": true, "hc_count": 4, "hc_lowrank": 320, "ple_conv_kernel_size": 4, "ngram_size": 3, "heads_per_ngram": 8, "ngram_vocab_size_base": 20000000, "make_ngram_vocab_size_divisible_by": 128, "seed": 1234, "split_ngram_parts": 512}, "inert": ["number_of_conv_states", "output_router_logits", "router_aux_loss_coef", "initializer_range", "attention_dropout", "use_cache"]},
  "vars": [
    {"name": "hc", "value": {"$cfg": "hc_count"}},
    {"name": "hc_ok", "value": {"$check": [{"$gt": [{"$var": "hc"}, 1]}, {"$cat": ["Qwen4-Exp (transformers) requires hc_count > 1, got ", {"$var": "hc"}]}]}},
    {"name": "hc_rank", "value": {"$cfg": "hc_lowrank"}},
    {"name": "hc_rank_ok", "value": {"$bad": [{"$gt": [{"$var": "hc_rank"}, 0]}, "hc_lowrank must be positive"]}},
    {"name": "hyper", "value": {"streams": {"$var": "hc"}, "lowrank": {"$var": "hc_rank"}, "norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "OnePlusW", "bias": false}}},
    {"name": "final_norm", "value": null},
    {"name": "interval", "value": {"$let": ["v", {"$cfg?": "full_attention_interval"}, {"$if": [{"$ne": [{"$var": "v"}, null]}, {"$var": "v"}, 4]}]}},
    {"name": "raw_types", "value": {"$layer_types": {"n": {"$var": "n"}, "allowed": ["linear_attention", "qwen_sparse_attention", "full_attention"], "each": {"$if": [{"$ne": [{"$mod": [{"$add": [{"$var": "i"}, 1]}, {"$var": "interval"}]}, 0]}, "linear_attention", "qwen_sparse_attention"]}}}},
    {"name": "types", "value": {"$map": [{"$var": "raw_types"}, "t", {"$if": [{"$eq": [{"$var": "t"}, "full_attention"]}, "qwen_sparse_attention", {"$var": "t"}]}]}},
    {"name": "partial", "value": {"$partial_rotary": {"legacy": ["partial_rotary_factor"], "default": 1.0}}},
    {"name": "rope_dim", "value": {"$floor": {"$mul": [{"$var": "hd"}, {"$var": "partial"}]}}},
    {"name": "rope_partial", "value": {"$var": "partial"}},
    {"name": "qsa_fields", "value": [{"$cfg?": "indexer_n_heads"}, {"$cfg?": "indexer_kv_heads"}, {"$cfg?": "indexer_head_dim"}, {"$cfg?": "indexer_budget"}, {"$cfg?": "indexer_compress_ratio"}]},
    {"name": "qsa_given", "value": {"$gt": [{"$sum": {"$map": [{"$var": "qsa_fields"}, "f", {"$if": [{"$ne": [{"$var": "f"}, null]}, 1, 0]}]}}, 0]}},
    {"name": "qsa_all", "value": {"$eq": [{"$sum": {"$map": [{"$var": "qsa_fields"}, "f", {"$if": [{"$ne": [{"$var": "f"}, null]}, 1, 0]}]}}, 5]}},
    {"name": "qsa_complete_ok", "value": {"$bad": [{"$or": [{"$not": {"$var": "qsa_given"}}, {"$var": "qsa_all"}]}, "QSA config is missing required fields"]}},
    {"name": "has_sparse_layer", "value": {"$gt": [{"$sum": {"$map": [{"$var": "types"}, "t", {"$if": [{"$eq": [{"$var": "t"}, "qwen_sparse_attention"]}, 1, 0]}]}}, 0]}},
    {"name": "qsa_present_ok", "value": {"$check": [{"$or": [{"$not": {"$var": "has_sparse_layer"}}, {"$var": "qsa_all"}]}, "a sparse-attention layer needs the QSA indexer fields (indexer_n_heads, indexer_kv_heads, indexer_head_dim, indexer_budget, indexer_compress_ratio)"]}},
    {"name": "idx_heads", "lazy": true, "value": {"$index": [{"$var": "qsa_fields"}, 0]}},
    {"name": "idx_kv", "lazy": true, "value": {"$index": [{"$var": "qsa_fields"}, 1]}},
    {"name": "idx_dim", "lazy": true, "value": {"$index": [{"$var": "qsa_fields"}, 2]}},
    {"name": "idx_budget", "lazy": true, "value": {"$index": [{"$var": "qsa_fields"}, 3]}},
    {"name": "idx_ratio", "lazy": true, "value": {"$index": [{"$var": "qsa_fields"}, 4]}},
    {"name": "qsa_ok", "value": {"$if": [{"$var": "qsa_all"}, {"$let": ["_a", {"$bad": [{"$and": [{"$gt": [{"$var": "idx_heads"}, 0]}, {"$gt": [{"$var": "idx_kv"}, 0]}, {"$gt": [{"$var": "idx_dim"}, 0]}, {"$gt": [{"$var": "idx_budget"}, 0]}, {"$gt": [{"$var": "idx_ratio"}, 0]}]}, "QSA config values must be positive"]}, {"$let": ["_b", {"$bad": [{"$eq": [{"$var": "idx_kv"}, 1]}, "Qwen4-Exp QSA requires indexer_kv_heads=1"]}, {"$let": ["_c", {"$bad": [{"$eq": [{"$mod": [{"$var": "idx_budget"}, {"$var": "idx_ratio"}]}, 0]}, "indexer_budget must be divisible by indexer_compress_ratio"]}, {"$bad": [{"$le": [{"$var": "rope_dim"}, {"$var": "idx_dim"}]}, "the attention RoPE dimensions must fit the QSA index head"]}]}]}]}, true]}},
    {"name": "sparse", "value": {"$if": [{"$var": "qsa_all"}, {"index_heads": {"$var": "idx_heads"}, "index_dim": {"$var": "idx_dim"}, "ratio": {"$var": "idx_ratio"}, "top_blocks": {"$idiv": [{"$var": "idx_budget"}, {"$var": "idx_ratio"}]}, "q_norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "OnePlusW", "bias": false}, "k_norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "OnePlusW", "bias": false}}, null]}},
    {"name": "gate_name", "value": {"$let": ["g", {"$cfg?": "output_gate_type"}, {"$if": [{"$ne": [{"$var": "g"}, null]}, {"$var": "g"}, {"$cfg": "hidden_act"}]}]}},
    {"name": "gate_ok", "value": {"$check": [{"$or": [{"$eq": [{"$var": "gate_name"}, "silu"]}, {"$eq": [{"$var": "gate_name"}, "sigmoid"]}]}, {"$cat": ["Unsupported output gate activation: ", {"$var": "gate_name"}]}]}},
    {"name": "gdn", "value": {"k_heads": {"$var": "lk"}, "v_heads": {"$var": "lv"}, "k_dim": {"$var": "lkd"}, "v_dim": {"$var": "lvd"}, "conv_kernel": {"$var": "lconv"}, "head_map": "Group", "norm_eps": {"$var": "eps"}, "l2_eps": 1e-06, "gate_act": {"$if": [{"$eq": [{"$var": "gate_name"}, "sigmoid"]}, "Sigmoid", "Silu"]}}},
    {"name": "l_ffn", "value": {"Moe": {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "moe_inter"}, "act": {"$var": "act"}, "router": {"scoring": "Softmax", "normalize": {"$cfg": "norm_topk_prob"}}, "shared": {"$if": [{"$gt": [{"$var": "shared"}, 0]}, {"intermediate": {"$var": "shared"}, "sigmoid_gate": true}, null]}}}, "layer": true},
    {"name": "ple_raw", "value": {"$let": ["r", {"$cfg?": "ple_layer_ids"}, {"$if": [{"$ne": [{"$var": "r"}, null]}, {"$var": "r"}, []]}]}},
    {"name": "ple_ids", "value": {"$sort": {"$unique": {"$var": "ple_raw"}}}},
    {"name": "ple_range_ok", "value": {"$bad": [{"$eq": [{"$sum": {"$map": [{"$var": "ple_ids"}, "id", {"$if": [{"$and": [{"$ge": [{"$var": "id"}, 1]}, {"$le": [{"$var": "id"}, {"$var": "n"}]}]}, 0, 1]}]}}, 0]}, {"$cat": ["ple_layer_ids must contain one-indexed ids in [1, ", {"$var": "n"}, "], got ", {"$var": "ple_ids"}]}]}},
    {"name": "ple_linear_ok", "value": {"$check": [{"$eq": [{"$sum": {"$map": [{"$var": "ple_ids"}, "id", {"$if": [{"$and": [{"$ge": [{"$var": "id"}, 1]}, {"$le": [{"$var": "id"}, {"$var": "n"}]}]}, {"$if": [{"$eq": [{"$index": [{"$var": "types"}, {"$sub": [{"$var": "id"}, 1]}]}, "linear_attention"]}, 0, 1]}, 0]}]}}, 0]}, "Qwen4-Exp PLE is only supported on linear_attention layers"]}},
    {"name": "ngram", "value": {"$cfg": "ngram_size"}},
    {"name": "hpn", "value": {"$cfg": "heads_per_ngram"}},
    {"name": "ple_dim_raw", "value": {"$cfg?": "ple_embed_dim"}},
    {"name": "ple_dim", "value": {"$if": [{"$ne": [{"$var": "ple_dim_raw"}, null]}, {"$var": "ple_dim_raw"}, {"$var": "hidden"}]}},
    {"name": "ngram_heads", "value": {"$mul": [{"$sub": [{"$var": "ngram"}, 1]}, {"$var": "hpn"}]}},
    {"name": "eos_raw", "value": {"$cfg?": "eos_token_id"}},
    {"name": "eos", "lazy": true, "value": {"$if": [{"$is_list": {"$var": "eos_raw"}}, {"$if": [{"$gt": [{"$len": {"$var": "eos_raw"}}, 0]}, {"$index": [{"$var": "eos_raw"}, 0]}, null]}, {"$var": "eos_raw"}]}},
    {"name": "ple_checks", "value": {"$if": [{"$gt": [{"$len": {"$var": "ple_ids"}}, 0]}, {"$let": ["_a", {"$bad": [{"$and": [{"$gt": [{"$var": "ngram_heads"}, 0]}, {"$gt": [{"$var": "ple_dim"}, 0]}, {"$eq": [{"$mod": [{"$var": "ple_dim"}, {"$var": "ngram_heads"}]}, 0]}]}, {"$cat": ["ple_embed_dim and the total number of n-gram heads must be positive, and ple_embed_dim must be divisible by the number of heads: ", {"$var": "ple_dim"}, " % ", {"$var": "ngram_heads"}]}]}, {"$bad": [{"$ne": [{"$var": "eos"}, null]}, "eos_token_id must be set when Qwen4-Exp PLE layers are enabled"]}]}, true]}},
    {"name": "ple_k", "value": {"$cfg": "ple_conv_kernel_size"}},
    {"name": "ngram_base", "value": {"$cfg": "ngram_vocab_size_base"}},
    {"name": "ngram_div", "value": {"$cfg": "make_ngram_vocab_size_divisible_by"}},
    {"name": "ngram_seed", "value": {"$cfg": "seed"}},
    {"name": "ngram_parts", "value": {"$cfg": "split_ngram_parts"}},
    {"name": "ple_idx", "value": {"$find": [{"$var": "ple_ids"}, {"$add": [{"$var": "i"}, 1]}]}, "layer": true},
    {"name": "ple_i", "value": {"$if": [{"$ne": [{"$var": "ple_idx"}, null]}, {"ngram_size": {"$var": "ngram"}, "heads_per_ngram": {"$var": "hpn"}, "embed_dim": {"$var": "ple_dim"}, "conv_kernel": {"$var": "ple_k"}, "conv_dilation": {"$var": "ngram"}, "norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "OnePlusW", "bias": false}, "eos_id": {"$var": "eos"}, "seed": {"$var": "ngram_seed"}, "vocab_base": {"$var": "ngram_base"}, "vocab_divisor": {"$var": "ngram_div"}, "layer_index": {"$var": "ple_idx"}, "unigram_vocab": {"$var": "vocab"}}, null]}, "layer": true},
    {"name": "l_residual", "value": {"HyperConnection": {"ple": {"$var": "ple_i"}}}, "layer": true},
    {"name": "is_lin", "value": {"$eq": [{"$index": [{"$var": "types"}, {"$var": "i"}]}, "linear_attention"]}, "layer": true},
    {"name": "l_mixer", "value": {"$if": [{"$var": "is_lin"}, {"GatedDeltaNet": {"$var": "gdn"}}, {"Attention": {"heads": {"$var": "heads"}, "kv_heads": {"$var": "kv"}, "head_dim": {"$var": "hd"}, "v_head_dim": {"$var": "hd"}, "q_bias": {"$var": "abias"}, "k_bias": {"$var": "abias"}, "v_bias": {"$var": "abias"}, "o_bias": {"$var": "abias"}, "qk_norm": {"$var": "qk_norm"}, "position": {"Rope": {"$var": "rope"}}, "scale": {"$var": "attn_scale"}, "output_gate": true, "sparse": {"$var": "sparse"}}}]}, "layer": true},
    {"name": "names_more", "value": {"hc.mix.norm": "{p}layers.{L}.attn_hyper_connection.hc_norm", "hc.mix.down": "{p}layers.{L}.attn_hyper_connection.input_mix_weight_down", "hc.mix.up": "{p}layers.{L}.attn_hyper_connection.input_mix_weight_up", "hc.mix.inject": "{p}layers.{L}.attn_hyper_connection.block_inject_weight", "hc.ffn.norm": "{p}layers.{L}.mlp_hyper_connection.hc_norm", "hc.ffn.down": "{p}layers.{L}.mlp_hyper_connection.input_mix_weight_down", "hc.ffn.up": "{p}layers.{L}.mlp_hyper_connection.input_mix_weight_up", "hc.ffn.inject": "{p}layers.{L}.mlp_hyper_connection.block_inject_weight", "hc.final.norm": "{p}hyper_connection_mixer.hc_norm", "hc.final.down": "{p}hyper_connection_mixer.input_mix_weight_down", "hc.final.up": "{p}hyper_connection_mixer.input_mix_weight_up", "attn.idx.qk": "{p}layers.{L}.self_attn.indexer.index_qk_proj", "attn.idx.q_norm": "{p}layers.{L}.self_attn.indexer.q_layernorm", "attn.idx.k_norm": "{p}layers.{L}.self_attn.indexer.k_layernorm", "ple.key": "{p}layers.{L}.ple.key_proj", "ple.value": "{p}layers.{L}.ple.value_proj", "ple.norm_key": "{p}layers.{L}.ple.norm_key", "ple.norm_query": "{p}layers.{L}.ple.norm_query", "ple.norm_conv": "{p}layers.{L}.ple.norm_conv", "ple.conv": "{p}layers.{L}.ple.conv1d", "ple.table": "{p}layers.{L}.ple.ple_embedding.ngram_embedding.shard_{S}"}},
    {"name": "table_shards", "value": {"$if": [{"$gt": [{"$len": {"$var": "ple_ids"}}, 0]}, {"$var": "ngram_parts"}, 1]}},
    {"name": "families", "value": ["C3", "C4", "C7", "C9"]},
    {"name": "model_type", "value": "qwen4_exp_text"}
  ]
}
