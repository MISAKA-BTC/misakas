{
  "format": "misaka.palw.model-adapter.v1",
  "id": "gptj",
  "doc": "GPT-J: interleaved rotary on the first rotary_dim dims (plain, theta 10000), one LayerNorm feeding a parallel attention+MLP, biased LM head.",
  "extends": ["standard-decoder"],
  "match": {"architectures": ["GPTJForCausalLM"], "model_types": ["gptj"]},
  "config": {"defaults": {"vocab_size": 50400, "activation_function": "gelu_new", "layer_norm_epsilon": 1e-05, "tie_word_embeddings": false, "rotary_dim": 64}},
  "vars": [
    {"name": "hidden", "value": {"$alias": [["n_embd", "hidden_size"], 4096]}},
    {"name": "n", "value": {"$alias": [["n_layer", "num_hidden_layers"], 28]}},
    {"name": "heads", "value": {"$alias": [["n_head", "num_attention_heads"], 16]}},
    {"name": "n_pos", "value": {"$alias": [["n_positions", "max_position_embeddings"], 2048]}},
    {"name": "max_pos", "value": {"$var": "n_pos"}},
    {"name": "inter", "value": {"$let": ["i", {"$cfg?": "n_inner"}, {"$if": [{"$ne": [{"$var": "i"}, null]}, {"$var": "i"}, {"$mul": [4, {"$var": "hidden"}]}]}]}},
    {"name": "act", "value": {"$act": {"$cfg": "activation_function"}}},
    {"name": "eps", "value": {"$cfg": "layer_norm_epsilon"}},
    {"name": "hd", "value": {"$idiv": [{"$var": "hidden"}, {"$var": "heads"}]}},
    {"name": "kv", "value": {"$var": "heads"}},
    {"name": "rd", "value": {"$let": ["r", {"$cfgn": "rotary_dim"}, {"$if": [{"$ne": [{"$var": "r"}, null]}, {"$var": "r"}, {"$var": "hd"}]}]}},
    {"name": "chk1", "value": {"$require_eq": ["rotary", true, "GPT-J always uses rotary positions"]}},
    {"name": "chk2", "value": {"$require_eq": ["scale_attn_weights", true, "GPT-J always scales by 1/sqrt(d)"]}},
    {"name": "rope", "value": {"$rope_plain": {"dim": {"$var": "rd"}, "theta": 10000.0, "style": "Interleaved"}}},
    {"name": "norm", "value": {"kind": "Layer", "eps": {"$var": "eps"}, "gain": "W", "bias": true}},
    {"name": "abias", "value": false},
    {"name": "mbias", "value": true},
    {"name": "mlp_gated", "value": false},
    {"name": "residual", "value": {"Parallel": {"norm": {"$var": "norm"}, "ffn_norm": null}}},
    {"name": "head", "value": {"tied": {"$var": "tied"}, "bias": true}},
    {"name": "names", "value": {"embed": "{p}wte", "final_norm": "{p}ln_f", "lm_head": {"$if": [{"$var": "tied"}, "{p}wte", "lm_head"]}, "norm.mix": "{p}h.{L}.ln_1", "attn.q": "{p}h.{L}.attn.q_proj", "attn.k": "{p}h.{L}.attn.k_proj", "attn.v": "{p}h.{L}.attn.v_proj", "attn.o": "{p}h.{L}.attn.out_proj", "mlp.up": "{p}h.{L}.mlp.fc_in", "mlp.down": "{p}h.{L}.mlp.fc_out", "lm_head_bias": "lm_head.bias"}},
    {"name": "p", "value": "transformer."},
    {"name": "families", "value": ["C1"]},
    {"name": "model_type", "value": "gptj"}
  ]
}
