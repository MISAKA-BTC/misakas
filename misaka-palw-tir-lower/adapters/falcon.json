{
  "format": "misaka.palw.model-adapter.v1",
  "id": "falcon",
  "doc": "Falcon (7B MQA-parallel, 40B/180B new decoder with kv groups, RW-1B ALiBi) and the legacy RWForCausalLM remote-code configs read through FalconConfig's aliases.",
  "extends": ["decoder-core"],
  "match": {"architectures": ["FalconForCausalLM", "RWForCausalLM"], "model_types": ["falcon", "RefinedWebModel", "RefinedWeb"]},
  "remote_code": ["modelling_RW.RWForCausalLM", "modeling_RW.RWForCausalLM", "modeling_falcon.FalconForCausalLM"],
  "remote_code_required": ["RWForCausalLM"],
  "config": {"defaults": {"vocab_size": 65024, "hidden_size": 4544, "max_position_embeddings": 2048, "layer_norm_epsilon": 1e-05, "tie_word_embeddings": true, "new_decoder_architecture": false, "multi_query": true, "parallel_attn": true, "bias": false, "alibi": false, "activation": "gelu"}, "inert": ["head_dim"]},
  "vars": [
    {"name": "n", "value": {"$alias": [["num_hidden_layers", "n_layer"], 32]}},
    {"name": "heads", "value": {"$alias": [["num_attention_heads", "n_head"], 71]}},
    {"name": "kv_cfg", "value": {"$alias": [["num_kv_heads", "n_head_kv"], {"$var": "heads"}]}},
    {"name": "new_arch", "value": {"$cfg": "new_decoder_architecture"}},
    {"name": "mq", "value": {"$cfg": "multi_query"}},
    {"name": "parallel", "value": {"$cfg": "parallel_attn"}},
    {"name": "bias", "value": {"$cfg": "bias"}},
    {"name": "alibi", "value": {"$cfg": "alibi"}},
    {"name": "eps", "value": {"$cfg": "layer_norm_epsilon"}},
    {"name": "ffn", "value": {"$let": ["f", {"$cfg?": "ffn_hidden_size"}, {"$if": [{"$ne": [{"$var": "f"}, null]}, {"$var": "f"}, {"$mul": [4, {"$var": "hidden"}]}]}]}},
    {"name": "inter", "value": {"$var": "ffn"}},
    {"name": "act", "value": {"$act": {"$cfg": "activation"}}},
    {"name": "n_ln", "value": {"$cfg?": "num_ln_in_parallel_attn"}},
    {"name": "chk1", "value": {"$let": ["_", {"$forbid": ["apply_residual_connection_post_layernorm", "RW post-LN residual variant is not modelled"]}, false]}},
    {"name": "div_ok", "value": {"$bad": [{"$eq": [{"$mod": [{"$var": "hidden"}, {"$var": "heads"}]}, 0]}, "hidden not divisible by heads"]}},
    {"name": "hd", "value": {"$idiv": [{"$var": "hidden"}, {"$var": "heads"}]}},
    {"name": "mha_ok", "value": {"$check": [{"$or": [{"$var": "new_arch"}, {"$var": "mq"}, {"$eq": [{"$var": "kv_cfg"}, {"$var": "heads"}]}]}, "MHA with num_kv_heads ≠ heads"]}},
    {"name": "kv", "value": {"$if": [{"$var": "new_arch"}, {"$var": "kv_cfg"}, {"$if": [{"$var": "mq"}, 1, {"$var": "heads"}]}]}},
    {"name": "kv_ok", "value": {"$bad": [{"$eq": [{"$mod": [{"$var": "heads"}, {"$var": "kv"}]}, 0]}, "heads not a multiple of kv heads"]}},
    {"name": "qkv_layout", "value": {"$if": [{"$var": "new_arch"}, "FusedPerKvGroup", {"$if": [{"$var": "mq"}, "FusedConcat", "FusedPerHead"]}]}},
    {"name": "rope_inert", "value": {"$if": [{"$var": "alibi"}, {"$let": ["_", {"$cfg?": "rope_theta"}, {"$let": ["_", {"$cfg?": "rope_scaling"}, {"$cfg?": "rope_parameters"}]}]}, null]}},
    {"name": "rope", "lazy": true, "value": {"$if": [{"$var": "alibi"}, null, {"$rope": {"dim": {"$var": "hd"}, "theta": 10000.0, "max_pos": {"$var": "max_pos"}}}]}},
    {"name": "l_position", "value": {"$if": [{"$var": "alibi"}, {"Alibi": {"$alibi": {"heads": {"$var": "heads"}, "kind": "bloom", "scaled_by_softmax_scale": true, "bf16_bias": true}}}, {"Rope": {"$var": "rope"}}]}, "layer": true},
    {"name": "norm", "value": {"kind": "Layer", "eps": {"$var": "eps"}, "gain": "W", "bias": true}},
    {"name": "qkv_bias", "value": {"$var": "bias"}},
    {"name": "o_bias", "value": {"$var": "bias"}},
    {"name": "abias", "value": {"$var": "bias"}},
    {"name": "mbias", "value": {"$var": "bias"}},
    {"name": "mlp_gated", "value": false},
    {"name": "ln_n", "value": {"$if": [{"$var": "new_arch"}, {"$if": [{"$eq": [{"$var": "n_ln"}, null]}, 2, {"$var": "n_ln"}]}, 0]}},
    {"name": "ln_ok", "value": {"$check": [{"$or": [{"$not": {"$var": "new_arch"}}, {"$eq": [{"$var": "ln_n"}, 1]}, {"$eq": [{"$var": "ln_n"}, 2]}]}, {"$cat": ["num_ln_in_parallel_attn=", {"$var": "ln_n"}]}]}},
    {"name": "residual", "value": {"$if": [{"$var": "new_arch"}, {"$if": [{"$eq": [{"$var": "ln_n"}, 2]}, {"Parallel": {"norm": {"$var": "norm"}, "ffn_norm": {"$var": "norm"}}}, {"Parallel": {"norm": {"$var": "norm"}, "ffn_norm": null}}]}, {"$if": [{"$var": "parallel"}, {"Parallel": {"norm": {"$var": "norm"}, "ffn_norm": null}}, {"Sequential": {"pre_mixer": {"$var": "norm"}, "post_mixer": null, "pre_ffn": {"$var": "norm"}, "post_ffn": null, "multiplier": 1.0}}]}]}},
    {"name": "two_ln", "value": {"$and": [{"$var": "new_arch"}, {"$eq": [{"$var": "ln_n"}, 2]}]}},
    {"name": "names", "value": {"embed": "{p}word_embeddings", "final_norm": "{p}ln_f", "lm_head": {"$if": [{"$var": "tied"}, "{p}word_embeddings", "lm_head"]}, "norm.mix": {"$if": [{"$var": "two_ln"}, "{p}h.{L}.ln_attn", "{p}h.{L}.input_layernorm"]}, "norm.ffn": {"$if": [{"$var": "two_ln"}, "{p}h.{L}.ln_mlp", "{p}h.{L}.post_attention_layernorm"]}, "attn.qkv": "{p}h.{L}.self_attention.query_key_value", "attn.o": "{p}h.{L}.self_attention.dense", "mlp.up": "{p}h.{L}.mlp.dense_h_to_4h", "mlp.down": "{p}h.{L}.mlp.dense_4h_to_h"}},
    {"name": "p", "value": "transformer."},
    {"name": "families", "value": ["C1", "C2"]},
    {"name": "model_type", "value": "falcon"}
  ],
  "spec": {"confidence": {"$if": [{"$eq": [{"$var": "arch"}, "RWForCausalLM"]}, {"Unsure": ["RWForCausalLM (legacy remote code) read through FalconConfig's aliases"]}, "Known"]}}
}
