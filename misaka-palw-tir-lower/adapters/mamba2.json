{
  "format": "misaka.palw.model-adapter.v1",
  "id": "mamba2",
  "doc": "Mamba-2: SSD heads with grouped B/C, the gate applied BEFORE a full-width RMSNorm (transformers 5's MambaRMSNormGated); a non-default time_step_limit is refused (HF's prefill and decode paths disagree).",
  "extends": ["spec-frame"],
  "match": {"architectures": ["Mamba2ForCausalLM"], "model_types": ["mamba2"]},
  "config": {"defaults": {"vocab_size": 32768, "hidden_size": 4096, "num_hidden_layers": 64, "num_heads": 128, "head_dim": 64, "state_size": 128, "expand": 2, "conv_kernel": 4, "n_groups": 8, "layer_norm_epsilon": 1e-05, "use_bias": false, "use_conv_bias": true, "tie_word_embeddings": false, "hidden_act": "silu"}, "inert": ["time_step_init_scheme", "time_step_scale", "time_step_rank", "time_step_min", "time_step_max", "time_step_floor", "rescale_prenorm_residual", "residual_in_fp32", "chunk_size", "use_associative_scan"]},
  "vars": [
    {"name": "vocab", "value": {"$cfg": "vocab_size"}},
    {"name": "hidden", "value": {"$cfg": "hidden_size"}},
    {"name": "n", "value": {"$cfg": "num_hidden_layers"}},
    {"name": "heads_n", "value": {"$cfg": "num_heads"}},
    {"name": "head_dim", "value": {"$cfg": "head_dim"}},
    {"name": "state", "value": {"$cfg": "state_size"}},
    {"name": "expand", "value": {"$cfg": "expand"}},
    {"name": "conv", "value": {"$cfg": "conv_kernel"}},
    {"name": "groups", "value": {"$cfg": "n_groups"}},
    {"name": "eps", "value": {"$cfg": "layer_norm_epsilon"}},
    {"name": "bias", "value": {"$cfg": "use_bias"}},
    {"name": "conv_bias", "value": {"$cfg": "use_conv_bias"}},
    {"name": "tied", "value": {"$cfg": "tie_word_embeddings"}},
    {"name": "act_name", "value": {"$cfg": "hidden_act"}},
    {"name": "act_ok", "value": {"$check": [{"$or": [{"$eq": [{"$var": "act_name"}, "silu"]}, {"$eq": [{"$var": "act_name"}, "swish"]}]}, {"$cat": ["hidden_act ", {"$var": "act_name"}]}]}},
    {"name": "rms_ok", "value": {"$require_eq": ["rms_norm", true, "Mamba2Mixer always applies the gated RMSNorm"]}},
    {"name": "nbg_ok", "value": {"$let": ["_", {"$forbid": ["norm_before_gate", "transformers' Mamba2 gates before the norm"]}, false]}},
    {"name": "tsl", "value": {"$cfg?": "time_step_limit"}},
    {"name": "dt_min", "value": {"$if": [{"$ne": [{"$var": "tsl"}, null]}, {"$let": ["a", {"$index": [{"$var": "tsl"}, 0]}, {"$if": [{"$is_num": {"$var": "a"}}, {"$var": "a"}, 0.0]}]}, 0.0]}},
    {"name": "dt_max", "value": {"$if": [{"$ne": [{"$var": "tsl"}, null]}, {"$let": ["b", {"$index": [{"$var": "tsl"}, 1]}, {"$if": [{"$is_num": {"$var": "b"}}, {"$var": "b"}, 1.7976931348623157e+308]}]}, 1.7976931348623157e+308]}},
    {"name": "tsl_ok", "value": {"$check": [{"$and": [{"$le": [{"$var": "dt_min"}, 0.0]}, {"$ge": [{"$var": "dt_max"}, 1e+300]}]}, "non-default time_step_limit (HF's prefill and decode paths disagree)"]}},
    {"name": "inner", "value": {"$mul": [{"$var": "expand"}, {"$var": "hidden"}]}},
    {"name": "inner_ok", "value": {"$bad": [{"$eq": [{"$mul": [{"$var": "heads_n"}, {"$var": "head_dim"}]}, {"$var": "inner"}]}, "num_heads·head_dim ≠ expand·hidden"]}},
    {"name": "groups_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "groups"}, 0]}, {"$eq": [{"$mod": [{"$var": "heads_n"}, {"$var": "groups"}]}, 0]}]}, "heads not a multiple of n_groups"]}},
    {"name": "norm", "value": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}},
    {"name": "l_mixer", "value": {"Mamba2": {"heads": {"$var": "heads_n"}, "head_dim": {"$var": "head_dim"}, "groups": {"$var": "groups"}, "state": {"$var": "state"}, "conv_kernel": {"$var": "conv"}, "conv_bias": {"$var": "conv_bias"}, "proj_bias": {"$var": "bias"}, "norm_eps": {"$var": "eps"}, "norm_groups": 1, "dt_min": 0.0, "dt_max": null, "d_mlp": 0}}, "layer": true},
    {"name": "l_ffn", "value": "None", "layer": true},
    {"name": "l_residual", "value": {"Sequential": {"pre_mixer": {"$var": "norm"}, "post_mixer": null, "pre_ffn": null, "post_ffn": null, "multiplier": 1.0}}, "layer": true},
    {"name": "final_norm", "value": {"$var": "norm"}},
    {"name": "names", "value": {"embed": "backbone.embeddings", "final_norm": "backbone.norm_f", "norm.mix": "backbone.layers.{L}.norm", "mamba.in": "backbone.layers.{L}.mixer.in_proj", "mamba.conv": "backbone.layers.{L}.mixer.conv1d", "mamba.x": "backbone.layers.{L}.mixer.x_proj", "mamba.dt": "backbone.layers.{L}.mixer.dt_proj", "mamba.A_log": "backbone.layers.{L}.mixer.A_log", "mamba.D": "backbone.layers.{L}.mixer.D", "mamba.out": "backbone.layers.{L}.mixer.out_proj", "mamba2.in": "backbone.layers.{L}.mixer.in_proj", "mamba2.conv": "backbone.layers.{L}.mixer.conv1d", "mamba2.dt_bias": "backbone.layers.{L}.mixer.dt_bias", "mamba2.A_log": "backbone.layers.{L}.mixer.A_log", "mamba2.D": "backbone.layers.{L}.mixer.D", "mamba2.norm": "backbone.layers.{L}.mixer.norm", "mamba2.out": "backbone.layers.{L}.mixer.out_proj", "lm_head": {"$if": [{"$var": "tied"}, "backbone.embeddings", "lm_head"]}}},
    {"name": "families", "value": ["C5"]},
    {"name": "model_type", "value": "mamba2"}
  ]
}
