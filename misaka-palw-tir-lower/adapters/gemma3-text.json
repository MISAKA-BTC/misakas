{
  "format": "misaka.palw.model-adapter.v1",
  "id": "gemma3-text",
  "doc": "Gemma-3's text decoder: Gemma-2's sandwich norms with a per-head shared (1+w) QK-norm, 5:1 sliding/global, local and global rope (theta rope_local_base_freq / rope_parameters per layer type) and optional soft-caps.",
  "extends": ["standard-decoder", "mixin-gemma"],
  "match": {"architectures": ["Gemma3ForCausalLM"], "model_types": ["gemma3_text"]},
  "config": {"defaults": {"vocab_size": 262208, "hidden_size": 2304, "intermediate_size": 9216, "num_hidden_layers": 26, "num_attention_heads": 8, "num_key_value_heads": 4, "max_position_embeddings": 131072, "hidden_activation": "gelu_pytorch_tanh", "query_pre_attn_scalar": 256.0, "sliding_window": 4096, "rope_local_base_freq": 10000.0}, "inert": ["cache_implementation"]},
  "vars": [
    {"name": "act_name", "value": {"$cfg": "hidden_activation"}},
    {"name": "act_other", "value": {"$cfg?": "hidden_act"}},
    {"name": "act", "value": {"$act": {"$var": "act_name"}}},
    {"name": "act_note", "value": {"$if": [{"$and": [{"$ne": [{"$var": "act_other"}, null]}, {"$ne": [{"$var": "act_other"}, {"$var": "act_name"}]}]}, {"Unsure": [{"$cat": ["Gemma: `", "hidden_activation", "`=", {"$var": "act_name"}, " is used (transformers 5); `", "hidden_act", "`=", {"$var": "act_other"}, " disagrees and older transformers may have used it"]}]}, "Known"]}},
    {"name": "qpas", "value": {"$cfg": "query_pre_attn_scalar"}},
    {"name": "attn_scale", "value": {"$div": [1.0, {"$sqrt": {"$var": "qpas"}}]}},
    {"name": "sw", "value": {"$cfgn": "sliding_window"}},
    {"name": "final_cap", "value": {"$cfg?": "final_logit_softcapping"}},
    {"name": "attn_cap", "value": {"$cfg?": "attn_logit_softcapping"}},
    {"name": "local_theta", "value": {"$cfg": "rope_local_base_freq"}},
    {"name": "pattern", "value": {"$let": ["a", {"$cfg?": "sliding_window_pattern"}, {"$let": ["b", {"$cfg?": "_sliding_window_pattern"}, {"$if": [{"$ne": [{"$var": "a"}, null]}, {"$var": "a"}, {"$if": [{"$ne": [{"$var": "b"}, null]}, {"$var": "b"}, 6]}]}]}]}},
    {"name": "types", "value": {"$layer_types": {"n": {"$var": "n"}, "allowed": ["full_attention", "sliding_attention"], "each": {"$if": [{"$ne": [{"$mod": [{"$add": [{"$var": "i"}, 1]}, {"$var": "pattern"}]}, 0]}, "sliding_attention", "full_attention"]}}}},
    {"name": "keyed", "value": {"$has": "rope_parameters"}},
    {"name": "rope", "value": {"$if": [{"$var": "keyed"}, {"$rope": {"dim": {"$var": "hd"}, "theta": 1000000.0, "layer_type": "full_attention", "max_pos": {"$var": "max_pos"}}}, {"$rope": {"dim": {"$var": "hd"}, "theta": 1000000.0, "max_pos": {"$var": "max_pos"}}}]}},
    {"name": "rope_local", "value": {"$if": [{"$var": "keyed"}, {"$rope": {"dim": {"$var": "hd"}, "theta": {"$var": "local_theta"}, "layer_type": "sliding_attention", "max_pos": {"$var": "max_pos"}}}, {"$rope_plain": {"dim": {"$var": "hd"}, "theta": {"$var": "local_theta"}}}]}},
    {"name": "l_position", "value": {"Rope": {"$if": [{"$eq": [{"$index": [{"$var": "types"}, {"$var": "i"}]}, "sliding_attention"]}, {"$var": "rope_local"}, {"$var": "rope"}]}}, "layer": true},
    {"name": "qk_norm", "value": {"norm": {"$var": "norm"}, "scope": "PerHeadShared"}},
    {"name": "attn_extra", "value": {"softcap": {"$var": "attn_cap"}}},
    {"name": "residual", "value": {"Sequential": {"pre_mixer": {"$var": "norm"}, "post_mixer": {"$var": "norm"}, "pre_ffn": {"$var": "norm"}, "post_ffn": {"$var": "norm"}, "multiplier": 1.0}}},
    {"name": "head", "value": {"tied": {"$var": "tied"}, "softcap": {"$var": "final_cap"}}},
    {"name": "names", "value": {"$merge": [{"$var": "names_base"}, {"norm.post_mix": "{p}layers.{L}.post_attention_layernorm", "norm.ffn": "{p}layers.{L}.pre_feedforward_layernorm", "norm.post_ffn": "{p}layers.{L}.post_feedforward_layernorm"}]}},
    {"name": "families", "value": ["C1", "C2"]},
    {"name": "model_type", "value": "gemma3_text"}
  ],
  "spec": {"confidence": {"$var": "act_note"}}
}
