{
  "format": "misaka.palw.model-adapter.v1",
  "id": "mixin-vlm",
  "doc": "A mixin: the TEXT DECODER of a vision-language model, read alone (text-only prompts): the decoder's config lives in text_config, its tensors under a prefix; the vision tower, projector and image tokens are not lowered; the wrapper's tie_word_embeddings decides tying (LLaVA: or the text config's own).",
  "config": {"decoder": "text_config", "inert": ["model_type"], "root_inert": ["vision_config", "mm_tokens_per_image", "boi_token_index", "eoi_token_index", "image_token_index", "image_token_id", "vision_feature_layer", "vision_feature_select_strategy", "projector_hidden_act", "multimodal_projector_bias", "image_seq_length", "spatial_merge_size", "vision_tower_config", "ignore_index", "video_token_id", "video_token_index", "vision_start_token_id", "vision_end_token_id", "vocab_size"]},
  "vars": [
    {"name": "p", "value": "language_model.model."},
    {"name": "lm_head_name", "value": "language_model.lm_head"},
    {"name": "prefix_aliases", "value": [["language_model.model.", "model.language_model."], ["language_model.lm_head", "lm_head"]]},
    {"name": "ignored_prefixes", "value": ["vision_tower.", "vision_model.", "model.vision_model.", "multi_modal_projector.", "model.vision_tower.", "model.multi_modal_projector.", "model.visual.", "visual.", "mtp."]},
    {"name": "tie_rule", "value": {"$switch": [{"$var": "arch"}, {"LlavaForConditionalGeneration": "llava", "Gemma3ForConditionalGeneration": "true", "Mistral3ForConditionalGeneration": "true"}, "false"]}},
    {"name": "tied", "value": {"$let": ["tt", {"$cfg": "tie_word_embeddings"}, {"$let": ["rt", {"$root": "tie_word_embeddings"}, {"$switch": [{"$var": "tie_rule"}, {"llava": {"$or": [{"$if": [{"$ne": [{"$var": "rt"}, null]}, {"$var": "rt"}, false]}, {"$var": "tt"}]}, "true": {"$if": [{"$ne": [{"$var": "rt"}, null]}, {"$var": "rt"}, true]}}, {"$if": [{"$ne": [{"$var": "rt"}, null]}, {"$var": "rt"}, false]}]}]}]}}
  ]
}
