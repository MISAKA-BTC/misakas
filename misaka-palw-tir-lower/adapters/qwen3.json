{
  "format": "misaka.palw.model-adapter.v1",
  "id": "qwen3",
  "doc": "Qwen3: Qwen2's window, attention_bias on all four projections (default off), a per-head shared RMS norm on q and k, head_dim 128 by default.",
  "extends": ["decoder-core", "mixin-qwen-sliding"],
  "match": {"architectures": ["Qwen3ForCausalLM"], "model_types": ["qwen3"]},
  "config": {
    "defaults": {"vocab_size": 151936, "intermediate_size": 22016, "num_key_value_heads": 32, "max_position_embeddings": 32768, "head_dim": 128}
  },
  "vars": [
    {"name": "mbias", "value": {"$let": ["_", {"$forbid": ["mlp_bias", "Qwen3MLP has no biases"]}, false]}},
    {"name": "qk_norm", "value": {"norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}, "scope": "PerHeadShared"}},
    {"name": "model_type", "value": "qwen3"}
  ]
}
