{
  "format": "misaka.palw.model-adapter.v1",
  "id": "standard-decoder",
  "doc": "The standard decoder-only transformer: pre-norm RMS residual blocks of grouped-query attention (rotary positions) and a gated MLP, read from the standard Hugging Face keys (hidden_size, num_attention_heads, num_key_value_heads, head_dim, intermediate_size, hidden_act, rms_norm_eps, rope_theta / rope_scaling / rope_parameters, max_position_embeddings, tie_word_embeddings, attention_bias, mlp_bias, sliding_window + layer_types). Level A uses it as it stands; every adapter extends it and overrides the variables its class differs in. The hooks are the variables: norm, residual, embedding, head, names and the per-layer l_mixer / l_ffn / l_residual / l_window / l_position.",
  "config": {
    "defaults": {
      "vocab_size": 32000,
      "hidden_size": 4096,
      "intermediate_size": 11008,
      "num_hidden_layers": 32,
      "num_attention_heads": 32,
      "max_position_embeddings": 2048,
      "rms_norm_eps": 1e-06,
      "tie_word_embeddings": false,
      "hidden_act": "silu",
      "attention_bias": false,
      "mlp_bias": false
    },
    "inert": ["pretraining_tp"]
  },
  "vars": [
    {"name": "p", "value": {"$tensor_prefix": {"candidates": ["model.", "model.language_model.", "language_model.model.", ""], "probe": "embed_tokens.weight", "default": "model."}}},
    {"name": "vocab", "value": {"$cfg": "vocab_size"}},
    {"name": "hidden", "value": {"$cfg": "hidden_size"}},
    {"name": "inter", "value": {"$cfg": "intermediate_size"}},
    {"name": "n", "value": {"$cfg": "num_hidden_layers"}},
    {"name": "heads", "value": {"$cfg": "num_attention_heads"}},
    {"name": "kv", "value": {"$cfg": ["num_key_value_heads", {"$var": "heads"}]}},
    {"name": "hd", "value": {"$cfg": ["head_dim", {"$idiv": [{"$var": "hidden"}, {"$var": "heads"}]}]}},
    {"name": "dims_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "heads"}, 0]}, {"$gt": [{"$var": "kv"}, 0]}, {"$eq": [{"$mod": [{"$var": "heads"}, {"$var": "kv"}]}, 0]}, {"$or": [{"$has": "head_dim"}, {"$eq": [{"$mod": [{"$var": "hidden"}, {"$var": "heads"}]}, 0]}]}]}, "heads, kv heads and head dim are inconsistent"]}},
    {"name": "act", "value": {"$act": {"$cfg": "hidden_act"}}},
    {"name": "max_pos", "value": {"$cfg": "max_position_embeddings"}},
    {"name": "eps", "value": {"$cfg": "rms_norm_eps"}},
    {"name": "tied", "value": {"$cfg": "tie_word_embeddings"}},
    {"name": "abias", "value": {"$cfg": "attention_bias"}},
    {"name": "mbias", "value": {"$cfg": "mlp_bias"}},
    {"name": "qkv_bias", "value": {"$var": "abias"}},
    {"name": "o_bias", "value": {"$var": "abias"}},
    {"name": "rope_theta", "value": 10000.0},
    {"name": "rope_dim", "value": {"$var": "hd"}},
    {"name": "rope_partial", "value": 1.0},
    {"name": "rope_style", "value": "Half"},
    {"name": "q_scaled", "value": false},
    {"name": "rope", "value": {"$rope": {"dim": {"$var": "rope_dim"}, "style": {"$var": "rope_style"}, "theta": {"$var": "rope_theta"}, "partial": {"$var": "rope_partial"}, "max_pos": {"$var": "max_pos"}, "q_scaled": {"$var": "q_scaled"}}}},
    {"name": "q_temperature", "value": null},
    {"name": "sw", "value": null},
    {"name": "types", "value": {"$repeat": ["full_attention", {"$var": "n"}]}},
    {"name": "norm", "value": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}},
    {"name": "qk_norm", "value": null},
    {"name": "attn_scale", "value": {"$div": [1.0, {"$sqrt": {"$var": "hd"}}]}},
    {"name": "res_mult", "value": 1.0},
    {"name": "emb_scale", "value": 1.0},
    {"name": "logit_scale", "value": 1.0},
    {"name": "pre_scale", "value": 1.0},
    {"name": "residual", "value": {"Sequential": {"pre_mixer": {"$var": "norm"}, "pre_ffn": {"$var": "norm"}, "multiplier": {"$var": "res_mult"}}}},
    {"name": "embedding", "value": {"dim": {"$var": "hidden"}, "scale": {"$var": "emb_scale"}}},
    {"name": "head", "value": {"tied": {"$var": "tied"}, "logit_scale": {"$var": "logit_scale"}, "pre_scale": {"$var": "pre_scale"}}},
    {"name": "final_norm", "value": {"$var": "norm"}},
    {"name": "qkv_layout", "value": "Separate"},
    {"name": "mlp_layout", "value": "Separate"},
    {"name": "experts_layout", "value": "Separate"},
    {"name": "names", "value": {"$var": "names_base"}},
    {"name": "names_base", "value": {
        "embed": "{p}embed_tokens",
        "final_norm": "{p}norm",
        "lm_head": {"$if": [{"$var": "tied"}, {"$cat": [{"$var": "p"}, "embed_tokens"]}, "lm_head"]},
        "norm.mix": "{p}layers.{L}.input_layernorm",
        "norm.ffn": "{p}layers.{L}.post_attention_layernorm",
        "attn.q": "{p}layers.{L}.self_attn.q_proj",
        "attn.k": "{p}layers.{L}.self_attn.k_proj",
        "attn.v": "{p}layers.{L}.self_attn.v_proj",
        "attn.o": "{p}layers.{L}.self_attn.o_proj",
        "attn.q_norm": "{p}layers.{L}.self_attn.q_norm",
        "attn.k_norm": "{p}layers.{L}.self_attn.k_norm",
        "mlp.gate": "{p}layers.{L}.mlp.gate_proj",
        "mlp.up": "{p}layers.{L}.mlp.up_proj",
        "mlp.down": "{p}layers.{L}.mlp.down_proj"
    }},
    {"name": "prefix_aliases", "value": []},
    {"name": "ignored_prefixes", "value": []},
    {"name": "l_window", "layer": true, "value": {"$if": [{"$eq": [{"$index": [{"$var": "types"}, {"$var": "i"}]}, "sliding_attention"]}, {"$var": "sw"}, null]}},
    {"name": "l_position", "layer": true, "value": {"Rope": {"$var": "rope"}}},
    {"name": "attn_extra", "value": {}},
    {"name": "l_mixer", "layer": true, "value": {"Attention": {"$merge": [{
        "heads": {"$var": "heads"},
        "kv_heads": {"$var": "kv"},
        "head_dim": {"$var": "hd"},
        "v_head_dim": {"$var": "hd"},
        "q_bias": {"$var": "qkv_bias"},
        "k_bias": {"$var": "qkv_bias"},
        "v_bias": {"$var": "qkv_bias"},
        "o_bias": {"$var": "o_bias"},
        "qk_norm": {"$var": "qk_norm"},
        "position": {"$var": "l_position"},
        "scale": {"$var": "attn_scale"},
        "window": {"$var": "l_window"},
        "q_temperature": {"$var": "q_temperature"}
    }, {"$var": "attn_extra"}]}}},
    {"name": "mlp_gated", "value": true},
    {"name": "l_ffn", "layer": true, "value": {"Mlp": {"intermediate": {"$var": "inter"}, "act": {"$var": "act"}, "gated": {"$var": "mlp_gated"}, "up_bias": {"$var": "mbias"}, "down_bias": {"$var": "mbias"}}}},
    {"name": "l_residual", "layer": true, "value": {"$var": "residual"}},
    {"name": "model_type", "value": "llama"},
    {"name": "families", "value": {"$if": [{"$ne": [{"$var": "sw"}, null]}, ["C1", "C2"], ["C1"]]}}
  ],
  "spec": {
    "architecture": {"$var": "arch"},
    "model_type": {"$var": "model_type"},
    "families": {"$var": "families"},
    "vocab_size": {"$var": "vocab"},
    "hidden_size": {"$var": "hidden"},
    "max_position_embeddings": {"$var": "max_pos"},
    "embedding": {"$var": "embedding"},
    "layers": {"$layers": {"count": {"$var": "n"}, "each": {
      "mixer": {"$var": "l_mixer"},
      "ffn": {"$var": "l_ffn"},
      "residual": {"$var": "l_residual"}
    }}},
    "final_norm": {"$var": "final_norm"},
    "head": {"$var": "head"},
    "hf": {
      "names": {"$var": "names"},
      "prefix_aliases": {"$var": "prefix_aliases"},
      "ignored_prefixes": {"$var": "ignored_prefixes"},
      "qkv": {"$var": "qkv_layout"},
      "mlp": {"$var": "mlp_layout"},
      "experts": {"$var": "experts_layout"}
    }
  }
}
