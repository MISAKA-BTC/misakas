{
  "format": "misaka.palw.model-adapter.v1",
  "id": "mixtral",
  "doc": "Mixtral: softmax over all experts, top-k, renormalised; block_sparse_moe naming (w1 gate, w3 up, w2 down); a sliding window on every layer when sliding_window is set.",
  "extends": ["decoder-core"],
  "match": {"architectures": ["MixtralForCausalLM"], "model_types": ["mixtral"]},
  "config": {"defaults": {"intermediate_size": 14336, "num_key_value_heads": 8, "max_position_embeddings": 131072, "rms_norm_eps": 1e-05, "num_experts_per_tok": 2}, "inert": ["router_jitter_noise"]},
  "vars": [
    {"name": "e", "value": {"$alias": [["num_local_experts", "num_experts"], 8]}},
    {"name": "k", "value": {"$cfg": "num_experts_per_tok"}},
    {"name": "topk_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "k"}, 0]}, {"$le": [{"$var": "k"}, {"$var": "e"}]}]}, {"$cat": ["top-k ", {"$var": "k"}, " of ", {"$var": "e"}, " experts"]}]}},
    {"name": "sw", "value": {"$cfg?": "sliding_window"}},
    {"name": "types", "value": {"$repeat": ["sliding_attention", {"$var": "n"}]}},
    {"name": "rope_theta", "value": 1000000.0},
    {"name": "abias", "value": false},
    {"name": "mbias", "value": false},
    {"name": "l_ffn", "value": {"Moe": {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "inter"}, "act": {"$var": "act"}, "router": {"scoring": "Softmax", "normalize": true}}}, "layer": true},
    {"name": "names", "value": {"$merge": [{"$var": "names_base"}, {"moe.router": "{p}layers.{L}.block_sparse_moe.gate", "moe.gate": "{p}layers.{L}.block_sparse_moe.experts.{E}.w1", "moe.up": "{p}layers.{L}.block_sparse_moe.experts.{E}.w3", "moe.down": "{p}layers.{L}.block_sparse_moe.experts.{E}.w2"}]}},
    {"name": "families", "value": ["C3", "C8"]},
    {"name": "model_type", "value": "mixtral"}
  ]
}
