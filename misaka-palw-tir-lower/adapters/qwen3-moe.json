{
  "format": "misaka.palw.model-adapter.v1",
  "id": "qwen3-moe",
  "doc": "Qwen3-MoE: per-head QK-norm, no shared expert; mlp_only_layers and decoder_sparse_step choose the dense layers; softmax router, norm_topk_prob.",
  "extends": ["standard-decoder"],
  "match": {"architectures": ["Qwen3MoeForCausalLM"], "model_types": ["qwen3_moe"]},
  "config": {"defaults": {"vocab_size": 151936, "hidden_size": 2048, "intermediate_size": 6144, "num_hidden_layers": 24, "num_attention_heads": 32, "num_key_value_heads": 4, "max_position_embeddings": 32768, "num_experts_per_tok": 8, "moe_intermediate_size": 768, "norm_topk_prob": false, "decoder_sparse_step": 1}},
  "vars": [
    {"name": "e", "value": {"$alias": [["num_experts", "num_local_experts"], 128]}},
    {"name": "k", "value": {"$cfg": "num_experts_per_tok"}},
    {"name": "topk_ok", "value": {"$bad": [{"$and": [{"$gt": [{"$var": "k"}, 0]}, {"$le": [{"$var": "k"}, {"$var": "e"}]}]}, {"$cat": ["top-k ", {"$var": "k"}, " of ", {"$var": "e"}, " experts"]}]}},
    {"name": "moe_inter", "value": {"$cfg": "moe_intermediate_size"}},
    {"name": "norm_topk", "value": {"$cfg": "norm_topk_prob"}},
    {"name": "step", "value": {"$cfg": "decoder_sparse_step"}},
    {"name": "mlp_only", "value": {"$cfg": ["mlp_only_layers", []]}},
    {"name": "use_sw", "value": {"$cfg": ["use_sliding_window", false]}},
    {"name": "sw_raw", "value": {"$let": ["w", {"$cfgn": "sliding_window"}, {"$if": [{"$and": [{"$ne": [{"$var": "w"}, null]}, {"$gt": [{"$var": "w"}, 0]}]}, {"$var": "w"}, null]}]}},
    {"name": "sw", "value": {"$if": [{"$var": "use_sw"}, {"$var": "sw_raw"}, null]}},
    {"name": "mwl", "value": {"$cfg": ["max_window_layers", 28]}},
    {"name": "types", "value": {"$layer_types": {"n": {"$var": "n"}, "allowed": ["full_attention", "sliding_attention"], "each": {"$if": [{"$and": [{"$ne": [{"$var": "sw"}, null]}, {"$ge": [{"$var": "i"}, {"$var": "mwl"}]}]}, "sliding_attention", "full_attention"]}}}},
    {"name": "sparse", "value": {"$and": [{"$not": {"$contains": [{"$var": "mlp_only"}, {"$var": "i"}]}}, {"$gt": [{"$var": "e"}, 0]}, {"$gt": [{"$var": "step"}, 0]}, {"$eq": [{"$mod": [{"$add": [{"$var": "i"}, 1]}, {"$var": "step"}]}, 0]}]}, "layer": true},
    {"name": "dense", "value": {"Mlp": {"intermediate": {"$var": "inter"}, "act": {"$var": "act"}, "gated": true}}, "layer": true},
    {"name": "abias", "value": {"$cfg": "attention_bias"}},
    {"name": "qk_norm", "value": {"norm": {"kind": "Rms", "eps": {"$var": "eps"}, "gain": "W", "bias": false}, "scope": "PerHeadShared"}},
    {"name": "moe_block", "value": {"Moe": {"experts": {"$var": "e"}, "top_k": {"$var": "k"}, "intermediate": {"$var": "moe_inter"}, "act": {"$var": "act"}, "router": {"scoring": "Softmax", "normalize": {"$var": "norm_topk"}}}}, "layer": true},
    {"name": "l_ffn", "value": {"$if": [{"$var": "sparse"}, {"$var": "moe_block"}, {"$var": "dense"}]}, "layer": true},
    {"name": "names", "value": {"$merge": [{"$var": "names_base"}, {"moe.router": "{p}layers.{L}.mlp.gate", "moe.gate": "{p}layers.{L}.mlp.experts.{E}.gate_proj", "moe.up": "{p}layers.{L}.mlp.experts.{E}.up_proj", "moe.down": "{p}layers.{L}.mlp.experts.{E}.down_proj", "moe.shared.gate": "{p}layers.{L}.mlp.shared_expert.gate_proj", "moe.shared.up": "{p}layers.{L}.mlp.shared_expert.up_proj", "moe.shared.down": "{p}layers.{L}.mlp.shared_expert.down_proj", "moe.shared_gate": "{p}layers.{L}.mlp.shared_expert_gate"}]}},
    {"name": "families", "value": ["C3", "C8"]},
    {"name": "model_type", "value": "qwen3_moe"}
  ]
}
