{
  "format": "misaka.palw.model-adapter.v1",
  "id": "ernie4-5-moe",
  "doc": "ERNIE 4.5 MoE (Baidu): ERNIE-4.5 attention (use_bias, interleaved rotary), a softmax router over ALL experts whose top-k is chosen on the probabilities plus a learned per-expert correction bias (moe_statics.e_score_correction_bias, stored [1, E]: read by WEIGHTS_EXPR_V1 as a reshape to the declared shape) and whose weights are the unbiased probabilities renormalised by max(sum, moe_norm_min) (FR-07: the selection bias under softmax scoring); one wide shared expert (moe_num_shared_experts x moe_intermediate_size, no gate); dense layers outside [moe_layer_start_index, moe_layer_end_index] and off the moe_layer_interval. Third-party adapter (lane H), the weights expression by lane G (FR-01): data only.",
  "extends": [
    "decoder-core"
  ],
  "match": {
    "architectures": [
      "Ernie4_5_MoeForCausalLM"
    ],
    "model_types": [
      "ernie4_5_moe"
    ]
  },
  "config": {
    "defaults": {
      "vocab_size": 103424,
      "hidden_size": 2560,
      "intermediate_size": 12288,
      "num_hidden_layers": 28,
      "num_attention_heads": 20,
      "num_key_value_heads": 4,
      "max_position_embeddings": 131072,
      "rms_norm_eps": 1e-05,
      "tie_word_embeddings": true,
      "use_bias": false,
      "moe_intermediate_size": 1536,
      "moe_k": 6,
      "moe_num_experts": 64,
      "moe_num_shared_experts": 2,
      "moe_layer_start_index": 1,
      "moe_layer_end_index": 27,
      "moe_layer_interval": 1,
      "moe_norm_min": 1e-12
    },
    "inert": [
      "output_router_logits",
      "router_aux_loss_coef"
    ]
  },
  "vars": [
    {
      "name": "ub",
      "value": {
        "$cfg": "use_bias"
      }
    },
    {
      "name": "qkv_bias",
      "value": {
        "$var": "ub"
      }
    },
    {
      "name": "o_bias",
      "value": {
        "$var": "ub"
      }
    },
    {
      "name": "mbias",
      "value": {
        "$var": "ub"
      }
    },
    {
      "name": "rope_style",
      "value": "Interleaved"
    },
    {
      "name": "e",
      "value": {
        "$cfg": "moe_num_experts"
      }
    },
    {
      "name": "k",
      "value": {
        "$cfg": "moe_k"
      }
    },
    {
      "name": "topk_ok",
      "value": {
        "$bad": [
          {
            "$and": [
              {
                "$gt": [
                  {
                    "$var": "k"
                  },
                  0
                ]
              },
              {
                "$le": [
                  {
                    "$var": "k"
                  },
                  {
                    "$var": "e"
                  }
                ]
              }
            ]
          },
          "top-k out of range"
        ]
      }
    },
    {
      "name": "moe_inter",
      "value": {
        "$cfg": "moe_intermediate_size"
      }
    },
    {
      "name": "n_shared",
      "value": {
        "$cfg": "moe_num_shared_experts"
      }
    },
    {
      "name": "start",
      "value": {
        "$cfg": "moe_layer_start_index"
      }
    },
    {
      "name": "end_raw",
      "value": {
        "$cfg": "moe_layer_end_index"
      }
    },
    {
      "name": "end",
      "value": {
        "$if": [
          {
            "$lt": [
              {
                "$var": "end_raw"
              },
              0
            ]
          },
          {
            "$sub": [
              {
                "$var": "n"
              },
              1
            ]
          },
          {
            "$var": "end_raw"
          }
        ]
      }
    },
    {
      "name": "interval",
      "value": {
        "$cfg": "moe_layer_interval"
      }
    },
    {
      "name": "norm_min",
      "value": {
        "$cfg": "moe_norm_min"
      }
    },
    {
      "name": "sparse",
      "value": {
        "$and": [
          {
            "$eq": [
              {
                "$mod": [
                  {
                    "$add": [
                      {
                        "$var": "i"
                      },
                      1
                    ]
                  },
                  {
                    "$var": "interval"
                  }
                ]
              },
              0
            ]
          },
          {
            "$ge": [
              {
                "$var": "i"
              },
              {
                "$var": "start"
              }
            ]
          },
          {
            "$le": [
              {
                "$var": "i"
              },
              {
                "$var": "end"
              }
            ]
          }
        ]
      },
      "layer": true
    },
    {
      "name": "router",
      "value": {
        "scoring": "Softmax",
        "linear_bias": false,
        "selection_bias": true,
        "groups": null,
        "normalize": true,
        "norm_eps": {
          "$var": "norm_min"
        },
        "scale": 1.0,
        "jitter_eps": 0.0,
        "per_expert_scale": false
      }
    },
    {
      "name": "shared",
      "value": {
        "$if": [
          {
            "$gt": [
              {
                "$var": "n_shared"
              },
              0
            ]
          },
          {
            "intermediate": {
              "$mul": [
                {
                  "$var": "moe_inter"
                },
                {
                  "$var": "n_shared"
                }
              ]
            },
            "sigmoid_gate": false
          },
          null
        ]
      }
    },
    {
      "name": "dense",
      "value": {
        "Mlp": {
          "intermediate": {
            "$var": "inter"
          },
          "act": {
            "$var": "act"
          },
          "gated": true,
          "up_bias": {
            "$var": "mbias"
          },
          "down_bias": {
            "$var": "mbias"
          }
        }
      },
      "layer": true
    },
    {
      "name": "moe_block",
      "value": {
        "Moe": {
          "experts": {
            "$var": "e"
          },
          "top_k": {
            "$var": "k"
          },
          "intermediate": {
            "$var": "moe_inter"
          },
          "act": {
            "$var": "act"
          },
          "router": {
            "$var": "router"
          },
          "shared": {
            "$var": "shared"
          }
        }
      },
      "layer": true
    },
    {
      "name": "l_ffn",
      "value": {
        "$if": [
          {
            "$var": "sparse"
          },
          {
            "$var": "moe_block"
          },
          {
            "$var": "dense"
          }
        ]
      },
      "layer": true
    },
    {
      "name": "names",
      "value": {
        "$merge": [
          {
            "$var": "names_base"
          },
          {
            "moe.router": "{p}layers.{L}.mlp.gate",
            "moe.gate": "{p}layers.{L}.mlp.experts.{E}.gate_proj",
            "moe.up": "{p}layers.{L}.mlp.experts.{E}.up_proj",
            "moe.down": "{p}layers.{L}.mlp.experts.{E}.down_proj",
            "moe.shared.gate": "{p}layers.{L}.mlp.shared_experts.gate_proj",
            "moe.shared.up": "{p}layers.{L}.mlp.shared_experts.up_proj",
            "moe.shared.down": "{p}layers.{L}.mlp.shared_experts.down_proj"
          }
        ]
      }
    },
    {
      "name": "families",
      "value": [
        "C3",
        "C8"
      ]
    },
    {
      "name": "model_type",
      "value": "ernie4_5_moe"
    }
  ],
  "spec": {
    "hf": {
      "weights": {
        "moe.sel_bias": [
          "{p}layers.{L}.mlp.moe_statics.e_score_correction_bias",
          {
            "reshape": "param"
          }
        ]
      }
    }
  }
}